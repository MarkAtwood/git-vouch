HANDLE_RE = re.compile(r"[a-z0-9][a-z0-9_-]{0,38}")
MAX_FILE_SIZE = 64 * 1024
# Each signature block costs check one ssh-keygen run per distinct version;
# keys cost only parsing, so retired ones, kept for the export, are not capped.
MAX_KEYS = 16  # current keys per person file
MAX_SIGNATURES = 4  # blocks per .sig file
TIERS = ("anchor", "maintainer", "contributor", "automation")
CONTEXT = "https://w3id.org/git-vouch/v1"
DATE_RE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z")
DATE_FORMAT = "%Y-%m-%dT%H:%M:%SZ"
# Emails become allowed-signers principals, which are comma-separated
# patterns; this keeps out ',', whitespace and the wildcards '*', '?', '!'.
EMAIL_RE = re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+")
# DID Core syntax: did:<method>:<method-specific-id>
DID_RE = re.compile(r"did:[a-z0-9]+:(?:[A-Za-z0-9._%-]*:)*[A-Za-z0-9._%-]+")
SEQ_RE = re.compile(r"(.+)-([1-9][0-9]*)")  # "<handle>-<n>" file stems
# A flag-day person file's pgpkeys.git v4 key fingerprint (DESIGN.md, Flag day).
MIGRATED_RE = re.compile(r"openpgp4fpr:([0-9A-Fa-f]{40})")
# ponytail: placeholder; the kernel.org administrators choose the real path.
DEFAULT_REGISTRY = "https://git.kernel.org/pub/scm/linux/kernel/git/vouch/registry.git"
FETCHED_REF = "refs/vouch/registry"
STALE_AFTER = timedelta(days=7)
# ponytail: OpenSSH 9.6 reads the zoneless local verify time git passes it an
# hour off across DST, so every exported valid-before is an hour late. Signers
# set their own timestamps and could backdate anyway, so the hour admits
# nothing new. Drop it once that OpenSSH is gone.
END_SLACK = timedelta(hours=1)
# A record date must leave room for END_SLACK and format as four digits.
RECORD_YEARS = range(1970, 9999)
# The latest valid-before: a commit can be dated to the end of datetime's range.
LAST_SECOND = datetime.max.replace(microsecond=0, tzinfo=timezone.utc)

B58_ALPHABET = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
ED25519_CODEC = b"\xed\x01"  # multicodec ed25519-pub (0xed) as a varint
P256_CODEC = b"\x80\x24"  # multicodec p256-pub (0x1200) as a varint
RSA_CODEC = b"\x85\x24"  # multicodec rsa-pub (0x1205) as a varint
# The kernel's floor (maintainer-pgp-guide.rst) and OpenSSH's ceiling.
RSA_MIN_BITS, RSA_MAX_BITS = 2048, 16384
NEW_KEY_HINT = "make a new key with: ssh-keygen -t ed25519-sk"
P256_P = 2**256 - 2**224 + 2**192 + 2**96 - 1
P256_B = 0x5AC635D8AA3A93E7B3EBBD55769886BC651D06B0CC53B0F63BCE3C3E27D2604B
ED25519_P = 2**255 - 19
# The y coordinates (little-endian, sign bit clear) of ed25519's 8 small-order
# points: 0 and the two order-8 values each come with two signs of x. From the
# blacklist in ge25519_has_small_order, libsodium 1.0.16 (commit 675149b9b8b6),
# src/libsodium/crypto_core/ed25519/ref10/ed25519_ref10.c. Its p and p+1
# entries spell 0 and 1 non-canonically and are refused as y >= p instead.
ED25519_SMALL_ORDER_Y = frozenset(
    bytes.fromhex(y)
    for y in (
        "00" * 32,
        "01" + "00" * 31,
        "26e8958fc2b227b045c3f489f2ef98f0d5dfac05d3c63339b13802886d53fc05",
        "c7176a703d4dd84fba3c0b760d10670f2a2053fa2c39ccc64ec7fd7792ac037a",
        "ec" + "ff" * 30 + "7f",
    )
)
# Number of SSH wire strings in each accepted key blob; sk- keys add an application.
SSH_KEY_FIELDS = {
    "ssh-ed25519": 2,
    "sk-ssh-ed25519@openssh.com": 3,
    "ecdsa-sha2-nistp256": 3,
    "sk-ecdsa-sha2-nistp256@openssh.com": 4,
    "ssh-rsa": 3,
}
# A did:key for a 16384-bit RSA key with e < n is at most 5625 characters;
# longer input is never decoded.
MAX_DID_LEN = 5625
NAMESPACES = {
    "people": "git-vouch-register",
    "tiers": "git-vouch-tier",
    "endorsements": "git-vouch-endorse",
    "revocations": "git-vouch-revoke",
}
# One armored "ssh-keygen -Y sign" block; a .sig file is one or more of them.
SIG_RE = re.compile(
    rb"-----BEGIN SSH SIGNATURE-----\n[A-Za-z0-9+/=\n]+-----END SSH SIGNATURE-----\n"
)
SIGS_RE = re.compile(b"(?:" + SIG_RE.pattern + b")+")


class VouchError(Exception):
    """A failure reported to the user as an error message and non-zero exit."""


def run(
    argv: Sequence[str],
    *,
    values: Sequence[str] = (),
    stdin: Optional[bytes] = None,
    cwd: Optional[Path] = None,
) -> bytes:
    """Run a program without a shell and return its stdout.

    Args:
        argv: Program and options; must not contain registry values.
        values: Untrusted values, passed as separate arguments after ``--``.
        stdin: Bytes fed to the program's standard input.
        cwd: Working directory for the program.

    Raises:
        VouchError: The program could not be started or exited non-zero.
    """
    cmd = [*argv, "--", *values] if values else list(argv)
    try:
        proc = subprocess.run(
            cmd, input=stdin, cwd=cwd, capture_output=True, check=False
        )
    except OSError as e:
        raise VouchError(f"cannot run {cmd[0]}: {e}") from e
    if proc.returncode != 0:
        err = proc.stderr.decode(errors="replace").strip()
        raise VouchError(f"{cmd[0]} {cmd[1] if len(cmd) > 1 else ''} failed: {err}")
    return proc.stdout


def validate_handle(name: object) -> str:
    """Return ``name`` if it is a valid handle or record file stem.

    Raises:
        VouchError: ``name`` is not a str matching ``^[a-z0-9][a-z0-9_-]{0,38}$``.
    """
    if not isinstance(name, str) or not HANDLE_RE.fullmatch(name):
        raise VouchError(f"invalid handle or file name: {name!r}")
    return name


def _open_below(root: Path, rel: str, last_flags: int) -> int:
    """Open ``rel`` below ``root`` one component at a time with O_NOFOLLOW; return the fd.

    Raises:
        VouchError: ``rel`` is not a plain relative path.
        OSError: A component is missing, a symlink, or cannot be opened.
    """
    parts = rel.split("/")
    if any(part in ("", ".", "..") for part in parts):
        raise VouchError(f"{rel!r}: not a plain path below the registry")
    fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY)
    try:
        for i, part in enumerate(parts):
            last = i == len(parts) - 1
            flags = os.O_NOFOLLOW | (last_flags if last else os.O_DIRECTORY)
            parent = fd
            fd = os.open(part, flags, dir_fd=parent)
            os.close(parent)
    except BaseException:
        os.close(fd)
        raise
    return fd


def read_capped(root: Path, rel: str) -> bytes:
    """Return the bytes of the regular file ``rel`` under ``root``, at most MAX_FILE_SIZE.

    Each component below ``root`` is opened relative to its parent with
    O_NOFOLLOW, so no symlink in ``rel`` is followed and nothing can be
    swapped in between a check and the open.

    Args:
        root: Registry checkout; symlinks above it are allowed.
        rel: Slash-separated path below ``root``.

    Raises:
        VouchError: ``rel`` escapes ``root``, crosses a symlink, does not
            name a regular file, or the file is too large.
    """
    try:
        fd = _open_below(root, rel, os.O_NONBLOCK)
        try:
            if not stat.S_ISREG(os.fstat(fd).st_mode):
                raise VouchError(f"{rel}: not a regular file")
            with os.fdopen(fd, "rb", closefd=False) as f:
                data = f.read(MAX_FILE_SIZE + 1)
        finally:
            os.close(fd)
    except OSError as e:
        raise VouchError(f"{rel}: cannot read: {e.strerror}") from e
    if len(data) > MAX_FILE_SIZE:
        raise VouchError(f"{rel}: larger than {MAX_FILE_SIZE} bytes")
    return data


def list_dir(root: Path, rel: str) -> list[str]:
    """Return the sorted entry names of directory ``rel`` under ``root``; [] if it is missing.

    Like ``read_capped``, no symlink below ``root`` is followed.

    Raises:
        VouchError: ``rel`` crosses a symlink or is not a directory.
    """
    try:
        fd = _open_below(root, rel, os.O_DIRECTORY)
        try:
            return sorted(os.listdir(fd))
        finally:
            os.close(fd)
    except FileNotFoundError:
        return []
    except OSError as e:
        raise VouchError(f"{rel}: cannot list: {e.strerror}") from e


class Version(NamedTuple):
    """One commit that changed a registry path, from ``file_history``."""

    commit: str
    date: datetime  # committer date, UTC
    parents: tuple[str, ...]  # empty for a root commit; more than one for a merge
    data: Optional[bytes]  # content at ``commit``; None if it deleted the path


# Neither the user's config nor replace refs may change what is read.
GIT = ["git", "--no-replace-objects"]
GIT_LOG = [
    *GIT,
    "--literal-pathspecs",
    "-c",
    "log.follow=false",
    "-c",
    "log.showSignature=false",
]
FILE_MODES = ("100644", "100755")


def read_blobs(
    root: Path, what: str, blobs: Sequence[str], skip: bool = False
) -> dict[str, bytes]:
    """Return the content of each git blob in ``blobs``, keyed by object id.

    Args:
        root: The repository's work tree.
        what: Named in the error message.
        blobs: Object ids from git's own output.
        skip: Leave out an object that is not a blob of at most
            MAX_FILE_SIZE bytes instead of failing.

    Raises:
        VouchError: git fails, or, unless ``skip``, an object is not a blob
            of at most MAX_FILE_SIZE bytes; no oversized blob is ever read.
    """
    if not blobs:
        return {}
    # ponytail: two cat-file processes per call; sizes are checked first.
    stdin = "".join(f"{b}\n" for b in blobs).encode()
    checks = run([*GIT, "cat-file", "--batch-check"], stdin=stdin, cwd=root)
    sizes = [
        c.split()[2] if c.split()[1:2] == [b"blob"] else b""
        for c in checks.splitlines()
    ]
    good = [b for b, s in zip(blobs, sizes) if s.isdigit() and int(s) <= MAX_FILE_SIZE]
    if len(sizes) != len(blobs) or (len(good) != len(blobs) and not skip):
        raise VouchError(
            f"{what}: a version is not a blob of at most {MAX_FILE_SIZE} bytes"
        )
    if not good:
        return {}
    stdin = "".join(f"{b}\n" for b in good).encode()
    out = run([*GIT, "cat-file", "--batch"], stdin=stdin, cwd=root)
    contents = {}
    for blob in good:
        header, out = out.split(b"\n", 1)
        size = int(header.split()[2])
        contents[blob], out = out[:size], out[size + 1 :]
    return contents


def _unreadable(
    rel: str, commit: str, blob: str, unreadable: Optional[list[str]]
) -> bytes:
    """Return stand-in content for a version of ``rel`` that cannot be read.

    The stand-in never parses, so the version counts as a malformed record,
    and differs per blob, so two such versions still differ.

    Raises:
        VouchError: ``unreadable`` is None; otherwise the message is added to it.
    """
    problem = f"{rel}: not a regular file of at most {MAX_FILE_SIZE} bytes"
    if unreadable is None:
        raise VouchError(f"{problem}, at {commit}")
    unreadable.append(f"{problem} (ignored, at {commit})")
    return b"\0unreadable " + blob.encode()


def file_history(
    root: Path, rel: str, unreadable: Optional[list[str]] = None
) -> list[Version]:
    """Return every version of ``rel`` in the registry repository at ``root``, oldest first.

    A version is a commit whose ``rel`` differs from that of its parent, or,
    for a merge, from that of every parent. History is not simplified, so
    every side-branch commit is listed, even when a merge kept the other
    side's content. A merge that kept one parent's content is not listed.
    The order is topological, and on a branched history the entry before a
    version need not be its predecessor: the previous content of a version
    is ``rel`` at each of its ``parents``.

    Args:
        root: Top of the registry's git work tree.
        rel: Slash-separated path below ``root``.
        unreadable: If given, a version that is a directory, a symlink, a
            submodule or too large is not an error: it gets content that never parses,
            and a message naming its commit is added here.

    Raises:
        VouchError: ``rel`` is not a plain path, the repository is a shallow
            clone, git fails, or, unless ``unreadable`` is given, a version is
            a directory, a symlink, a submodule or too large. A commit dated
            beyond what datetime can hold is dated LAST_SECOND.
    """
    return file_histories(root, [rel], [rel], unreadable)[rel]


def file_histories(
    root: Path,
    rels: Iterable[str],
    sources: Sequence[str],
    unreadable: Optional[list[str]] = None,
) -> dict[str, list[Version]]:
    """Return ``file_history`` of each path in ``rels``, from one git log over ``sources``.

    With ``--full-history``, git lists a commit's raw line for each path on
    its own, so one log over many paths gives each the lines its own log
    would.

    Args:
        root: As for ``file_history``.
        rels: The paths, each one of ``sources`` or below one.
        sources: The paths whose log is read.
        unreadable: As for ``file_history``.

    Raises:
        VouchError: As for ``file_history``, or a path is not below ``sources``.
    """
    # commit -> (commit, committer time, parents, result mode, result blob), per path
    found: dict[str, dict[str, tuple[str, str, tuple[str, ...], str, str]]] = {}
    for rel in rels:
        parts = rel.split("/")
        if any(p in ("", ".", "..") for p in parts) or not rel.isprintable():
            raise VouchError(f"{rel!r}: not a plain path below the registry")
        if not any(rel == s or rel.startswith(s + "/") for s in sources):
            raise VouchError(f"{rel}: not below {', '.join(sources)}")
        found[rel] = {}
    if not found:
        return {}
    if run([*GIT, "rev-parse", "--is-shallow-repository"], cwd=root).strip() == b"true":
        raise VouchError(f"{root}: shallow clone; the registry needs its full history")
    # -c prints a merge's raw line only when it differs from every parent;
    # --root and --no-renames pin what log.showRoot and diff.renames would change.
    log = run(
        [
            *GIT_LOG,
            "log",
            "--topo-order",
            "--reverse",
            "--full-history",
            "-c",
            "--raw",
            "--root",
            "--no-renames",
            "--no-abbrev",
            "-z",
            "--format=%H %ct %P",
        ],
        values=sources,
        cwd=root,
    )
    tokens = iter(log.split(b"\0"))
    for token in tokens:
        token = token.lstrip(b"\n")
        if not token:
            continue
        if not token.startswith(b":"):
            commit, ctime, *parents = token.decode().split()
            continue
        path = next(tokens, b"").decode(errors="surrogateescape")
        n = len(token) - len(token.lstrip(b":"))
        fields = token[n:].decode().split()
        mode, blob = fields[n], fields[2 * n + 1]
        entry = (commit, ctime, tuple(parents), mode, blob)
        for i in (i for i, c in enumerate(path) if c == "/"):
            # A directory at a path: git lists the files below it, beside the
            # path's own deletion. A file added or changed there means a
            # directory version; only files deleted there mean the path is gone.
            below = found.get(path[:i])
            if below is None:
                continue
            if mode != "000000":
                below[commit] = (commit, ctime, tuple(parents), "040000", commit)
            else:
                below.setdefault(commit, entry)
        at = found.get(path)
        if at is not None and at.get(commit, entry)[3] != "040000":
            at[commit] = entry
    blobs = {f[4] for at in found.values() for f in at.values() if f[3] in FILE_MODES}
    contents = read_blobs(root, ", ".join(sources), sorted(blobs), skip=True)
    histories = {}
    for rel, at in found.items():
        versions = []
        for commit, ctime, parents, mode, blob in at.values():
            try:
                date = datetime.fromtimestamp(int(ctime), timezone.utc)
            except (ValueError, OverflowError, OSError):
                date = LAST_SECOND
            data = contents.get(blob) if mode in FILE_MODES else None
            if mode != "000000" and data is None:
                data = _unreadable(rel, commit, blob, unreadable)
            versions.append(Version(commit, date, parents, data))
        histories[rel] = versions
    return histories


def b58encode(data: bytes) -> str:
    """Return ``data`` in base58btc (the Bitcoin alphabet), one '1' per leading zero byte."""
    n = int.from_bytes(data, "big")
    out = ""
    while n:
        n, r = divmod(n, 58)
        out = B58_ALPHABET[r] + out
    return "1" * (len(data) - len(data.lstrip(b"\0"))) + out


def b58decode(text: str) -> bytes:
    """Return the bytes encoded by base58btc ``text``.

    Raises:
        VouchError: ``text`` contains a character outside the alphabet.
    """
    n = 0
    for c in text:
        i = B58_ALPHABET.find(c)
        if i < 0:
            raise VouchError(f"invalid base58 character {c!r}")
        n = n * 58 + i
    zeros = len(text) - len(text.lstrip("1"))
    return b"\0" * zeros + n.to_bytes((n.bit_length() + 7) // 8, "big")


def _p256_y(x: int, is_odd: bool) -> int:
    """Return the y coordinate of the P-256 point with ``x`` and the given parity.

    Raises:
        VouchError: ``x`` is not the x coordinate of a point on the curve.
    """
    if x >= P256_P:
        raise VouchError("P-256 coordinate out of range")
    rhs = (x * x * x - 3 * x + P256_B) % P256_P
    y = pow(rhs, (P256_P + 1) // 4, P256_P)  # square root, since p = 3 (mod 4)
    if y * y % P256_P != rhs:
        raise VouchError("not a point on P-256")
    return P256_P - y if (y & 1) != is_odd else y


def _ssh_strings(blob: bytes) -> list[bytes]:
    """Split an SSH wire-format blob into its length-prefixed strings.

    Raises:
        VouchError: The blob is truncated.
    """
    out: list[bytes] = []
    while blob:
        n = int.from_bytes(blob[:4], "big")
        if len(blob) < 4 + n:
            raise VouchError("truncated SSH public key")
        out.append(blob[4 : 4 + n])
        blob = blob[4 + n :]
    return out


def _mpint(n: int) -> bytes:
    """Return non-negative ``n`` as minimal big-endian two's complement.

    This is both an SSH mpint's body and a DER INTEGER's contents.
    """
    return n.to_bytes(n.bit_length() // 8 + 1, "big") if n else b""


def _der(tag: int, body: bytes) -> bytes:
    """Return the DER element with ``tag`` and ``body``, using the minimal length form."""
    n = len(body)
    if n < 0x80:
        return bytes([tag, n]) + body
    size = n.to_bytes((n.bit_length() + 7) // 8, "big")
    return bytes([tag, 0x80 | len(size)]) + size + body


def _der_read(data: bytes, tag: int) -> tuple[bytes, bytes]:
    """Return the body of the DER element with ``tag`` at the start of ``data``, and what follows.

    Raises:
        VouchError: ``data`` does not start with a whole element with ``tag``.
    """
    if len(data) < 2 or data[0] != tag:
        raise VouchError("malformed RSA did:key")
    n, start = data[1], 2
    if n & 0x80:
        start += n & 0x7F
        n = int.from_bytes(data[2:start], "big")
    if len(data) < start + n:
        raise VouchError("malformed RSA did:key")
    return data[start : start + n], data[start + n :]


def _rsa_der(n: int, e: int) -> bytes:
    """Return PKCS#1 RSAPublicKey DER for modulus ``n`` and exponent ``e``."""
    return _der(0x30, _der(0x02, _mpint(n)) + _der(0x02, _mpint(e)))


def _check_rsa(n: int, e: int) -> None:
    """Check an RSA public key against the accepted sizes and PKCS#1's exponent range.

    Raises:
        VouchError: ``n`` is outside 2048-16384 bits, or ``e`` is not odd with 3 <= e < n.
    """
    if not RSA_MIN_BITS <= n.bit_length() <= RSA_MAX_BITS:
        raise VouchError(
            f"RSA key is {n.bit_length()} bits:"
            f" {RSA_MIN_BITS} to {RSA_MAX_BITS} are accepted; {NEW_KEY_HINT}"
        )
    if not (3 <= e < n and e & 1):
        raise VouchError("RSA exponent must be odd, at least 3 and less than n")
    if _rsa_modulus_is_weak(n):
        raise VouchError(
            "RSA modulus is prime, a prime power or has a factor below 2^16,"
            f" so anyone can sign with this key; {NEW_KEY_HINT}"
        )


@functools.lru_cache(maxsize=None)
def _rsa_modulus_is_weak(n: int) -> bool:
    """Return whether anyone can compute a private key for an RSA modulus ``n`` >= 2^16.

    A factor below 2^16 is found by trial division. If ``n`` is a prime p, or
    a prime power p^k, then n = 1 (mod p-1), so by Fermat's little theorem
    2^n = 2 (mod p) and p divides gcd(2^n - 2, n). For an even n, 2^n mod n
    is even, so the gcd is at least 2.
    """
    # ponytail: catches accidental or naive weak moduli only. A registrant
    # who picks a factor just above 2^16, or one ECM finds, still gets a key
    # anyone can sign with: ruling that out costs factoring n. Ceiling: one
    # pow() per distinct modulus, about 7 s at 16384 bits (0.15 s at 4096),
    # paid while parsing before any signature check; cached per modulus.
    return (
        any(n % d == 0 for d in range(3, 1 << 16, 2))
        or math.gcd(pow(2, n, n) - 2, n) != 1
    )


def _check_ed25519(key: bytes) -> None:
    """Check that ``key`` is a canonical ed25519 public key that is not of small order.

    Anyone can sign for a small-order key: for the identity, R = identity and
    S = 0 verify for every message.

    Raises:
        VouchError: ``key`` is not 32 bytes, has y >= p, or is one of the 8
            small-order points (with either x sign bit).
    """
    if len(key) != 32:
        raise VouchError("ed25519 public key is not 32 bytes")
    y = key[:31] + bytes([key[31] & 0x7F])
    if int.from_bytes(y, "little") >= ED25519_P:
        raise VouchError(
            f"ed25519 public key is not canonically encoded; {NEW_KEY_HINT}"
        )
    if y in ED25519_SMALL_ORDER_Y:
        raise VouchError(
            f"ed25519 public key has small order, so anyone can sign with it; {NEW_KEY_HINT}"
        )


def ssh_to_did(pubkey: str) -> str:
    """Return the did:key for an OpenSSH public key line ("type base64 [comment]").

    ed25519 keys use multicodec ed25519-pub; ecdsa-sha2-nistp256 keys use
    p256-pub with the compressed point; ssh-rsa keys use rsa-pub with
    PKCS#1 RSAPublicKey DER. The sk- (FIDO) variants map to the same
    did:key as their plain type.

    Raises:
        VouchError: The key is malformed, not minimally encoded, or of an
            unsupported type or size (DSA, P-384, RSA-1024, ...).
    """
    fields = pubkey.split()
    if len(fields) < 2:
        raise VouchError("not an SSH public key line")
    key_type = fields[0]
    count = SSH_KEY_FIELDS.get(key_type)
    if count is None:
        raise VouchError(
            f"unsupported key type {key_type!r}: only ed25519,"
            " ecdsa-sha2-nistp256 (and their sk- variants) and ssh-rsa keys"
            f" are accepted; {NEW_KEY_HINT}"
        )
    try:
        blob = base64.b64decode(fields[1], validate=True)
    except ValueError as e:
        raise VouchError(f"invalid base64 in SSH public key: {e}") from e
    # OpenSSH refuses stray padding bits and would skip this line in allowed_signers.
    if base64.b64encode(blob).decode() != fields[1]:
        raise VouchError(f"SSH public key base64 is not canonical; {NEW_KEY_HINT}")
    parts = _ssh_strings(blob)
    if len(parts) != count or parts[0] != key_type.encode():
        raise VouchError(f"malformed {key_type} public key")
    if key_type == "ssh-rsa":
        e, n = (int.from_bytes(p, "big") for p in parts[1:])
        # One key, one did:key: a padded or negative mpint is refused, not normalized.
        if (_mpint(e), _mpint(n)) != (parts[1], parts[2]):
            raise VouchError("RSA public key is not minimally encoded")
        _check_rsa(n, e)
        return "did:key:z" + b58encode(RSA_CODEC + _rsa_der(n, e))
    if "ed25519" in key_type:
        _check_ed25519(parts[1])
        return "did:key:z" + b58encode(ED25519_CODEC + parts[1])
    point = parts[2]
    if parts[1] != b"nistp256" or len(point) != 65 or point[0] != 4:
        raise VouchError("malformed P-256 public key")
    x = int.from_bytes(point[1:33], "big")
    y = int.from_bytes(point[33:], "big")
    if _p256_y(x, bool(y & 1)) != y:
        raise VouchError("not a point on P-256")
    return "did:key:z" + b58encode(P256_CODEC + bytes([2 + (y & 1)]) + point[1:33])


def did_to_ssh(did: str) -> str:
    """Return the OpenSSH public key line ("type base64") for an ed25519, P-256 or RSA did:key.

    A did:key does not record whether the key was a FIDO (sk-) key, so the
    plain SSH type is returned.

    Raises:
        VouchError: ``did`` is not a did:key for an accepted key, or its RSA
            DER is not minimally encoded.
    """
    unsupported = VouchError(f"not an ed25519, P-256 or RSA did:key: {did[:64]!r}")
    if not did.startswith("did:key:z") or len(did) > MAX_DID_LEN:
        raise unsupported
    raw = b58decode(did[len("did:key:z") :])
    codec, key = raw[:2], raw[2:]
    if codec == ED25519_CODEC and len(key) == 32:
        _check_ed25519(key)
        parts = [b"ssh-ed25519", key]
    elif codec == P256_CODEC and len(key) == 33 and key[0] in (2, 3):
        y = _p256_y(int.from_bytes(key[1:], "big"), key[0] == 3)
        parts = [
            b"ecdsa-sha2-nistp256",
            b"nistp256",
            b"\x04" + key[1:] + y.to_bytes(32, "big"),
        ]
    elif codec == RSA_CODEC:
        body, _ = _der_read(key, 0x30)
        n_raw, body = _der_read(body, 0x02)
        e_raw, _ = _der_read(body, 0x02)
        n, e = int.from_bytes(n_raw, "big"), int.from_bytes(e_raw, "big")
        # Re-encoding also catches trailing bytes and non-minimal lengths.
        if _rsa_der(n, e) != key:
            raise VouchError("RSA did:key is not minimally encoded DER")
        _check_rsa(n, e)
        parts = [b"ssh-rsa", _mpint(e), _mpint(n)]
    else:
        raise unsupported
    blob = b"".join(len(p).to_bytes(4, "big") + p for p in parts)
    return f"{parts[0].decode()} {base64.b64encode(blob).decode()}"


class Attestation(NamedTuple):
    """A FIDO key's ``attestation``: base64 of ssh-keygen's write-attestation output and challenge."""

    blob: str
    challenge: str


class PersonKey(NamedTuple):
    """One entry of a person file's ``keys``; ``ssh`` is "type base64" with any comment dropped."""

    ssh: str
    did: str
    added: datetime
    retired: Optional[datetime]
    attestation: Optional[Attestation] = None


class Person(NamedTuple):
    """A parsed ``people/<handle>.json``."""

    handle: str
    name: str
    emails: tuple[str, ...]
    keys: tuple[PersonKey, ...]
    accountable: Optional[str]
    migrated_from: Optional[str] = None  # the uppercase fingerprint in ``migratedFrom``


class Tier(NamedTuple):
    """A parsed ``tiers/<subject>.json``."""

    subject: str
    tier: str
    approver: str
    approver_key: str
    date: datetime


class Endorsement(NamedTuple):
    """A parsed ``endorsements/<subject>/<endorser>-<n>.json``."""

    endorser: str
    endorser_key: str
    subject: str
    subject_key: str
    subject_name: str
    note: Optional[str]
    date: datetime
    subject_emails: tuple[str, ...] = ()


class Revocation(NamedTuple):
    """A parsed ``revocations/<subject>-<n>.json``."""

    subject: str
    key: str
    reason: str
    date: datetime


Record = Union[Person, Tier, Endorsement, Revocation]


def _reject_constant(name: str) -> object:
    raise ValueError(f"{name} is not allowed")


def _unique_keys(pairs: list[tuple[str, object]]) -> dict[str, object]:
    obj: dict[str, object] = {}
    for key, value in pairs:
        if key in obj:
            # Parsers disagree on which duplicate wins; refuse rather than pick.
            raise VouchError(f"duplicate key {key!r:.60}")
        obj[key] = value
    return obj


def _load_json(data: bytes) -> object:
    """Return the JSON value in UTF-8 ``data``, refusing duplicate keys and NaN/Infinity."""
    try:
        return json.loads(
            data.decode("utf-8"),
            object_pairs_hook=_unique_keys,
            parse_constant=_reject_constant,
        )
    except (ValueError, RecursionError) as e:
        raise VouchError(f"not valid JSON: {e}") from e


def _required(obj: Mapping[str, object], key: str) -> object:
    value = obj.get(key)
    if value is None:
        raise VouchError(f"{key}: required")
    return value


def _handle(obj: Mapping[str, object], key: str) -> str:
    value = _required(obj, key)
    if not isinstance(value, str) or not HANDLE_RE.fullmatch(value):
        raise VouchError(f"{key}: invalid handle {value!r:.60}")
    return value


def _matching_handle(obj: Mapping[str, object], key: str, expected: str) -> str:
    value = _handle(obj, key)
    if value != expected:
        raise VouchError(
            f"{key}: {value!r} does not match the file name ({expected!r})"
        )
    return value


def _text(obj: Mapping[str, object], key: str) -> str:
    value = _required(obj, key)
    if not isinstance(value, str) or not value or not value.isprintable():
        raise VouchError(f"{key}: must be a non-empty string of printable characters")
    return value


def _did_key(obj: Mapping[str, object], key: str) -> str:
    value = _required(obj, key)
    if not isinstance(value, str):
        raise VouchError(f"{key}: must be a did:key string")
    try:
        did_to_ssh(value)
    except VouchError as e:
        raise VouchError(f"{key}: {e}") from e
    return value


def _date(obj: Mapping[str, object], key: str) -> datetime:
    value = _required(obj, key)
    if isinstance(value, str) and DATE_RE.fullmatch(value):
        try:
            when = datetime.strptime(value, DATE_FORMAT).replace(tzinfo=timezone.utc)
        except ValueError:
            pass
        else:
            if when.year in RECORD_YEARS:
                return when
    raise VouchError(
        f"{key}: must be a UTC time like 2026-11-05T00:00:00Z"
        f" in the years 1970 to 9998, not {value!r:.60}"
    )


def _list(obj: Mapping[str, object], key: str) -> list[object]:
    value = _required(obj, key)
    if not isinstance(value, list) or not value:
        raise VouchError(f"{key}: must be a non-empty list")
    return value


def _base64(obj: Mapping[str, object], key: str) -> str:
    value = _required(obj, key)
    try:
        if not isinstance(value, str) or not value:
            raise ValueError
        if base64.b64encode(base64.b64decode(value, validate=True)).decode() != value:
            raise ValueError  # stray padding or non-canonical trailing bits
    except ValueError as e:
        raise VouchError(f"{key}: must be a non-empty base64 string") from e
    return value


def _person_key(obj: object, where: str) -> PersonKey:
    if not isinstance(obj, dict):
        raise VouchError(f"{where}: must be an object")
    try:
        ssh = _required(obj, "ssh")
        if not isinstance(ssh, str):
            raise VouchError("ssh: must be an SSH public key line")
        try:
            did = ssh_to_did(ssh)
        except VouchError as e:
            raise VouchError(f"ssh: {e}") from e
        retired = None if obj.get("retired") is None else _date(obj, "retired")
        attestation = obj.get("attestation")
        if attestation is not None:
            if not isinstance(attestation, dict):
                raise VouchError(
                    "attestation: must be an object with blob and challenge"
                )
            try:
                attestation = Attestation(
                    _base64(attestation, "blob"), _base64(attestation, "challenge")
                )
            except VouchError as e:
                raise VouchError(f"attestation.{e}") from e
        ssh = " ".join(ssh.split()[:2])
        return PersonKey(ssh, did, _date(obj, "added"), retired, attestation)
    except VouchError as e:
        raise VouchError(f"{where}.{e}") from e


def _emails(key: str, values: list[object]) -> tuple[str, ...]:
    for email in values:
        if not isinstance(email, str) or not EMAIL_RE.fullmatch(email):
            raise VouchError(f"{key}: invalid address {email!r:.60}")
    return tuple(str(e) for e in values)


def _person(obj: Mapping[str, object], stem: str) -> Person:
    handle = _matching_handle(obj, "handle", stem)
    name = _text(obj, "name")
    emails = _emails("emails", _list(obj, "emails"))
    keys = tuple(_person_key(k, f"keys[{i}]") for i, k in enumerate(_list(obj, "keys")))
    if sum(k.retired is None for k in keys) > MAX_KEYS:
        raise VouchError(f"keys: more than {MAX_KEYS} current")
    if len({k.did for k in keys}) != len(keys):
        raise VouchError("keys: the same key is listed twice")
    accountable = (
        None if obj.get("accountable") is None else _handle(obj, "accountable")
    )
    aka = obj.get("alsoKnownAs")
    if aka is not None and not (
        isinstance(aka, list)
        and all(isinstance(d, str) and DID_RE.fullmatch(d) for d in aka)
    ):
        raise VouchError("alsoKnownAs: must be a list of DIDs")
    migrated = obj.get("migratedFrom")
    match = MIGRATED_RE.fullmatch(migrated) if isinstance(migrated, str) else None
    if migrated is not None and match is None:
        raise VouchError("migratedFrom: must be openpgp4fpr: and a 40-hex fingerprint")
    fpr = match.group(1).upper() if match else None
    return Person(handle, name, emails, keys, accountable, fpr)


def _tier(obj: Mapping[str, object], stem: str) -> Tier:
    subject = _matching_handle(obj, "subject", stem)
    tier = _required(obj, "tier")
    if (
        not isinstance(tier, str) or tier not in TIERS[1:]
    ):  # anchors come only from anchors.json
        raise VouchError(
            f"tier: must be one of {', '.join(TIERS[1:])}, not {tier!r:.60}"
        )
    return Tier(
        subject,
        tier,
        _handle(obj, "approver"),
        _did_key(obj, "approverKey"),
        _date(obj, "date"),
    )


def _endorsement(obj: Mapping[str, object], subject: str, endorser: str) -> Endorsement:
    note = obj.get("note")
    if note is not None and not isinstance(note, str):
        raise VouchError("note: must be a string")
    emails = obj.get("subjectEmails", [])
    if not isinstance(emails, list):
        raise VouchError("subjectEmails: must be a list")
    return Endorsement(
        _matching_handle(obj, "endorser", endorser),
        _did_key(obj, "endorserKey"),
        _matching_handle(obj, "subject", subject),
        _did_key(obj, "subjectKey"),
        _text(obj, "subjectName"),
        note,
        _date(obj, "date"),
        _emails("subjectEmails", emails),
    )


def _revocation(obj: Mapping[str, object], subject: str) -> Revocation:
    return Revocation(
        _matching_handle(obj, "subject", subject),
        _did_key(obj, "key"),
        _text(obj, "reason"),
        _date(obj, "date"),
    )


def _file_handle(name: str) -> str:
    if not HANDLE_RE.fullmatch(name):
        raise VouchError(f"invalid file name {name!r:.60}")
    return name


def _seq_handle(stem: str) -> str:
    """Return the handle in a "<handle>-<n>" file stem, n a decimal from 1 with no leading zero."""
    m = SEQ_RE.fullmatch(stem)
    if not m:
        raise VouchError(f"file name {stem!r:.60} is not <handle>-<n>")
    return _file_handle(m.group(1))


def _parse_record(parts: Sequence[str], data: bytes) -> Record:
    kind, name = parts[0], parts[-1]
    if (kind, len(parts)) not in (
        ("people", 2),
        ("tiers", 2),
        ("revocations", 2),
        ("endorsements", 3),
    ) or not name.endswith(".json"):
        raise VouchError("not a registry record path")
    stem = name[: -len(".json")]
    obj = _load_json(data)
    if not isinstance(obj, dict):
        raise VouchError("must be a JSON object")
    context = obj.get("@context")
    if not isinstance(context, list) or not context or context[0] != CONTEXT:
        raise VouchError(f"@context: must be a list starting with {CONTEXT!r}")
    if kind == "people":
        return _person(obj, _file_handle(stem))
    if kind == "tiers":
        return _tier(obj, _file_handle(stem))
    if kind == "revocations":
        return _revocation(obj, _seq_handle(stem))
    return _endorsement(obj, _file_handle(parts[1]), _seq_handle(stem))


def parse_record(rel: str, data: bytes) -> Record:
    """Parse and strictly validate the registry record ``data`` found at ``rel``.

    The path decides the kind: ``people/<handle>.json``,
    ``tiers/<handle>.json``, ``endorsements/<subject>/<endorser>-<n>.json``
    or ``revocations/<handle>-<n>.json``. The handles in the path must
    match the record's own. git-vouch's terms are checked for type and
    format; any other term is ignored. Signatures are not checked here.

    Args:
        rel: Slash-separated path of the record below the registry root.
        data: The file's bytes, as returned by ``read_capped``.

    Raises:
        VouchError: The path or the record is invalid; the message starts with ``rel``.
    """
    try:
        return _parse_record(rel.split("/"), data)
    except VouchError as e:
        raise VouchError(f"{rel}: {e}") from e


def parse_anchors(data: bytes) -> tuple[str, ...]:
    """Return the anchor handles in ``anchors.json``: a non-empty JSON list of distinct handles.

    Raises:
        VouchError: The file is not such a list.
    """
    try:
        value = _load_json(data)
    except VouchError as e:
        raise VouchError(f"anchors.json: {e}") from e
    if (
        not isinstance(value, list)
        or not value
        or not all(isinstance(h, str) and HANDLE_RE.fullmatch(h) for h in value)
        or len(set(value)) != len(value)
    ):
        raise VouchError("anchors.json: must be a non-empty list of distinct handles")
    return tuple(value)


def require_accountable(person: Person) -> None:
    """Check that an automation identity's person file names its accountable maintainer.

    The tier is not in the person file, so the caller decides when this applies.

    Raises:
        VouchError: ``person`` has no ``accountable``.
    """
    if person.accountable is None:
        raise VouchError(
            f"people/{person.handle}.json: accountable: required for automation"
        )


def split_signatures(sig: bytes) -> list[bytes]:
    """Return the armored SSH signatures that make up a ``.sig`` file, in order.

    The file must be nothing but one to MAX_SIGNATURES ``ssh-keygen -Y
    sign`` blocks, each ending in a newline.

    Raises:
        VouchError: The file is empty, holds more blocks, or anything else.
    """
    if not SIGS_RE.fullmatch(sig):
        raise VouchError("not a sequence of armored SSH signatures")
    blocks = SIG_RE.findall(sig)
    if len(blocks) > MAX_SIGNATURES:
        raise VouchError(f"more than {MAX_SIGNATURES} signatures")
    return blocks


def _verifies(data: bytes, sig: bytes, namespace: str, key: PersonKey) -> bool:
    """Return whether ssh-keygen accepts ``sig`` over ``data`` by ``key`` in ``namespace``.

    Raises:
        VouchError: ssh-keygen cannot be run.
    """
    return _ssh_verifies(data, sig, namespace, key.ssh)


# ponytail: check still runs ssh-keygen once per distinct signature in the
# registry's history, about 5 ms each (1,948 runs, 11 s, for 600 people with
# history), and the cache lives as long as the process; a cache kept on disk
# across runs, keyed by content, is the upgrade path.
@functools.lru_cache(maxsize=None)
def _ssh_verifies(data: bytes, sig: bytes, namespace: str, ssh: str) -> bool:
    with tempfile.TemporaryDirectory() as tmp:
        allowed = Path(tmp, "allowed_signers")
        allowed.write_text(f"signer {ssh}\n")
        sig_file = Path(tmp, "sig")
        sig_file.write_bytes(sig)
        cmd = ["ssh-keygen", "-Y", "verify", "-f", str(allowed), "-I", "signer"]
        cmd += ["-n", namespace, "-s", str(sig_file)]
        try:
            proc = subprocess.run(cmd, input=data, capture_output=True, check=False)
        except OSError as e:
            raise VouchError(f"cannot run ssh-keygen: {e}") from e
    return proc.returncode == 0


def _signed_by(sig: bytes) -> Optional[bytes]:
    """Return the public key blob an armored SSH signature names, or None if unreadable.

    This is the SSHSIG blob's first wire string (OpenSSH PROTOCOL.sshsig):
    parsing only; ssh-keygen still decides whether the signature is valid.
    """
    try:
        blob = base64.b64decode(b"".join(sig.splitlines()[1:-1]), validate=True)
        strings = _ssh_strings(blob[10:]) if blob.startswith(b"SSHSIG") else []
    except (ValueError, VouchError):
        return None
    return strings[0] if strings else None


def _signer(
    data: bytes, sig: bytes, namespace: str, keys: Sequence[PersonKey]
) -> Optional[PersonKey]:
    blob = _signed_by(sig)
    key = next((k for k in keys if base64.b64decode(k.ssh.split()[1]) == blob), None)
    return key if key is not None and _verifies(data, sig, namespace, key) else None


def signer_of(
    rel: str, data: bytes, sig: bytes, keys: Sequence[PersonKey]
) -> PersonKey:
    """Return the key in ``keys`` whose signature ``sig`` (one block) is over ``data``.

    The namespace comes from the record's directory (see NAMESPACES), so a
    signature made for one kind of record never verifies as another.

    Args:
        rel: The record's path below the registry root, as for ``parse_record``.
        data: The record file's exact bytes.
        sig: The bytes of ``rel + ".sig"``.
        keys: The keys allowed to have signed it.

    Raises:
        VouchError: ``sig`` is not exactly one signature, or none of ``keys``
            made it over these bytes in this namespace.
    """
    blocks = split_signatures(sig)
    if len(blocks) != 1:
        raise VouchError(f"{rel}.sig: must hold exactly one signature")
    key = _signer(data, blocks[0], NAMESPACES[rel.split("/")[0]], keys)
    if key is None:
        raise VouchError(f"{rel}.sig: no valid signature by an allowed key")
    return key


def verify_person(
    person: Person,
    data: bytes,
    sig: bytes,
    previous: Optional[Sequence[PersonKey]] = None,
    revoked: Collection[str] = (),
) -> bool:
    """Check the signatures on one version of a person file.

    Each signature in ``sig`` must be valid and by a different key that is
    current (has no ``retired`` time) in ``previous`` or in ``person``. One
    signature is enough, so backup keys can stay in a drawer. A signature
    by a revoked key is accepted, as revoking never fails the check, but it
    proves nothing, past or future.

    Args:
        person: The record parsed from ``data``.
        data: The exact bytes of ``people/<handle>.json``.
        sig: The bytes of its ``.sig`` file.
        previous: The keys current in the previous version, or None if this
            is the file's first version.
        revoked: The did:keys of every revoked key.

    Returns:
        Whether an unrevoked key in ``previous`` signed it, or, for a first
        version, one of its own. False means only registry review let the change
        through, which the caller warns about.

    Raises:
        VouchError: A signature is invalid, repeated or by any other key, or
            no key may sign it.
    """
    rel = f"people/{person.handle}.json"
    old = {k.ssh for k in previous or ()}
    own = [k for k in person.keys if k.retired is None]
    allowed = list({k.ssh: k for k in [*(previous or ()), *own]}.values())
    if not allowed:
        raise VouchError(f"{rel}: no current key to sign it")
    try:
        blocks = split_signatures(sig)
    except VouchError as e:
        raise VouchError(f"{rel}.sig: {e}") from e
    is_chained = False
    for block in blocks:
        key = _signer(data, block, NAMESPACES["people"], allowed)
        if key is None:
            raise VouchError(
                f"{rel}.sig: a signature is invalid, by a non-current key, or repeated"
            )
        allowed.remove(key)
        if key.did not in revoked and (previous is None or key.ssh in old):
            is_chained = True
    return is_chained


def verify_approval(
    rel: str, record: Union[Tier, Endorsement], data: bytes, sig: bytes, signer: Person
) -> PersonKey:
    """Check that a tier record or endorsement is signed by the key it names.

    Args:
        rel: The record's path below the registry root.
        record: The record parsed from ``data``.
        data: The record file's exact bytes.
        sig: The bytes of its ``.sig`` file.
        signer: The person file of the record's approver or endorser.

    Returns:
        The signer's key that made the signature; retirement and revocation
        are for the caller to judge.

    Raises:
        VouchError: ``signer`` is not the person named, the named did:key is
            not one of their keys, or the signature is not valid by that key.
    """
    if isinstance(record, Tier):
        handle, did = record.approver, record.approver_key
    else:
        handle, did = record.endorser, record.endorser_key
    if signer.handle != handle:
        raise VouchError(f"{rel}: signed by {handle}, not {signer.handle}")
    keys = [k for k in signer.keys if k.did == did]
    if not keys:
        raise VouchError(f"{rel}: {did} is not a key of {handle}")
    return signer_of(rel, data, sig, keys)


class Void(Exception):
    """A record that is well formed but has no effect, e.g. signed by a key since revoked."""


class Held(NamedTuple):
    """What a person held at a time, as ``query`` reports it."""

    tier: Optional[str]
    automation: bool
    emails: tuple[str, ...]  # endorsed, as listed


class CheckResult(NamedTuple):
    """What ``check_registry`` found."""

    people: dict[str, Person]  # person files whose signatures are valid
    tiers: dict[str, str]  # handle -> tier, for people with a valid tier
    revoked: dict[str, str]  # did:key -> "type base64" as listed in the person file
    emails: dict[str, tuple[str, ...]]  # handle -> endorsed emails, as listed
    problems: list[str]  # each makes check fail
    voids: list[str]  # records without effect; reported, not failures
    warnings: list[str]  # anything else reported without failing
    # handle -> tier -> when it ended, for tiers deleted or demoted (see
    # tier_ends) and for anchors dropped from anchors.json
    ended: dict[str, dict[str, datetime]]
    # (handle, time or None for now) -> what they held then (see check_registry)
    held_at: Callable[[str, Optional[datetime]], Optional[Held]]
    # handle -> each commit (or "the working tree") where its person file
    # changed without a signature by a key current in the version before
    unchained: dict[str, list[str]]


# A lower rank sits above a higher one; an approver must have a strictly lower rank.
RANK = {"anchor": 0, "maintainer": 1, "contributor": 2, "automation": 2}


def demotes(old: str, new: str) -> bool:
    """Return whether a record of tier ``new`` replacing ``old`` ends ``old`` (a demotion)."""
    return (old == "automation") != (new == "automation") or RANK[old] < RANK[new]


# The paths whose history check reads; endorsements are judged on the tree alone.
HISTORY_RE = re.compile(
    r"anchors\.json|(?:people|tiers|revocations)/[a-z0-9][a-z0-9_-]*\.json(?:\.sig)?"
)
# The endorsement paths whose history only ``query --at`` reads, one subject at a time.
ENDORSEMENT_RE = re.compile(
    r"endorsements/[a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9_-]*\.json(?:\.sig)?"
)


class History(NamedTuple):
    """Every version of the registry files check judges by history.

    Position ``i`` is the i-th commit of ``git rev-list --topo-order
    --reverse HEAD``; position ``final`` is the working tree, a child of
    HEAD, so uncommitted changes are judged as if committed next. A
    registry that is not a git work tree has only that position. Positions
    are ordered by ancestry, never by index: on a branched history the
    index depends on how the branches were merged, which the author of a
    change controls.

    A version is a position whose content differs from that of some parent,
    so the content anywhere is that of its nearest versions.
    """

    commits: list[str]  # per position, final excluded
    dates: list[int]  # committer time per position, as git prints it; final excluded
    parents: list[tuple[int, ...]]  # per position, final included
    ancestors: list[int]  # per position, bit j set if j is a strict ancestor
    # rel -> [(position, content or None if deleted)], by position
    versions: dict[str, list[tuple[int, Optional[bytes]]]]
    # Commits whose date ``date`` returned as LAST_SECOND; check reports each.
    far: set[str]

    @property
    def final(self) -> int:
        """Return the working tree's position."""
        return len(self.commits)

    def name(self, i: int) -> str:
        """Return the commit at position ``i``, or "the working tree"."""
        return self.commits[i] if i < self.final else "the working tree"

    def date(self, i: int) -> datetime:
        """Return the committer date at position ``i``; the working tree is dated now.

        A date beyond what datetime can hold is returned as LAST_SECOND and
        the commit added to ``far``, so one such commit never stops the
        history being read.
        """
        if i == self.final:
            return datetime.now(timezone.utc)
        try:
            return datetime.fromtimestamp(self.dates[i], timezone.utc)
        except (ValueError, OverflowError, OSError):
            self.far.add(self.commits[i])
            return LAST_SECOND

    def before(self, j: int, i: int) -> bool:
        """Return whether position ``j`` is a strict ancestor of position ``i``."""
        return bool(self.ancestors[i] >> j & 1)

    def concurrent(self, j: int, i: int) -> bool:
        """Return whether neither of positions ``i`` and ``j`` is an ancestor of the other."""
        return i != j and not self.before(j, i) and not self.before(i, j)

    def _nearest(self, rel: str, i: int) -> list[tuple[int, Optional[bytes]]]:
        seen = [
            v for v in self.versions.get(rel, []) if v[0] == i or self.before(v[0], i)
        ]
        return [v for v in seen if not any(self.before(v[0], w[0]) for w in seen)]

    def at(self, rel: str, i: int) -> Optional[bytes]:
        """Return the content of ``rel`` at position ``i``; None if it did not exist then."""
        nearest = self._nearest(rel, i)
        return nearest[0][1] if nearest else None

    def added(self, rel: str, i: int) -> tuple[int, ...]:
        """Return the positions of the commits that gave ``rel`` the content it has at ``i``.

        A merge that kept one parent's content did not add it: that parent's
        adding commits did. Content added on two branches has two.
        """
        data = self.at(rel, i)
        found: set[int] = set()
        todo = [j for j, _ in self._nearest(rel, i)]
        while todo:
            j = todo.pop()
            kept = [p for p in self.parents[j] if self.at(rel, p) == data]
            if kept:
                todo += [k for p in kept for k, _ in self._nearest(rel, p)]
            else:
                found.add(j)
        return tuple(sorted(found))


def _is_repo_top(root: Path) -> bool:
    """Return whether ``root`` is the top of a git work tree with at least one commit."""
    try:
        top = run([*GIT, "rev-parse", "--show-toplevel"], cwd=root).decode().strip()
        run([*GIT, "rev-parse", "--verify", "--quiet", "HEAD"], cwd=root)
    except VouchError:
        return False  # not a repository, or no commit yet: the tree is all there is
    return Path(top).resolve() == root.resolve()


def registry_history(
    root: Path,
    paths: Iterable[str],
    sources: Sequence[str] = ("anchors.json", "people", "tiers", "revocations"),
    pattern: re.Pattern[str] = HISTORY_RE,
    unreadable: Optional[list[str]] = None,
) -> History:
    """Return the history of ``anchors.json`` and of every person, tier and revocation file.

    Args:
        root: Registry checkout.
        paths: Record paths in the working tree, as from ``_record_paths``.
        sources: The paths below ``root`` whose logs list the files to read.
        pattern: Of the files found, those to read; the rest are ignored.
        unreadable: As for ``file_history``.

    Raises:
        VouchError: git fails, or a version cannot be read (see ``file_history``).
    """
    commits: list[list[str]] = []  # [committer time, commit, parent...], parents first
    if _is_repo_top(root):
        rev_list = [*GIT, "rev-list", "--topo-order", "--reverse", "--parents"]
        commits = [
            line.split()
            for line in run([*rev_list, "--timestamp", "HEAD"], cwd=root)
            .decode()
            .splitlines()
        ]
    order = {c[1]: i for i, c in enumerate(commits)}
    hashes = [c[1] for c in commits]
    dates = [int(c[0]) for c in commits]
    final = len(commits)
    parents = [tuple(order[p] for p in c[2:]) for c in commits]
    parents.append((final - 1,) if commits else ())
    # ponytail: one int of len(commits) bits per commit, quadratic memory;
    # fine for tens of thousands of commits.
    ancestors: list[int] = []
    for ps in parents:
        bits = 0
        for p in ps:
            bits |= ancestors[p] | 1 << p
        ancestors.append(bits)
    names = {"anchors.json", *paths, *(f"{p}.sig" for p in paths)}
    kept: dict[str, list[tuple[str, str, str]]] = {}  # rel -> [(merge, mode, blob)]
    if commits:
        log = run(
            # --full-history: a side branch's files count even where a merge
            # dropped them, so a revocation merged with -s ours still holds.
            [
                *GIT_LOG,
                "log",
                "--full-history",
                "--format=",
                "--name-only",
                "-z",
                "--no-renames",
            ],
            values=sources,
            cwd=root,
        )
        names.update(n.strip("\n") for n in log.decode(errors="replace").split("\0"))
        # file_history leaves out a merge that kept one parent's content; list
        # every merge that differs from any parent, with its own blob.
        log = run(
            [
                *GIT_LOG,
                "-c",
                "log.diffMerges=separate",
                "log",
                "--merges",
                "--full-history",
                "-m",
                "--raw",
                "--no-renames",
                "--no-abbrev",
                "-z",
                "--format=%H",
            ],
            values=sources,
            cwd=root,
        )
        tokens = iter(log.split(b"\0"))
        for token in tokens:
            token = token.strip(b"\n")
            if not token.startswith(b":"):
                merge = token.decode()
                continue
            fields = token[1:].decode().split()
            rel = next(tokens, b"").decode(errors="replace")
            if pattern.fullmatch(rel):
                kept.setdefault(rel, []).append((merge, fields[1], fields[3]))
            elif fields[1] != "000000":
                # A file below a record path: the merge left a directory there.
                for top in (rel[:i] for i, c in enumerate(rel) if c == "/"):
                    if pattern.fullmatch(top):
                        kept.setdefault(top, []).append((merge, "040000", merge))
    wanted = sorted(n for n in names if pattern.fullmatch(n))
    logs = file_histories(root, wanted, sources, unreadable) if commits else {}
    merged: dict[str, dict[str, tuple[str, str]]] = {}  # rel -> merge -> (mode, blob)
    for rel in wanted:
        merges = merged.setdefault(rel, {})
        for m, mode, blob in kept.get(rel, []):
            if merges.get(m, ("",))[0] != "040000":
                merges[m] = (mode, blob)
    blobs = {
        b for ms in merged.values() for mode, b in ms.values() if mode in FILE_MODES
    }
    contents = read_blobs(root, ", ".join(sources), sorted(blobs), True)
    versions: dict[str, list[tuple[int, Optional[bytes]]]] = {}
    for rel in wanted:
        found = {order[v.commit]: v.data for v in logs.get(rel, ())}
        for m, (mode, blob) in sorted(merged[rel].items()):
            data = contents.get(blob) if mode in FILE_MODES else None
            if mode != "000000" and data is None:
                data = _unreadable(rel, m, blob, unreadable)
            found.setdefault(order[m], data)
        history = sorted(found.items())
        try:
            now: Optional[bytes] = read_capped(root, rel)
        except VouchError:
            now = None  # missing, or reported by check as a record problem
        head = History(hashes, dates, parents, ancestors, {rel: history}, set()).at(
            rel, final
        )
        if head != now:
            history.append((final, now))
        versions[rel] = history
    return History(hashes, dates, parents, ancestors, versions, set())


def _record_paths(root: Path, problems: list[str]) -> list[str]:
    """Return the path of every record file, adding a problem for every unexpected entry."""

    def printable(d: str, names: list[str]) -> list[str]:
        # Names are untrusted and end up on the merger's terminal.
        for name in names:
            if not name.isprintable():
                problems.append(f"{d}/{name!r}: unexpected file")
        return [n for n in names if n.isprintable()]

    dirs = ["people", "tiers", "revocations"]
    try:
        subjects = printable("endorsements", list_dir(root, "endorsements"))
        dirs += [f"endorsements/{s}" for s in subjects]
    except VouchError as e:
        problems.append(str(e))
    paths = []
    for d in dirs:
        try:
            names = printable(d, list_dir(root, d))
        except VouchError as e:
            problems.append(str(e))
            continue
        for name in names:
            if name.endswith(".json"):
                paths.append(f"{d}/{name}")
            elif not (
                name.endswith(
                    (".json.sig", ".json.asc") if d == "people" else ".json.sig"
                )
                and name[:-4] in names
            ):
                problems.append(f"{d}/{name}: unexpected file")
    return paths


def _in_validity(rel: str, key: PersonKey, date: datetime) -> None:
    # Both ends inclusive, as OpenSSH treats valid-after and valid-before: a
    # record dated in its key's retirement second is valid.
    if date < key.added or (key.retired is not None and date > key.retired):
        raise VouchError(f"{rel}: dated outside the validity of {key.did}")


def check_registry(root: Path) -> CheckResult:
    """Validate every record in the registry checkout at ``root`` and compute every tier.

    Records are judged by the registry's git history (see ``History``). A
    tier record is valid if its approver held the authority at the commit
    that added it, so an approver stepping down voids nothing. A key listed
    in two person files belongs to the one whose commit listed it first. A
    revocation counts once committed, even if later deleted, unless the key
    that signed it was revoked in an ancestor commit. "Earlier" and "first"
    always mean ancestry, never the order git lists branched commits in.

    A problem is a record that is malformed, wrongly signed, or made by
    someone without the authority to make it. A void record is valid in
    itself but has no effect: it was signed by a key since revoked, it
    depends on a record that is void or has a problem, or it is a tier
    record committed before its subject's person file or concurrently with
    a commit that took its approver's authority. An email may be
    listed in only one person file, ignoring case; it is endorsed if a
    valid endorsement lists it in ``subjectEmails``, and an unendorsed
    email is a warning. So is every version of a person file that no
    unrevoked key current in its previous version signed (for a merge that
    kept one side's version, the concurrent change it dropped), and every person
    file whose ``migratedFrom`` fingerprint another one also claims
    (ignoring case), whichever merged first. Void records and
    warnings do not fail the check, so a revocation never blocks the export
    that spreads it.

    A tier ends where a commit deleted its record or replaced it with one
    that has no effect, at that commit's committer date, or where a lower
    tier or one across the automation line replaced it, at the new record's
    ``date``, provided the record verified at the parent commit. A record
    that does not verify ends nothing. An anchor ends at the committer date
    of the commit that dropped them from ``anchors.json``.

    ``held_at(handle, when)`` is what a valid person held at ``when``, for
    ``query --at``: the registry then is the newest commit on HEAD's
    first-parent line dated at or before ``when``. Their tier there, or a
    tier that ended after ``when`` as that commit's history has it, whichever
    ranks highest (a human tier wins over automation); automation if that
    tier is or that commit's person file names an accountable maintainer;
    the emails that person file lists and that an endorsement in that
    commit endorses, judged as the working tree's are (none, with a
    warning, if their history cannot be read; check never reads it). None if
    no person file of theirs parses at that commit. Revocations count at
    every time, as everywhere. Export answers for now instead, so it can
    differ for past times.

    Raises:
        VouchError: ssh-keygen cannot be run, or the history cannot be read.
    """
    problems: list[str] = []
    voids: list[str] = []
    warnings: list[str] = []
    unchained: dict[str, list[str]] = {}
    try:
        anchors = parse_anchors(read_capped(root, "anchors.json"))
    except VouchError as e:
        problems.append(str(e))
        anchors = ()

    parsed: dict[str, tuple[Person, bytes, bytes]] = {}
    tier_records: list[tuple[str, Tier, bytes, bytes]] = []
    endorsements: list[tuple[str, Endorsement, bytes, bytes]] = []
    paths = _record_paths(root, problems)
    for rel in paths:
        try:
            data = read_capped(root, rel)
            record = parse_record(rel, data)
            sig = read_capped(root, rel + ".sig")
        except VouchError as e:
            problems.append(str(e))
            continue
        if isinstance(record, Person):
            parsed[record.handle] = (record, data, sig)
        elif isinstance(record, Tier):
            tier_records.append((rel, record, data, sig))
        elif isinstance(record, Endorsement):
            endorsements.append((rel, record, data, sig))

    # An email becomes a principal, so two files listing it could sign as each other.
    email_owner: dict[str, str] = {}
    for handle, (person, _, _) in sorted(parsed.items()):
        for email in person.emails:
            other = email_owner.setdefault(email.lower(), handle)
            if other != handle:
                problems.append(
                    f"people/{handle}.json: {other} and {handle} both list the email {email}"
                )

    # A past version git-vouch cannot read counts as one that does not parse:
    # a warning, so it never blocks the export for good.
    unreadable: list[str] = []
    history = registry_history(root, paths, unreadable=unreadable)
    warnings += dict.fromkeys(unreadable)
    final = history.final

    def record_at(rel: str, i: int) -> Optional[Record]:
        data = history.at(rel, i)
        try:
            return None if data is None else parse_record(rel, data)
        except VouchError:
            return None  # only the working tree's version is reported on

    def person_at(handle: str, i: int) -> Optional[Person]:
        person = record_at(f"people/{handle}.json", i)
        return person if isinstance(person, Person) else None

    def keys_at(handle: str, i: int) -> Optional[Person]:
        """Return the person file at ``i``, or only its keys if it no longer parses strictly.

        Continuity depends on keys alone, so an older version that a stricter
        git-vouch rejects still chains its successors.
        """
        person = person_at(handle, i)
        data = history.at(f"people/{handle}.json", i)
        if person is not None or data is None:
            return person
        try:
            obj = _load_json(data)
            if not isinstance(obj, dict):
                return None
            keys = tuple(_person_key(k, "keys") for k in _list(obj, "keys"))
        except VouchError:
            return None
        return Person(handle, handle, (), keys, None, None)

    def anchors_at(i: int) -> tuple[str, ...]:
        data = history.at("anchors.json", i)
        try:
            return () if data is None else parse_anchors(data)
        except VouchError:
            return ()

    def pair_at(rel: str, i: int) -> tuple[Optional[bytes], Optional[bytes]]:
        return history.at(rel, i), history.at(rel + ".sig", i)

    def adding(rel: str, i: int) -> list[int]:
        """Return the latest commits that gave ``rel`` and its .sig their content at ``i``."""
        found = {*history.added(rel, i), *history.added(rel + ".sig", i)}
        return [a for a in found if not any(history.before(a, b) for b in found)]

    # Every version of a person file needs a signature by a key current at
    # one of its parents. One without, or with no .sig at all, is let
    # through by review, never an error, but warned about loudly once
    # revocations are known. The working tree's file is judged at the latest
    # version that gave it its content, not against itself.
    people: dict[str, Person] = {}
    # (handle, position, previous keys or None, keys to name as old)
    person_versions: list[
        tuple[str, int, Optional[list[PersonKey]], list[PersonKey]]
    ] = []
    restored: list[tuple[str, int, Optional[list[PersonKey]], list[PersonKey]]] = []
    for rel in sorted(history.versions):
        if not (rel.startswith("people/") and rel.endswith(".json")):
            continue
        handle = rel[len("people/") : -len(".json")]
        changes = [
            i
            for i in sorted(
                {
                    i
                    for i, _ in history.versions[rel]
                    + history.versions.get(rel + ".sig", [])
                }
            )
            if pair_at(rel, i)[0] is not None
            and pair_at(rel, i) not in [pair_at(rel, p) for p in history.parents[i]]
        ]
        now = parsed.get(handle)
        origins = [j for j in changes if now and pair_at(rel, j) == now[1:]]
        origin = max(
            (j for j in origins if not any(history.before(j, k) for k in origins)),
            default=None,
        )
        for i in changes:
            version = keys_at(handle, i)
            body, signature = pair_at(rel, i)
            if version is None or body is None:
                continue  # the working tree's version is already reported
            was = [keys_at(handle, p) for p in history.parents[i]]
            old = [k for v in was if v for k in v.keys if k.retired is None]
            # Only a version no other one precedes or runs concurrently with
            # is a first version, so a branch that never saw the file cannot
            # start it afresh.
            prior = [
                v
                for j, d in history.versions[rel]
                if d is not None and j != i and not history.before(i, j)
                for v in [keys_at(handle, j)]
                if v
            ]
            previous = old if prior else None
            if i == origin and signature is not None:
                try:
                    verify_person(version, body, signature, previous)
                except VouchError as e:
                    problems.append(str(e))
                    continue
                people[handle] = version
            gone = old or [k for v in prior for k in v.keys]
            person_versions.append((handle, i, previous, gone))
        # A merge that kept one parent's version over a change made
        # concurrently on another parent is judged against that change, for
        # the warning only: the change may have retired the kept version's
        # signer.
        for i in sorted({i for i, _ in history.versions[rel]}):
            pair = pair_at(rel, i)
            if len(history.parents[i]) < 2 or pair[0] is None or i in changes:
                continue
            kept = adding(rel, i)
            others = [
                v
                for q in history.parents[i]
                if pair_at(rel, q) != pair
                and any(
                    not any(s == k or history.before(s, k) for k in kept)
                    for s in adding(rel, q)
                )
                for v in [keys_at(handle, q)]
                if v
            ]
            if others:
                old = [k for v in others for k in v.keys if k.retired is None]
                restored.append((handle, i, old, old))

    # A key belongs to one person, or export would credit their signatures to
    # another. Listing a key as current, in a validly signed version of a
    # person file that the key itself signed, is proven by that signature; any
    # other listing proves nothing, so a proven listing always wins. Among current listings, or among
    # retired ones when there is no current listing, the first wins: first
    # means in an ancestor commit, and files that listed it in one commit, or
    # on branches merged together, are tied. Losing to a current listing
    # drops the lister.
    # ponytail: a key only ever retired, and first listed by two tied files,
    # is reported but evicts nobody.
    first: dict[str, dict[str, int]] = {}  # did -> handle -> first listing
    for rel, found in history.versions.items():
        if rel.startswith("people/") and rel.endswith(".json"):
            for i, _ in found:
                version = person_at(rel[7:-5], i)
                for key in version.keys if version else ():
                    first.setdefault(key.did, {}).setdefault(rel[7:-5], i)
    # did -> each version listing it current: (handle, position, previous keys)
    listings: dict[str, list[tuple[str, int, Optional[list[PersonKey]]]]] = {}
    for handle, i, previous, _ in sorted(person_versions, key=lambda v: v[1]):
        version = person_at(handle, i)
        for key in version.keys if version else ():
            if key.retired is None:
                listings.setdefault(key.did, []).append((handle, i, previous))
    signed: dict[tuple[str, int, str], bool] = {}

    def is_signed(
        handle: str, i: int, previous: Optional[list[PersonKey]], did: str
    ) -> bool:
        """Return whether version ``i`` is valid and signed by the key ``did``."""
        if (handle, i, did) not in signed:
            version = person_at(handle, i)
            body, signature = pair_at(f"people/{handle}.json", i)
            signed[handle, i, did] = False
            if version and body is not None and signature is not None:
                key = next(k for k in version.keys if k.did == did)
                try:
                    verify_person(version, body, signature, previous)
                except VouchError:
                    pass  # an unsigned listing proves nothing
                else:
                    signed[handle, i, did] = any(
                        _signer(body, block, NAMESPACES["people"], [key])
                        for block in split_signatures(signature)
                    )
        return signed[handle, i, did]

    def first_current(did: str) -> dict[str, int]:
        """Return each file's first listing of ``did`` as current, if proven."""
        found: dict[str, int] = {}
        for handle, i, previous in listings.get(did, []):
            if handle not in found and is_signed(handle, i, previous, did):
                found[handle] = i
        return found

    def owners(did: str) -> list[str]:
        listed = first.get(did, {})
        if len(listed) > 1:
            listed = first_current(did) or listed
        return sorted(
            h
            for h, i in listed.items()
            if not any(history.before(j, i) for j in listed.values())
        )

    def owns(handle: str, did: str) -> bool:
        return handle in owners(did)

    claimants: set[str] = set()
    for handle, person in people.items():
        for key in person.keys:
            others = [h for h in owners(key.did) if h != handle]
            if not others:
                continue
            proven = first_current(key.did)
            if not owns(handle, key.did) and (not proven or handle in proven):
                claimants.add(handle)
                problems.append(
                    f"people/{handle}.json: {key.did} was listed first by {others[0]}"
                )
            elif proven:
                claimants.add(handle)
                problems.append(
                    f"people/{handle}.json: {key.did} is listed as a current key"
                    f" of {others[0]}"
                )
            else:
                problems.append(
                    f"people/{handle}.json: {key.did} is also listed by {others[0]}"
                )
    for handle in claimants:
        del people[handle]

    # Every revocation ever committed counts, even if its file was later
    # deleted, unless the key that signed it was revoked in an ancestor
    # commit; revocations in one commit, or on branches merged together, all
    # count. Signers are judged by the person files and anchors of the commit
    # that added the revocation, and every key must belong to the person
    # listing it. A rejected one that is no longer in the tree is a warning.
    committed: dict[tuple[str, bytes, bytes], int] = {}
    for rel, found in history.versions.items():
        if not rel.startswith("revocations/") or rel.endswith(".sig"):
            continue
        sig_found = history.versions.get(rel + ".sig", [])
        for i in sorted({i for i, _ in found + sig_found}):
            body, signature = history.at(rel, i), history.at(rel + ".sig", i)
            if body is not None and signature is not None:
                committed.setdefault((rel, body, signature), i)
    revoked_at: dict[str, list[int]] = {}
    revoked: dict[str, str] = {}
    for (rel, data, sig), i in sorted(committed.items(), key=lambda c: c[1]):
        try:
            rev = parse_record(rel, data)
        except VouchError:
            continue  # the working tree's version is already reported
        if not isinstance(rev, Revocation):
            continue
        is_current = (data, sig) == (
            history.at(rel, final),
            history.at(rel + ".sig", final),
        )
        try:
            subject = person_at(rev.subject, i)
            if subject is None:
                raise VouchError(f"{rel}: no person file for {rev.subject}")
            key = next((k for k in subject.keys if k.did == rev.key), None)
            if key is None or not owns(rev.subject, key.did):
                raise VouchError(f"{rel}: {rev.key} is not a key of {rev.subject}")
            signers = [key]
            for handle in (rev.subject, *anchors_at(i)):
                version = person_at(handle, i)
                signers += [
                    k
                    for k in (version.keys if version else ())
                    if k.retired is None and owns(handle, k.did)
                ]
            signer = signer_of(rel, data, sig, signers)
            if any(history.before(j, i) for j in revoked_at.get(signer.did, [])):
                raise Void(
                    f"{rel}: void: {signer.did} was revoked in an earlier commit"
                )
            revoked_at.setdefault(key.did, []).append(i)
            revoked.setdefault(key.did, key.ssh)
        except VouchError as e:
            if is_current:
                problems.append(str(e))
            else:
                warnings.append(f"{e} (ignored, at {history.name(i)})")
        except Void as e:
            if is_current:
                voids.append(str(e))

    for handle, i, previous, gone in person_versions + restored:
        rel = f"people/{handle}.json"
        version, (body, signature) = keys_at(handle, i), pair_at(rel, i)
        if version is None or body is None:
            continue  # not in person_versions; narrows the types
        try:
            is_chained = signature is not None and verify_person(
                version, body, signature, previous, revoked
            )
        except VouchError:
            is_chained = False  # a bad signature chains nothing
        if not is_chained:
            old_dids = ", ".join(dict.fromkeys(k.did for k in gone)) or "none"
            new_dids = (
                ", ".join(k.did for k in version.keys if k.retired is None) or "none"
            )
            unchained.setdefault(handle, []).append(history.name(i))
            warnings.append(
                f"{rel}: WARNING: changed at {history.name(i)} without a signature"
                " by any unrevoked key current in the previous version; only registry"
                f" review let it through (old keys: {old_dids}; new keys: {new_dids})"
            )

    def check_signer(
        rel: str, record: Union[Tier, Endorsement], data: bytes, sig: bytes, signer: str
    ) -> None:
        if signer not in parsed:
            raise VouchError(f"{rel}: no person file for {signer}")
        if signer not in people:
            raise Void(f"{rel}: void: the person file of {signer} is invalid")
        key = verify_approval(rel, record, data, sig, people[signer])
        # Revoked first: a revoked key's dates prove nothing either way.
        if key.did in revoked:
            raise Void(f"{rel}: void: {key.did} of {signer} is revoked")
        _in_validity(rel, key, record.date)

    def claimed_at(handle: str, i: int) -> Optional[str]:
        if handle in anchors_at(i):
            return "anchor"
        record = record_at(f"tiers/{handle}.json", i)
        return record.tier if isinstance(record, Tier) else None

    def may_grant(approver: str, i: int, tier: str) -> bool:
        claim = claimed_at(approver, i)
        return claim is not None and RANK[claim] < RANK[tier]

    def lowered(handle: str, tier: str, added: tuple[int, ...]) -> list[int]:
        # Commits concurrent with ``added`` that took from ``handle`` the
        # authority to grant ``tier``: which of the two came first is not
        # recorded.
        return [
            j
            for path in ("anchors.json", f"tiers/{handle}.json")
            for j, _ in history.versions.get(path, [])
            if any(history.concurrent(j, a) for a in added)
            and not may_grant(handle, j, tier)
            and any(may_grant(handle, p, tier) for p in history.parents[j])
        ]

    def tier_at(handle: str, i: int) -> Optional[str]:
        if handle in anchors_at(i):
            return "anchor" if handle in people else None
        result = judge(handle, i)
        return result if isinstance(result, str) else None

    judged: dict[tuple[str, int], Union[str, VouchError, Void]] = {}

    def judge(handle: str, i: int) -> Union[str, VouchError, Void]:
        if (handle, i) not in judged:
            try:
                judged[handle, i] = judge_tier(handle, i)
            except (VouchError, Void) as e:
                judged[handle, i] = e
        return judged[handle, i]

    def judge_tier(handle: str, i: int) -> str:
        # Each approver judged here claims a strictly higher tier than the
        # record they approved, so the recursion through tier_at ends.
        rel = f"tiers/{handle}.json"
        data, sig = history.at(rel, i), history.at(rel + ".sig", i)
        t = record_at(rel, i)
        if data is None or sig is None or not isinstance(t, Tier):
            raise VouchError(f"{rel}: no valid tier record at that commit")
        added = history.added(rel, i)
        if t.subject not in parsed:
            raise VouchError(f"{rel}: no person file for {t.subject}")
        if t.approver == t.subject:
            raise VouchError(f"{rel}: {t.subject} cannot approve themselves")
        # The approver must have held the authority where the record was added.
        for a in added:
            if not may_grant(t.approver, a, t.tier):
                raise VouchError(
                    f"{rel}: {t.approver} ({claimed_at(t.approver, a) or 'no tier'})"
                    f" may not grant {t.tier}"
                )
        # These bytes may not come back, by a commit or a merge, over a
        # demotion committed after them: the signature covers the bytes, so
        # only the approver can make a newer record. Judged by ancestry from
        # i, so deleting the demotion first or merging hides nothing.
        # Ascending, so each judge below finds the earlier ones judged.
        same = 0
        for v, d in history.versions[rel]:
            if d == data and history.before(v, i):
                same |= 1 << v
        tier_of: dict[bytes, Optional[str]] = {}  # each content parsed once
        for w, d in history.versions[rel]:
            if d is None or d == data or not history.before(w, i):
                continue
            if not history.ancestors[w] & same:
                continue
            if d not in tier_of:
                try:
                    was = parse_record(rel, d)
                except VouchError:
                    was = None
                tier_of[d] = was.tier if isinstance(was, Tier) else None
            was_tier = tier_of[d]
            if (
                was_tier is not None
                and demotes(t.tier, was_tier)
                and not isinstance(judge(handle, w), VouchError)
            ):
                raise VouchError(
                    f"{rel}: restores an earlier record at {history.name(i)},"
                    f" undoing the {was_tier} record at {history.name(w)};"
                    " needs a new approval"
                )
        if any(history.at(f"people/{t.subject}.json", a) is None for a in added):
            raise Void(f"{rel}: void: committed before people/{t.subject}.json existed")
        # Like the approver, the accountable maintainer is judged where the
        # record was added, so stepping down later voids nothing.
        accountables: list[tuple[str, int]] = []
        if t.tier == "automation":
            # The person file at i, so a bot since made human was one then.
            require_accountable(person_at(t.subject, i) or parsed[t.subject][0])
            for a in added:
                person = person_at(t.subject, a)
                accountable = (person.accountable if person else None) or ""
                # A maintainer or anchor is exactly who may grant contributor.
                if not may_grant(accountable, a, "contributor"):
                    raise VouchError(
                        f"people/{t.subject}.json: accountable: {accountable}"
                        " is not a maintainer or anchor"
                    )
                accountables.append((accountable, a))
        check_signer(rel, t, data, sig, t.approver)
        # Authority lost on a branch merged in alongside may have been lost
        # first, which git does not record: void until re-approved. The
        # accountable is judged like the approver.
        concurrent = lowered(t.approver, t.tier, added)
        if concurrent:
            raise Void(
                f"{rel}: void: {t.approver} lost the authority to grant {t.tier}"
                f" in concurrent commit {history.name(concurrent[0])};"
                " needs a new approval"
            )
        for accountable, a in accountables:
            concurrent = lowered(accountable, "contributor", (a,))
            if concurrent:
                raise Void(
                    f"{rel}: void: accountable {accountable} stopped being a"
                    " maintainer or anchor in concurrent commit"
                    f" {history.name(concurrent[0])}; needs a new approval"
                )
        if any(tier_at(t.approver, a) is None for a in added):
            raise Void(f"{rel}: void: {t.approver} has no valid tier")
        if t.subject not in people:
            raise Void(f"{rel}: void: the person file of {t.subject} is invalid")
        for accountable, a in accountables:
            if tier_at(accountable, a) not in ("anchor", "maintainer"):
                raise Void(f"{rel}: void: {accountable} has no valid tier")
        # The accountable is judged only with an approval, so naming another
        # one needs a new approval.
        person = person_at(t.subject, i)
        now = person.accountable if person else None
        if any(accountable != now for accountable, _ in accountables):
            raise Void(
                f"{rel}: void: accountable changed to {now} after the record"
                " was added; needs a new approval"
            )
        return t.tier

    stood: dict[tuple[str, int], list[tuple[int, Union[str, Void, None]]]] = {}

    def standing(handle: str, i: int) -> list[tuple[int, Union[str, Void, None]]]:
        # The versions of the tier record in effect at i: a record that does
        # not verify changes nothing, so the ones before it stand. Walked,
        # not recursed, so merges of unverified records cannot blow it up.
        # ponytail: each position walks its own unverified run, so a long
        # run costs quadratic time; share the walk if that bites.
        rel = f"tiers/{handle}.json"
        if (handle, i) not in stood:
            found: dict[int, Union[str, Void, None]] = {}
            todo, seen = [i], set()
            while todo:
                j = todo.pop()
                if j in seen:
                    continue
                seen.add(j)
                held = None if history.at(rel, j) is None else judge(handle, j)
                if isinstance(held, VouchError):
                    todo += [p for a in adding(rel, j) for p in history.parents[a]]
                else:
                    found[j] = held
            stood[handle, i] = list(found.items())
        return stood[handle, i]

    tiers: dict[str, str] = {}
    for a in anchors:
        if a not in parsed:
            problems.append(f"anchors.json: no person file for {a}")
        elif a in people:
            tiers[a] = "anchor"
    for rel, t, _, _ in tier_records:
        if t.subject in anchors:
            problems.append(f"{rel}: {t.subject} is an anchor")
            continue
        result = judge(t.subject, final)
        if isinstance(result, str):
            tiers[t.subject] = result
        elif isinstance(result, Void):
            voids.append(str(result))
        else:
            problems.append(str(result))

    def tier_ends(handle: str, start: int) -> dict[str, datetime]:
        # Walk back from ``start`` through every version of the tier record;
        # a tier held more than once ends at its latest end.
        rel = f"tiers/{handle}.json"
        ends: dict[str, datetime] = {}
        todo, seen = [j for j, _ in standing(handle, start)], set()
        while todo:
            i = todo.pop()
            if i in seen:
                continue
            seen.add(i)
            held = standing(handle, i)[0][1]
            record = record_at(rel, i)
            for a in adding(rel, i):
                for p in history.parents[a]:
                    for j, was in standing(handle, p):
                        todo.append(j)
                        if not isinstance(was, str):
                            continue
                        if not (isinstance(held, str) and isinstance(record, Tier)):
                            end = history.date(a)  # deleted, or replaced without effect
                        elif demotes(was, held):
                            end = record.date
                        else:
                            continue
                        ends[was] = max(end, ends.get(was, end))
        return ends

    def anchor_ends(start: int) -> dict[str, datetime]:
        # Like a deleted tier record, an anchor ends at the latest committer
        # date of a commit at or before ``start`` that dropped them from
        # anchors.json.
        # ponytail: an anchors.json version that does not parse lists nobody,
        # so it ends every anchor its parent listed; review keeps it out.
        ends: dict[str, datetime] = {}
        for j, _ in history.versions.get("anchors.json", []):
            if j != start and not history.before(j, start):
                continue
            for a in history.added("anchors.json", j):
                for p in history.parents[a]:
                    for handle in set(anchors_at(p)) - set(anchors_at(j)):
                        end = history.date(a)
                        ends[handle] = max(end, ends.get(handle, end))
        return ends

    ended: dict[str, dict[str, datetime]] = {}
    for rel in history.versions:
        handle = rel[len("tiers/") : -len(".json")]
        if rel == f"tiers/{handle}.json" and handle in people and handle not in anchors:
            ends = tier_ends(handle, final)
            if ends:
                ended[handle] = ends
    for handle, end in anchor_ends(final).items():
        if handle in people and handle not in anchors:
            ends = ended.setdefault(handle, {})
            ends["anchor"] = max(end, ends.get("anchor", end))

    claimed: dict[str, str] = {t.subject: t.tier for _, t, _, _ in tier_records}
    automation = {h for h, tier in claimed.items() if tier == "automation"}
    automation |= {h for h, (p, _, _) in parsed.items() if p.accountable is not None}

    def judge_endorsement(
        rel: str, e: Endorsement, data: bytes, sig: bytes, subject: Person
    ) -> None:
        if e.endorser in automation:
            raise VouchError(f"{rel}: {e.endorser} is automation and cannot endorse")
        if e.subject_key not in {k.did for k in subject.keys}:
            raise VouchError(f"{rel}: {e.subject_key} is not a key of {e.subject}")
        # Only a revoked endorser key voids it; like the tier, an
        # endorsement carries over to the subject's later keys.
        check_signer(rel, e, data, sig, e.endorser)
        if e.subject_name != subject.name:
            raise Void(f"{rel}: void: endorses the name {e.subject_name!r:.60}")
        if e.endorser == e.subject:
            raise Void(f"{rel}: void: {e.subject} cannot endorse themselves")

    endorsed: dict[str, set[str]] = {}  # handle -> lowercased endorsed emails
    for rel, e, data, sig in endorsements:
        try:
            if e.subject not in parsed:
                raise VouchError(f"{rel}: no person file for {e.subject}")
            judge_endorsement(rel, e, data, sig, parsed[e.subject][0])
            endorsed.setdefault(e.subject, set()).update(
                m.lower() for m in e.subject_emails
            )
        except VouchError as err:
            problems.append(str(err))
        except Void as err:
            voids.append(str(err))

    emails: dict[str, tuple[str, ...]] = {}
    for handle, person in sorted(people.items()):
        for key in person.keys:
            if key.retired is None and key.did in revoked:
                warnings.append(
                    f"people/{handle}.json: {key.did} is revoked but not retired"
                )
        ok = endorsed.get(handle, set())
        emails[handle] = tuple(m for m in person.emails if m.lower() in ok)
        for email in person.emails:
            if email.lower() not in ok:
                warnings.append(
                    f"people/{handle}.json: {email} is not endorsed, so not exported"
                )

    claims: dict[str, list[str]] = {}
    for handle, person in sorted(people.items()):
        if person.migrated_from is not None:
            claims.setdefault(person.migrated_from, []).append(handle)
    for fpr, handles in claims.items():
        for handle in handles if len(handles) > 1 else []:
            others = ", ".join(h for h in handles if h != handle)
            warnings.append(
                f"people/{handle}.json: migratedFrom openpgp4fpr:{fpr}"
                f" is also claimed by {others}"
            )

    def endorsed_at(person: Person, i: int) -> set[str]:
        # The emails endorsed at position i, by endorsements as they were
        # there, judged as the working tree's are. Their history is read
        # only here, for one subject, so check never pays for it, and a
        # past version git-vouch cannot read fails this query alone, closed.
        prefix = f"endorsements/{person.handle}"
        try:
            past = registry_history(
                root,
                [p for p in paths if p.startswith(prefix + "/")],
                [prefix],
                ENDORSEMENT_RE,
            )
        except VouchError as e:
            print(
                f"git-vouch: warning: {e}; so no email of {person.handle}"
                " counts as endorsed then",
                file=sys.stderr,
            )
            return set()
        ok: set[str] = set()
        for rel in past.versions:
            data, sig = past.at(rel, i), past.at(rel + ".sig", i)
            if rel.endswith(".sig") or data is None or sig is None:
                continue
            try:
                e = parse_record(rel, data)
                if not isinstance(e, Endorsement):
                    continue
                judge_endorsement(rel, e, data, sig, person)
            except (VouchError, Void):
                continue  # counts for nothing, as in the working tree
            ok.update(m.lower() for m in e.subject_emails)
        return ok

    def held_at(handle: str, when: Optional[datetime]) -> Optional[Held]:
        # The registry at ``when`` is the newest commit on HEAD's first-parent
        # line, the registry's own merges, dated at or before it; None is
        # now, the working tree.
        # ponytail: a registry without commits has no history to bound by,
        # so its files count at every time.
        i: Optional[int] = final
        if when is not None and history.commits:
            while i is not None and history.date(i) > when:
                i = history.parents[i][0] if history.parents[i] else None
        person = None if i is None else person_at(handle, i)
        if i is None or person is None or handle not in people:
            return None
        ok = endorsed.get(handle, set()) if when is None else endorsed_at(person, i)
        when = when or datetime.now(timezone.utc)
        held = [t for _, t in standing(handle, i) if isinstance(t, str)]
        if handle in anchors_at(i):
            held.append("anchor")
        ends = {**tier_ends(handle, i), "anchor": anchor_ends(i).get(handle, when)}
        held += [t for t, end in ends.items() if when < end]
        # An end committed after ``when`` still counts from its own date, as
        # in export, so query never grants more than export for ``when``.
        # ponytail: a tier ended, granted again and ended again keeps only
        # its latest end, so an earlier end committed after ``when`` is
        # missed; record every end per tier if that bites.
        gone = {**tier_ends(handle, final), "anchor": anchor_ends(final).get(handle)}
        gone = {t for t, end in gone.items() if end is not None and end <= when}
        held = [t for t in held if t not in gone]
        humans = [t for t in held if t != "automation"]
        tier = min(humans, key=RANK.__getitem__) if humans else None
        tier = tier or ("automation" if held else None)
        return Held(
            tier,
            tier == "automation"
            or (person.accountable is not None and "automation" not in gone),
            tuple(m for m in person.emails if m.lower() in ok),
        )

    # A problem, not an abort, so sync still writes the revocation file.
    problems += (
        f"commit {c}: committer date out of range" for c in sorted(history.far)
    )
    return CheckResult(
        people,
        tiers,
        revoked,
        emails,
        problems,
        voids,
        warnings,
        ended,
        held_at,
        unchained,
    )


def _report(result: CheckResult) -> None:
    for message in [*result.voids, *result.warnings]:
        print(f"git-vouch: warning: {message}", file=sys.stderr)
    for message in result.problems:
        print(f"git-vouch: error: {message}", file=sys.stderr)


def cmd_check(args: argparse.Namespace) -> int:
    """Print every valid person's tier; report warnings, then errors.

    The exit status is 1 if there is any error; warnings alone exit 0.
    """
    root = _registry_dir(args.registry)
    _fetched(root)
    result = check_registry(root)
    for handle in sorted(result.people):
        print(handle, result.tiers.get(handle, "none"))
    _report(result)
    return 1 if result.problems else 0


def _ssh_time(when: datetime) -> str:
    return when.strftime("%Y%m%d%H%M%SZ")  # the trailing Z makes OpenSSH read it as UTC


def allowed_signers(
    result: CheckResult, min_tier: str = "contributor", include_automation: bool = False
) -> str:
    """Return git's allowed-signers file for everyone at or above ``min_tier``.

    Each key gets one line: the handle and then the person's endorsed
    emails as principals, ``namespaces="git,file"`` (``"file"`` for
    automation, which appears only with ``include_automation``),
    ``valid-after`` from ``added`` and
    ``valid-before`` from ``retired`` or from when the person's tier at or
    above ``min_tier`` ended (see ``check_registry``), whichever is
    earlier, plus END_SLACK. Revoked keys are left out; they also go in the
    revocation file.

    Args:
        result: A check result with no problems.
        min_tier: ``anchor``, ``maintainer`` or ``contributor``.
        include_automation: Also list automation keys, for file signatures only.
    """
    kinds = [({t for t in TIERS[:3] if RANK[t] <= RANK[min_tier]}, "git,file")]
    if include_automation:
        kinds.append(({"automation"}, "file"))
    lines = []
    for handle in sorted(result.people):
        # A key whose human tier ended can also be current automation: two
        # lines, each with its own namespaces and valid-before.
        for allowed, namespaces in kinds:
            until: Optional[datetime] = None
            if result.tiers.get(handle) not in allowed:
                ends = [
                    d for t, d in result.ended.get(handle, {}).items() if t in allowed
                ]
                if not ends:
                    continue
                until = max(ends)
            principals = ",".join((handle, *result.emails[handle]))
            for key in result.people[handle].keys:
                if key.did in result.revoked or (
                    until is not None and until <= key.added
                ):
                    continue
                options = (
                    f'namespaces="{namespaces}",valid-after="{_ssh_time(key.added)}"'
                )
                before = [d for d in (key.retired, until) if d is not None]
                if before:
                    end = min(*before, LAST_SECOND - END_SLACK) + END_SLACK
                    options += f',valid-before="{_ssh_time(end)}"'
                lines.append(f"{principals} {options} {key.ssh}\n")
            if until is None:
                break  # a current human tier covers "file" too
    return "".join(lines)


def revocation_list(result: CheckResult) -> str:
    """Return the revocation file for ``gpg.ssh.revocationFile``: one revoked key per line."""
    return "".join(f"{ssh}\n" for ssh in sorted(result.revoked.values()))


def _write_atomic(path: Path, text: str) -> None:
    # git may verify while we write; it must see the old file or the new, never half.
    f = tempfile.NamedTemporaryFile(
        "w", dir=path.parent, prefix=f".{path.name}.", delete=False
    )
    try:
        with f:
            f.write(text)
        os.replace(f.name, path)
    except BaseException:
        os.unlink(f.name)
        raise


def _output_path(given: Optional[str], option: str, config: str) -> Path:
    if given:
        return Path(given)
    try:
        value = run(["git", "config", "--get", "--type=path", config]).decode().strip()
    except VouchError as e:
        raise VouchError(f"no output file: pass {option} or set {config}") from e
    return Path(value)


def cmd_export(args: argparse.Namespace) -> int:
    """Check the registry, then write the allowed-signers file and the revocation file.

    Nothing is written if the check finds a problem.
    """
    signers = _output_path(
        args.allowed_signers, "--allowed-signers", "gpg.ssh.allowedSignersFile"
    )
    revocations = _output_path(
        args.revocation_file, "--revocation-file", "gpg.ssh.revocationFile"
    )
    root = _registry_dir(args.registry)
    _fetched(root)
    result = check_registry(root)
    _report(result)
    if result.problems:
        raise VouchError("the registry check failed; nothing exported")
    signer_lines = allowed_signers(result, args.min_tier, args.include_automation)
    # Revocations first, so no moment has new signers without their revocations.
    try:
        _write_atomic(revocations, revocation_list(result))
        _write_atomic(signers, signer_lines)
    except OSError as e:
        raise VouchError(f"cannot write the exported files: {e}") from e
    return 0


def _data_dir() -> Path:
    """Return git-vouch's own directory: $XDG_DATA_HOME/git-vouch, or ~/.local/share/git-vouch."""
    xdg = os.environ.get("XDG_DATA_HOME", "")
    base = Path(xdg) if os.path.isabs(xdg) else Path.home() / ".local" / "share"
    return base / "git-vouch"


def registry_copy() -> Path:
    """Return the local registry copy that ``sync`` keeps current."""
    return _data_dir() / "registry"


def _registry_dir(given: Optional[str]) -> Path:
    """Return the registry ``check`` and ``export`` read: ``given``, else the synced copy.

    Before ``setup`` has run there is no synced copy, so the default is
    the current directory.

    Raises:
        VouchError: setup has run but no sync has made the copy yet.
    """
    if given is not None:
        return Path(given)
    if _config("vouch.registry") is None:
        return Path(".")
    copy = registry_copy()
    if not (copy / ".git").is_dir():
        raise VouchError(f"no registry copy at {copy}: run git vouch sync, or pass DIR")
    return copy


def _config(name: str, kind: str = "") -> Optional[str]:
    """Return git config ``name`` from any scope, or None if it is unset.

    Args:
        name: The config key.
        kind: A ``git config --type`` such as ``bool`` or ``path``, or "".

    Raises:
        VouchError: git fails for any reason other than the key being unset.
    """
    cmd = ["git", "config", "--get", *([f"--type={kind}"] if kind else []), name]
    try:
        proc = subprocess.run(cmd, capture_output=True, check=False)
    except OSError as e:
        raise VouchError(f"cannot run git: {e}") from e
    if proc.returncode == 1:
        return None
    if proc.returncode != 0:
        err = proc.stderr.decode(errors="replace").strip()
        raise VouchError(f"git config --get {name} failed: {err}")
    return proc.stdout.decode().strip()


def _set_config(name: str, value: str) -> None:
    run(["git", "config", "--global", name, value])


def _fetched(root: Path) -> Optional[datetime]:
    """Return when ``sync`` last fetched into ``root``, warning if over 7 days ago.

    Only the copy ``sync`` keeps has a fetch time; for any other directory
    this returns None and warns about nothing.
    """
    # git rewrites FETCH_HEAD even when a fetch fails, so sync keeps its own stamp.
    # In a worktree .git is a file; every worktree shares the common dir.
    try:
        git_dir = run([*GIT, "rev-parse", "--git-common-dir"], cwd=root)
    except VouchError:
        return None  # not a repository, so not the copy sync keeps
    try:
        mtime = (root / git_dir.decode().strip() / "vouch-fetched").stat().st_mtime
    except FileNotFoundError:
        return None
    when = datetime.fromtimestamp(mtime, timezone.utc)
    age = datetime.now(timezone.utc) - when
    if age > STALE_AFTER:
        print(
            f"git-vouch: warning: the registry copy was last fetched {age.days} days"
            " ago; run git vouch sync",
            file=sys.stderr,
        )
    return when


def _fetch(url: str, copy: Path) -> None:
    """Fetch the registry at ``url`` into ``copy`` and check out what was fetched.

    The refspec has no '+', so git refuses any fetch that is not a
    fast-forward of the last one from the same URL: a rewritten history
    is never accepted. A different URL is a different registry, so its
    first fetch starts a fresh history.

    Raises:
        VouchError: The fetch fails or is refused, or the checkout fails.
    """
    git_dir = copy / ".git"
    if not git_dir.is_dir():
        copy.mkdir(parents=True, exist_ok=True)
        run([*GIT, "init", "-q"], cwd=copy)
    # Overrides the registry's own .gitattributes, so the working tree holds
    # the committed bytes: no eol, ident or filter rewriting.
    (git_dir / "info").mkdir(exist_ok=True)
    (git_dir / "info" / "attributes").write_text(
        "* -text -ident -filter -diff -merge -working-tree-encoding\n"
    )
    url_file = git_dir / "vouch-url"
    if url_file.is_file() and url_file.read_text() != url:
        print(
            "git-vouch: the registry URL changed; starting a fresh history",
            file=sys.stderr,
        )
        run([*GIT, "update-ref", "-d", FETCHED_REF], cwd=copy)
    try:
        run(
            [*GIT, "fetch", "--no-tags"],
            values=[url, f"HEAD:{FETCHED_REF}"],
            cwd=copy,
        )
    except VouchError as e:
        raise VouchError(
            f"cannot fetch the registry; a rewritten history is refused: {e}"
        ) from e
    url_file.write_text(url)
    run([*GIT, "checkout", "-q", "--force", "--detach", FETCHED_REF], cwd=copy)
    (git_dir / "vouch-fetched").touch()


def cmd_sync(args: argparse.Namespace) -> int:
    """Fetch the registry without a rewind, check it, and re-export with the saved choices.

    Any ``--min-tier`` or ``--include-automation`` given is saved to git
    config first. The revocation file is written even if the check fails,
    so a revocation always spreads; the allowed-signers file only if it
    passes.
    """
    url = _config("vouch.registry")
    if url is None:
        raise VouchError("no registry configured: run git vouch setup")
    if args.min_tier is not None:
        _set_config("vouch.minTier", args.min_tier)
    if args.include_automation is not None:
        _set_config("vouch.includeAutomation", str(args.include_automation).lower())
    min_tier = _config("vouch.minTier") or "contributor"
    if min_tier not in TIERS[:3]:
        raise VouchError(f"git config vouch.minTier: {min_tier!r} is not a tier")
    include_automation = _config("vouch.includeAutomation", "bool") == "true"
    paths = []
    for name in ("gpg.ssh.revocationFile", "gpg.ssh.allowedSignersFile"):
        value = _config(name, "path")
        if not value:
            raise VouchError(f"{name} is not set: run git vouch setup")
        paths.append(Path(value))
    revocations, signers = paths
    copy = registry_copy()
    _fetch(url, copy)
    result = check_registry(copy)
    _report(result)
    try:
        _write_atomic(revocations, revocation_list(result))
        if not result.problems:
            _write_atomic(
                signers, allowed_signers(result, min_tier, include_automation)
            )
    except OSError as e:
        raise VouchError(f"cannot write the exported files: {e}") from e
    if result.problems:
        raise VouchError(
            "the registry check failed; only the revocation file was written"
        )
    return 0


def cmd_setup(args: argparse.Namespace) -> int:
    """Record the registry and git's SSH signing config globally, then sync.

    Without ``--registry``, a registry already configured is kept, and the
    kernel's is the default.
    """
    url = args.registry or _config("vouch.registry") or DEFAULT_REGISTRY
    data = _data_dir()
    try:
        data.mkdir(parents=True, exist_ok=True)
    except OSError as e:
        raise VouchError(f"cannot create {data}: {e}") from e
    _set_config("vouch.registry", url)
    _set_config("gpg.format", "ssh")
    _set_config("gpg.ssh.allowedSignersFile", str(data / "allowed_signers"))
    _set_config("gpg.ssh.revocationFile", str(data / "revoked_keys"))
    return cmd_sync(args)


def patatt_selector(ssh: str) -> str:
    """Return the patatt selector for an SSH key "type base64": ``k-`` and a fingerprint prefix.

    The prefix is the first 16 lowercase hex digits of the SHA-256 of the
    key blob, the hash ``ssh-keygen -l`` shows in base64. Hex, because
    patatt lowercases selectors in file keyrings (DESIGN.md, Patch signing).
    """
    blob = base64.b64decode(ssh.split()[1])
    return "k-" + hashlib.sha256(blob).hexdigest()[:16]


def _own_tier(result: CheckResult, key: SigningKey) -> str:
    """Return who ``key`` belongs to in ``result``, and their tier."""
    owners = [
        h
        for h, p in sorted(result.people.items())
        if any(k.did == key.did and k.retired is None for k in p.keys)
    ]
    if not owners:
        return f"{key.did} is not a current key in any valid person file"
    revoked = " (this key is revoked)" if key.did in result.revoked else ""
    return ", ".join(f"{h} {result.tiers.get(h, 'none')}" for h in owners) + revoked


def cmd_status(args: argparse.Namespace) -> int:
    """Print the registry URL, commit and fetch time, and the user's tier and patatt selector."""
    url = _config("vouch.registry")
    copy = registry_copy()
    if url is None or not (copy / ".git").is_dir():
        raise VouchError("no registry copy: run git vouch setup")
    commit = run([*GIT_LOG, "log", "-1", "--format=%H %cI", "HEAD"], cwd=copy)
    fetched = _fetched(copy)
    result = check_registry(copy)
    print(f"registry: {url}")
    print(f"commit: {commit.decode().strip()}")
    if fetched is None:
        print("fetched: unknown")
    else:
        age = datetime.now(timezone.utc) - fetched
        print(f"fetched: {fetched.strftime(DATE_FORMAT)} ({age.days} days ago)")
    errors = len(result.problems)
    summary = f"{errors} errors (run git vouch check {copy})" if errors else "ok"
    print(f"check: {summary}")
    try:
        key = _signing_key(None)
    except VouchError as e:
        print(f"you: unknown: {e}")
        return 0
    print(f"you: {_own_tier(result, key)}")
    print(f"patatt.selector: {patatt_selector(key.ssh)}")
    return 0


def cmd_did(args: argparse.Namespace) -> int:
    """Print the did:key for a .pub file or key line, or the plain key line for a did:key."""
    key: str = args.key
    print(did_to_ssh(key) if key.startswith("did:") else _key_did(key))
    return 0


def _rfc3339(text: str) -> datetime:
    """Parse ``--at``: an RFC 3339 time with ``Z`` or a numeric offset."""
    # ponytail: Python 3.9's fromisoformat takes only 3 or 6 fraction digits
    # and some non-RFC forms; a hand parser is the upgrade if anyone needs more.
    try:
        when = datetime.fromisoformat(re.sub("[Zz]$", "+00:00", text))
        if when.tzinfo is not None:
            return when.astimezone(timezone.utc)
    except (ValueError, OverflowError):  # Overflow: the offset leaves year 1-9999
        pass
    raise argparse.ArgumentTypeError(
        f"not an RFC 3339 time like 2026-11-05T00:00:00Z: {text!r:.60}"
    )


def cmd_query(args: argparse.Namespace) -> int:
    """Print as JSON who holds a did:key, their tier and the key's validity at a time.

    The time is ``--at``, else now. The tier, ``automation`` (true for a
    bot's key) and emails are those held then, from the registry's git
    history (see ``check_registry``). A key is valid from ``added`` until
    ``retired``; a revoked key is never valid. The exit status is 1, with
    ``handle`` null, if no valid person file lists the key, or if its
    person had no person file then.

    Raises:
        VouchError: the registry check fails, so nothing is printed.
    """
    when: datetime = args.at or datetime.now(timezone.utc)
    root = _registry_dir(None)
    _fetched(root)
    result = check_registry(root)
    if result.problems:
        raise VouchError(f"the registry check failed; run git vouch check {root}")
    did: str = args.did
    answer: dict[str, object] = {
        "did": did,
        "at": when.strftime(DATE_FORMAT),
        "handle": None,
        "tier": None,
        "automation": False,
        "emails": [],
        "added": None,
        "retired": None,
        "revoked": did in result.revoked,
        "valid": False,
    }
    # check fails on a key current in two files; a key retired in two is
    # equally valid in both, so the first is as good as any.
    found = [
        (person, key)
        for _, person in sorted(result.people.items())
        for key in person.keys
        if key.did == did
    ]
    held = result.held_at(found[0][0].handle, args.at) if found else None
    if held is not None:
        person, key = found[0]
        answer.update(
            handle=person.handle,
            tier=held.tier,
            automation=held.automation,
            emails=list(held.emails),
            added=key.added.strftime(DATE_FORMAT),
            retired=key.retired and key.retired.strftime(DATE_FORMAT),
            valid=key_valid(key, when, result.revoked),
        )
    print(json.dumps(answer, indent=2))
    return 0 if held is not None else 1


def key_valid(key: PersonKey, when: datetime, revoked: Collection[str]) -> bool:
    """Return whether ``key`` is valid at ``when``: added, not retired, not revoked.

    Whole seconds, both ends included, as check and OpenSSH judge.
    """
    return (
        key.did not in revoked
        and key.added <= when
        and (key.retired is None or when.replace(microsecond=0) <= key.retired)
    )


def cmd_keys(args: argparse.Namespace) -> int:
    """Print "<selector> <type> <base64>" for each current key of the person with an endorsed email.

    The email matches ignoring case. Any tier counts, automation included.
    A current key is valid now, as ``query`` judges it: added, not retired,
    not revoked. The exit status is 1, printing nothing, if no person has
    the email endorsed.

    Only the copy ``sync`` keeps is read, never the current directory:
    patatt runs this wherever b4 does, often in a tree someone else wrote.

    Raises:
        VouchError: no registry is configured or synced, or the registry
            check fails, so nothing is printed.
    """
    if _config("vouch.registry") is None:
        raise VouchError("no registry configured: run git vouch setup")
    root = _registry_dir(None)
    _fetched(root)
    result = check_registry(root)
    if result.problems:
        raise VouchError(f"the registry check failed; run git vouch check {root}")
    email = args.email.lower()
    # check fails on an email listed in two person files, so one handle at most.
    handles = [h for h, ms in result.emails.items() if email in (m.lower() for m in ms)]
    if not handles:
        return 1
    now = datetime.now(timezone.utc)
    for key in result.people[handles[0]].keys:
        if key_valid(key, now, result.revoked):
            print(f"{patatt_selector(key.ssh)} {key.ssh}")
    return 0


class SigningKey(NamedTuple):
    """The key a signing command signs with."""

    path: Optional[str]  # for ssh-keygen -f; None signs through the agent by ``ssh``
    ssh: str  # "type base64"
    did: str


def _now() -> str:
    return datetime.now(timezone.utc).strftime(DATE_FORMAT)


def _read_local(path: str, what: str) -> bytes:
    """Return the bytes of the user's own file ``path``, at most MAX_FILE_SIZE.

    Raises:
        VouchError: The file cannot be read or is too large.
    """
    try:
        with open(path, "rb") as f:
            data = f.read(MAX_FILE_SIZE + 1)
    except OSError as e:
        raise VouchError(f"{what} {path}: cannot read: {e.strerror}") from e
    if len(data) > MAX_FILE_SIZE:
        raise VouchError(f"{what} {path}: larger than {MAX_FILE_SIZE} bytes")
    return data


def _pubkey_file(path: str) -> str:
    """Return the public key line in the file ``path`` as "type base64", comment dropped.

    Raises:
        VouchError: The file cannot be read or holds no supported public key.
    """
    line = " ".join(
        _read_local(path, "public key").decode(errors="replace").split()[:2]
    )
    try:
        ssh_to_did(line)
    except VouchError as e:
        raise VouchError(f"public key {path}: {e}") from e
    return line


def _key_did(arg: str) -> str:
    """Return the did:key named by ``arg``: a did:key, a public key file, or a key line.

    Raises:
        VouchError: ``arg`` names no supported key.
    """
    if arg.startswith("did:"):
        return ssh_to_did(did_to_ssh(arg))  # canonical form, as check compares
    if Path(arg).is_file():
        return ssh_to_did(_pubkey_file(arg))
    return ssh_to_did(arg)


def _signing_key(spec: Optional[str]) -> SigningKey:
    """Return the key ``spec`` names, or git's ``user.signingKey`` if ``spec`` is None.

    A private key file's public half is read from FILE.pub, as ssh-keygen
    does. A .pub file, or git's "key::" or bare "ssh-" form, signs through
    the SSH agent.

    Raises:
        VouchError: No key is named, or its public key cannot be read.
    """
    if spec is None:
        try:
            config = run(["git", "config", "--get", "--type=path", "user.signingKey"])
            spec = config.decode().strip()
        except VouchError as e:
            raise VouchError(
                "no signing key: pass --sign-with or set git config user.signingKey"
            ) from e
    if spec.startswith(("key::", "ssh-")):
        # git reads a bare "ssh-..." value as "key::ssh-..." for compatibility.
        ssh = " ".join(spec.removeprefix("key::").split()[:2])
        return SigningKey(None, ssh, ssh_to_did(ssh))
    ssh = _pubkey_file(spec if spec.endswith(".pub") else spec + ".pub")
    return SigningKey(spec, ssh, ssh_to_did(ssh))


def _sign(key: SigningKey, namespace: str, data: bytes) -> bytes:
    """Return an ``ssh-keygen -Y sign`` signature by ``key`` over ``data``.

    ssh-keygen runs with no terminal, no stdin and no askpass, so a key that
    needs a passphrase fails instead of prompting.

    Raises:
        VouchError: ssh-keygen fails, or the signature is not by ``key``.
    """
    with tempfile.TemporaryDirectory() as tmp:
        msg = Path(tmp, "msg")
        msg.write_bytes(data)
        path = key.path
        if path is None:
            path = str(Path(tmp, "key.pub"))
            Path(path).write_text(key.ssh + "\n")
        cmd = ["ssh-keygen", "-q", "-Y", "sign", "-f", path, "-n", namespace, str(msg)]
        try:
            proc = subprocess.run(
                cmd,
                stdin=subprocess.DEVNULL,
                capture_output=True,
                check=False,
                start_new_session=True,
                env={**os.environ, "SSH_ASKPASS_REQUIRE": "never"},
            )
        except OSError as e:
            raise VouchError(f"cannot run ssh-keygen: {e}") from e
        if proc.returncode != 0:
            err = proc.stderr.decode(errors="replace").strip()
            raise VouchError(f"ssh-keygen could not sign with {path}: {err}")
        sig = Path(tmp, "msg.sig").read_bytes()
    signer = PersonKey(key.ssh, key.did, datetime.now(timezone.utc), None)
    if not _verifies(data, sig, namespace, signer):
        raise VouchError(f"{key.path}: the signature is not by {key.did}")
    return sig


def _record_bytes(rel: str, obj: Mapping[str, object]) -> tuple[bytes, Record]:
    """Return a record's file bytes and its parsed form, checked as ``check`` would.

    Raises:
        VouchError: The record is invalid or too large.
    """
    data = (json.dumps(obj, indent=2, ensure_ascii=False) + "\n").encode()
    if len(data) > MAX_FILE_SIZE:
        raise VouchError(f"{rel}: larger than {MAX_FILE_SIZE} bytes")
    return data, parse_record(rel, data)


def _write_signed(rel: str, data: bytes, key: SigningKey) -> None:
    """Sign ``data`` in its kind's namespace and write ``rel`` and ``rel.sig``.

    Raises:
        VouchError: Signing or writing fails.
    """
    sig = _sign(key, NAMESPACES[rel.split("/")[0]], data)
    # The checkout is untrusted: like read_capped, follow no symlink in it.
    *dirs, name = rel.split("/")
    try:
        fd = os.open(".", os.O_RDONLY | os.O_DIRECTORY)
        try:
            for part in dirs:
                try:
                    os.mkdir(part, dir_fd=fd)
                except FileExistsError:
                    pass
                parent = fd
                fd = os.open(
                    part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent
                )
                os.close(parent)
            _replace_at(fd, name, data)
            _replace_at(fd, name + ".sig", sig)
        finally:
            os.close(fd)
    except OSError as e:
        raise VouchError(f"cannot write {rel}: {e}") from e
    print(rel)
    print(rel + ".sig")


def _replace_at(dir_fd: int, name: str, data: bytes) -> None:
    # rename replaces a symlink at ``name`` instead of writing through it.
    tmp = f".{name}.{os.urandom(6).hex()}"
    fd = os.open(
        tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o666, dir_fd=dir_fd
    )
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.replace(tmp, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
    except BaseException:
        os.unlink(tmp, dir_fd=dir_fd)
        raise


def _people_listing(root: Path, did: str, current: bool) -> list[tuple[Person, bytes]]:
    """Return every valid person file listing ``did``, only as a current key if ``current``."""
    found = []
    for name in list_dir(root, "people"):
        if not name.endswith(".json"):
            continue
        rel = f"people/{name}"
        try:
            data = read_capped(root, rel)
            person = parse_record(rel, data)
        except VouchError:
            continue  # check reports it
        if isinstance(person, Person) and any(
            k.did == did and (k.retired is None or not current) for k in person.keys
        ):
            found.append((person, data))
    return found


def _signer_file(root: Path, key: SigningKey) -> tuple[Person, bytes]:
    """Return the person file that lists ``key`` as a current key, and its bytes.

    Raises:
        VouchError: No person file, or more than one, lists it as current.
    """
    found = _people_listing(root, key.did, current=True)
    if len(found) != 1:
        which = ", ".join(p.handle for p, _ in found) or "no person file"
        raise VouchError(f"{key.did} is a current key of {which}; need exactly one")
    return found[0]


def _load_person(root: Path, handle: str) -> Person:
    rel = f"people/{validate_handle(handle)}.json"
    person = parse_record(rel, read_capped(root, rel))
    assert isinstance(person, Person)  # the path decides the kind
    return person


def _next_seq(root: Path, directory: str, prefix: str) -> int:
    """Return the next free n for ``<directory>/<prefix>-<n>.json``."""
    taken = [0]
    for name in list_dir(root, directory):
        m = SEQ_RE.fullmatch(name[: -len(".json")])
        if name.endswith(".json") and m and m.group(1) == prefix:
            taken.append(int(m.group(2)))
    return max(taken) + 1


def _new_key(
    pub: str, attestation: Optional[str], challenge: Optional[str]
) -> dict[str, object]:
    """Return a person file ``keys`` entry for the public key file ``pub``, added now.

    Raises:
        VouchError: A file cannot be read, or only one of ``attestation``
            and ``challenge`` is given.
    """
    if (attestation is None) != (challenge is None):
        raise VouchError("--attestation and --challenge go together")
    entry: dict[str, object] = {
        "ssh": _pubkey_file(pub),
        "added": _now(),
        "retired": None,
    }
    if attestation is not None and challenge is not None:
        entry["attestation"] = {
            "blob": base64.b64encode(_read_local(attestation, "attestation")).decode(),
            "challenge": base64.b64encode(_read_local(challenge, "challenge")).decode(),
        }
    return entry


def cmd_register(args: argparse.Namespace) -> int:
    """Write and sign a new person file, from options or by completing a draft.

    The first version must be signed by one of its own keys: by default the
    key being registered.
    """
    if args.from_file:
        if args.handle or args.name or args.email or args.accountable:
            raise VouchError(
                "--handle, --name, --email and --accountable come from the draft"
            )
        obj = _load_json(_read_local(args.from_file, "draft"))
        if not isinstance(obj, dict) or not isinstance(
            obj.setdefault("keys", []), list
        ):
            raise VouchError(f"{args.from_file}: not a person file draft")
    elif args.handle and args.name and args.email:
        obj = {
            "@context": [CONTEXT],
            "handle": args.handle,
            "name": args.name,
            "emails": args.email,
            "keys": [],
            "accountable": args.accountable,
        }
    else:
        raise VouchError("pass --handle, --name and --email, or --from a draft")
    if args.pubkey:
        obj["keys"].append(_new_key(args.pubkey, args.attestation, args.challenge))
    elif args.attestation or args.challenge:
        raise VouchError("--attestation and --challenge need the key they belong to")
    rel = f"people/{validate_handle(obj.get('handle'))}.json"
    is_in_place = (
        args.from_file and Path(args.from_file).resolve() == Path(rel).resolve()
    )
    if os.path.lexists(rel) and not is_in_place:
        raise VouchError(f"{rel} already exists; use add-key to change it")
    data, person = _record_bytes(rel, obj)
    key = _signing_key(args.sign_with or args.pubkey)
    assert isinstance(person, Person)
    if not any(k.did == key.did and k.retired is None for k in person.keys):
        raise VouchError(f"{rel}: {key.did} is not one of its current keys")
    _write_signed(rel, data, key)
    return 0


def _edit_own(
    args: argparse.Namespace,
) -> tuple[str, dict[str, object], Person, SigningKey]:
    """Return the signer's person file path, its JSON, its parsed form, and the key."""
    key = _signing_key(args.sign_with)
    person, data = _signer_file(Path("."), key)
    obj = _load_json(data)
    assert isinstance(obj, dict)  # parse_record accepted it
    return f"people/{person.handle}.json", obj, person, key


def cmd_add_key(args: argparse.Namespace) -> int:
    """Add a key to the signer's person file and re-sign it with the signer's current key."""
    rel, obj, person, key = _edit_own(args)
    entry = _new_key(args.pubkey, args.attestation, args.challenge)
    if ssh_to_did(str(entry["ssh"])) in {k.did for k in person.keys}:
        raise VouchError(f"{rel}: already lists {args.pubkey}")
    keys = obj["keys"]
    assert isinstance(keys, list)  # parse_record accepted it
    keys.append(entry)
    _write_signed(rel, _record_bytes(rel, obj)[0], key)
    return 0


def cmd_retire_key(args: argparse.Namespace) -> int:
    """Set ``retired`` to now on one of the signer's keys and re-sign the person file."""
    rel, obj, person, key = _edit_own(args)
    did = _key_did(args.key)
    entries = obj["keys"]
    assert isinstance(entries, list)  # parse_record accepted it
    for entry, listed in zip(entries, person.keys):
        if listed.did == did:
            if listed.retired is not None:
                raise VouchError(f"{rel}: {did} is already retired")
            entry["retired"] = _now()
            break
    else:
        raise VouchError(f"{rel}: {did} is not one of its keys")
    _write_signed(rel, _record_bytes(rel, obj)[0], key)
    return 0


def _endorse_draft(args: argparse.Namespace) -> int:
    """Sign an endorsement draft, such as one from ``git-vouch-migrate drafts``.

    The draft's ``endorserKey`` must be the signing key and its ``endorser``
    the handle of the person file that lists that key as current. The
    draft's bytes are signed unchanged, so what the endorser read is what
    they sign.

    Raises:
        VouchError: The draft is invalid, names another endorser or key,
            or endorses its own endorser.
    """
    if args.handle or args.email or args.note is not None:
        raise VouchError("the handle, --email and --note come from the draft")
    data = _read_local(args.from_file, "draft")
    obj = _load_json(data)
    if not isinstance(obj, dict):
        raise VouchError(f"{args.from_file}: not an endorsement draft")
    root = Path(".")
    key = _signing_key(args.sign_with)
    if obj.get("endorserKey") != key.did:
        raise VouchError(f"{args.from_file}: endorserKey is not {key.did}")
    endorser = _signer_file(root, key)[0].handle
    if obj.get("endorser") != endorser:
        raise VouchError(f"{args.from_file}: endorser is not {endorser}")
    subject = validate_handle(obj.get("subject"))
    if subject == endorser:
        raise VouchError("nobody can endorse themselves")
    d = f"endorsements/{subject}"
    rel = f"{d}/{endorser}-{_next_seq(root, d, endorser)}.json"
    parse_record(rel, data)
    _write_signed(rel, data, key)
    return 0


def cmd_endorse(args: argparse.Namespace) -> int:
    """Write and sign an endorsement of ``handle``'s name, first current key and emails."""
    if args.from_file:
        return _endorse_draft(args)
    if not args.handle:
        raise VouchError("pass a handle, or --from a draft")
    root = Path(".")
    subject = _load_person(root, args.handle)
    key = _signing_key(args.sign_with)
    endorser = _signer_file(root, key)[0].handle
    if endorser == subject.handle:
        raise VouchError("nobody can endorse themselves")
    current = [k for k in subject.keys if k.retired is None]
    if not current:
        raise VouchError(f"people/{subject.handle}.json: no current key")
    emails = args.email or list(subject.emails)
    listed = {m.lower() for m in subject.emails}
    for email in emails:
        if email.lower() not in listed:
            raise VouchError(f"people/{subject.handle}.json does not list {email}")
    d = f"endorsements/{subject.handle}"
    rel = f"{d}/{endorser}-{_next_seq(root, d, endorser)}.json"
    obj: dict[str, object] = {
        "@context": [CONTEXT],
        "endorser": endorser,
        "endorserKey": key.did,
        "subject": subject.handle,
        "subjectKey": current[0].did,
        "subjectName": subject.name,
        "subjectEmails": emails,
    }
    if args.note is not None:
        obj["note"] = args.note
    obj["date"] = _now()
    _write_signed(rel, _record_bytes(rel, obj)[0], key)
    return 0


def cmd_approve(args: argparse.Namespace) -> int:
    """Write and sign ``handle``'s tier record, replacing any earlier one."""
    root = Path(".")
    subject = _load_person(root, args.handle)
    key = _signing_key(args.sign_with)
    approver = _signer_file(root, key)[0].handle
    if approver == subject.handle:
        raise VouchError("nobody can approve themselves")
    rel = f"tiers/{subject.handle}.json"
    obj = {
        "@context": [CONTEXT],
        "subject": subject.handle,
        "tier": args.tier,
        "approver": approver,
        "approverKey": key.did,
        "date": _now(),
    }
    _write_signed(rel, _record_bytes(rel, obj)[0], key)
    return 0


def cmd_revoke(args: argparse.Namespace) -> int:
    """Write and sign a revocation of a key; check judges whether the signer may revoke it."""
    root = Path(".")
    did = _key_did(args.key)
    found = [p for p, _ in _people_listing(root, did, current=False)]
    if args.subject:
        found = [p for p in found if p.handle == args.subject]
    if len(found) != 1:
        which = ", ".join(p.handle for p in found) or "no person file"
        raise VouchError(f"{did} is listed by {which}; name one with --subject")
    subject = found[0].handle
    key = _signing_key(args.sign_with)
    rel = f"revocations/{subject}-{_next_seq(root, 'revocations', subject)}.json"
    obj = {
        "@context": [CONTEXT],
        "subject": subject,
        "key": did,
        "reason": args.reason,
        "date": _now(),
    }
    _write_signed(rel, _record_bytes(rel, obj)[0], key)
    return 0


def _not_implemented(args: argparse.Namespace) -> int:
    raise VouchError(f"'{args.command}' is not implemented yet")


def build_parser() -> argparse.ArgumentParser:
    """Return the argument parser with one subcommand per DESIGN.md command."""
    parser = argparse.ArgumentParser(prog="git vouch", description=__doc__)
    sub = parser.add_subparsers(dest="command", metavar="<command>", required=True)

    def add(name: str, help_text: str) -> argparse.ArgumentParser:
        p = sub.add_parser(name, help=help_text, description=help_text)
        p.set_defaults(func=_not_implemented)
        return p

    def export_choices(p: argparse.ArgumentParser) -> None:
        p.add_argument(
            "--min-tier",
            choices=TIERS[:3],
            help="lowest tier exported, saved for later syncs (default: contributor)",
        )
        p.add_argument(
            "--include-automation",
            action=argparse.BooleanOptionalAction,
            help='also export automation keys, with namespaces="file"; saved',
        )

    p = add("setup", "record the registry URL, configure git for SSH signing, and sync")
    p.add_argument(
        "--registry",
        metavar="URL",
        help="registry repository URL (default: the one configured, else the kernel's)",
    )
    export_choices(p)
    p.set_defaults(func=cmd_setup)
    p = add(
        "sync", "fetch the registry without allowing a rewind, check it, and re-export"
    )
    export_choices(p)
    p.set_defaults(func=cmd_sync)
    p = add("status", "show the registry commit, its fetch age, and your own tier")
    p.set_defaults(func=cmd_status)

    def signing(name: str, help_text: str) -> argparse.ArgumentParser:
        p = add(name, help_text + " in the registry checkout in the current directory")
        p.add_argument(
            "--sign-with",
            metavar="FILE",
            help="private key file, or .pub to sign through the agent"
            " (default: git config user.signingKey)",
        )
        return p

    def attestation(p: argparse.ArgumentParser) -> None:
        p.add_argument(
            "--attestation",
            metavar="FILE",
            help="ssh-keygen -O write-attestation output",
        )
        p.add_argument(
            "--challenge", metavar="FILE", help="the -O challenge file it was made with"
        )

    p = signing("register", "write your person file and sign it")
    p.add_argument("pubkey", nargs="?", metavar="PUBKEY", help="your .pub file")
    p.add_argument(
        "--from", dest="from_file", metavar="FILE", help="complete this draft"
    )
    p.add_argument("--handle")
    p.add_argument("--name")
    p.add_argument("--email", action="append", help="repeat for more addresses")
    p.add_argument(
        "--accountable", metavar="HANDLE", help="automation: your maintainer"
    )
    attestation(p)
    p.set_defaults(func=cmd_register)
    p = signing("add-key", "add a key to your person file and re-sign it")
    p.add_argument("pubkey", metavar="PUBKEY", help="the new key's .pub file")
    attestation(p)
    p.set_defaults(func=cmd_add_key)
    p = signing("retire-key", "retire a key in your person file and re-sign it")
    p.add_argument("key", metavar="KEY", help=".pub file, key text or did:key")
    p.set_defaults(func=cmd_retire_key)
    p = signing("endorse", "write and sign an endorsement")
    p.add_argument("handle", nargs="?")
    p.add_argument(
        "--from",
        dest="from_file",
        metavar="FILE",
        help="sign this draft, such as one from git-vouch-migrate drafts",
    )
    p.add_argument(
        "--email", action="append", help="endorse only this address (repeatable)"
    )
    p.add_argument("--note", help="how you know them")
    p.set_defaults(func=cmd_endorse)
    p = signing("approve", "write and sign a tier record")
    p.add_argument("handle")
    p.add_argument("tier", choices=TIERS[1:])  # anchors come from anchors.json
    p.set_defaults(func=cmd_approve)
    p = signing("revoke", "write and sign a revocation")
    p.add_argument("key", metavar="KEY", help=".pub file, key text or did:key")
    p.add_argument(
        "--subject", metavar="HANDLE", help="whose key, if two files list it"
    )
    p.add_argument("--reason", default="compromise", help="default: compromise")
    p.set_defaults(func=cmd_revoke)
    p = add("check", "validate every signature and compute every tier")
    p.add_argument(
        "registry",
        nargs="?",
        metavar="DIR",
        help="registry checkout (default: the synced copy once setup has run,"
        " else the current directory; pass . to check a checkout)",
    )
    p.set_defaults(func=cmd_check)
    p = add("export", "write the allowed-signers file and the revocation file")
    p.add_argument(
        "registry",
        nargs="?",
        metavar="DIR",
        help="registry checkout (default: the synced copy once setup has run,"
        " else the current directory)",
    )
    p.add_argument(
        "--min-tier",
        choices=TIERS[:3],
        default="contributor",
        help="lowest tier exported (default: contributor)",
    )
    p.add_argument(
        "--include-automation",
        action="store_true",
        help='also export automation keys, with namespaces="file"',
    )
    p.add_argument(
        "--allowed-signers",
        metavar="FILE",
        help="output file (default: git config gpg.ssh.allowedSignersFile)",
    )
    p.add_argument(
        "--revocation-file",
        metavar="FILE",
        help="output file (default: git config gpg.ssh.revocationFile)",
    )
    p.set_defaults(func=cmd_export)
    p = add("did", "print the did:key for an SSH public key, or the reverse")
    p.add_argument("key", metavar="<.pub file | ssh-pubkey | did:key>")
    p.set_defaults(func=cmd_did)
    p = add("query", "print a did:key's holder, tier and validity as JSON")
    p.add_argument("did", metavar="<did:key>")
    p.add_argument(
        "--at",
        type=_rfc3339,
        metavar="TIME",
        help="RFC 3339 time to answer for (default: now)",
    )
    p.set_defaults(func=cmd_query)
    p = add(
        "keys", "print an endorsed email's current keys with their patatt selectors"
    )
    p.add_argument("email", metavar="<email>")
    p.set_defaults(func=cmd_keys)
    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    """Run the command line and return the process exit status."""
    args = build_parser().parse_args(argv)
    try:
        status: int = args.func(args)
        return status
    except VouchError as e:
        print(f"git-vouch: error: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
