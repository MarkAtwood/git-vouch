#!/usr/bin/env python3
"""git-vouch-migrate: port the frozen pgpkeys.git into git-vouch person-file drafts.

Flag day only, and the only git-vouch tool that runs gpg. It reads
pgpkeys.git at one signed commit, the freeze commit, after checking its
signature, and writes unsigned drafts that holders complete with
``git vouch register --from``, verifies registered people's continuity
proofs against the freeze commit, and writes each certifier's unsigned
endorsement drafts from their GPG certifications. Person-file checks are
git-vouch's own, imported from the git-vouch script. See DESIGN.md, Flag day.
"""

from __future__ import annotations

import argparse
import base64
import contextlib
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from collections.abc import Collection, Iterator, Mapping, Sequence
from datetime import datetime, timezone
from pathlib import Path
from types import ModuleType
from typing import NamedTuple, Optional


def _load_vouch() -> ModuleType:
    """Return the git-vouch script next to this one (or else on PATH), loaded as a module."""
    # ponytail: a ModuleType, so every vouch.* use is Any to a type checker
    # and a rename in git-vouch breaks migrate only at run time (the tests
    # catch it). Upgrade path: ship git-vouch as an importable module too.
    path = Path(__file__).resolve().with_name("git-vouch")
    if not path.is_file():
        found = shutil.which("git-vouch")
        if found is None:
            sys.exit(
                "git-vouch-migrate: error: git-vouch not found beside it or on PATH"
            )
        path = Path(found)
    loader = importlib.machinery.SourceFileLoader("git_vouch", str(path))
    spec = importlib.util.spec_from_loader("git_vouch", loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.dont_write_bytecode = True  # no git-vouch.cpython-*.pyc beside the script
    loader.exec_module(module)
    return module


vouch = _load_vouch()
VouchError = vouch.VouchError

FPR_RE = re.compile(r"[0-9A-F]{40}")
# gpg status words that say why a detached signature did not verify.
GPG_FAILURES = ("NO_PUBKEY", "BADSIG", "REVKEYSIG", "EXPSIG", "ERRSIG")
# Auth subkey curves whose `gpg --export-ssh-key` output git-vouch accepts;
# RSA (algorithm 1) is accepted in git-vouch's size range.
REUSABLE_CURVES = ("ed25519", "nistp256")
# gpg validity letters for keys not live at the freeze commit. A primary
# key is skipped only if revoked or invalid: an expired one is still
# continuity proof (D9).
NOT_LIVE = {
    "e": "expired at the freeze commit",
    "r": "revoked",
    "i": "invalid at the freeze commit",
}
SKIPPED = {"r": "revoked", "i": "invalid at the freeze commit"}
UID_RE = re.compile(r"(.*?)\s*(?:\([^()]*\))?\s*<([^<>]*)>")
NAME_ONLY_RE = re.compile(r"([^<>@]*?)\s*(?:\([^()]*\))?")
# kernel.org remail and security lists: "Flippant Fireant <flippant-fireant@kernel.org>".
ROLE_RE = re.compile(r"([A-Za-z]+) ([A-Za-z]+) <([a-z]+)-([a-z]+)@kernel\.org>")
# Stands in for the key the holder adds, so a keyless draft can be checked;
# never written to a draft. RFC 8032 section 7.1 TEST 1's public key: a valid
# point, since check refuses small-order ones such as 32 zero bytes.
PLACEHOLDER_KEY = (
    "ssh-ed25519 "
    + base64.b64encode(
        b"\0\0\0\x0bssh-ed25519\0\0\0\x20"
        + bytes.fromhex(
            "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
        )
    ).decode()
)


class GpgKey(NamedTuple):
    """One primary key from the pgpkeys keyring, as gpg lists it then."""

    fpr: str
    created: int
    validity: str
    uids: tuple[str, ...]  # unrevoked user IDs, primary first
    auth: tuple[str, ...]  # live auth keys git-vouch accepts, primary first


class Proof(NamedTuple):
    """A verified continuity proof: the GPG key claimed and how its holder proved it."""

    fpr: str
    how: str  # ".asc", or "auth subkey <fpr>"


class Continuity(NamedTuple):
    """What ``verify_continuity`` found."""

    proven: dict[str, Proof]  # handle -> proof
    failed: dict[str, str]  # handle -> why its claim is not proven
    duplicates: dict[str, list[str]]  # fingerprint -> every handle claiming it
    check: vouch.CheckResult  # git-vouch's own check of the registry


class Certification(NamedTuple):
    """One user ID certification, as gpg verified it at the freeze commit."""

    uid: str
    time: int


class Imported(NamedTuple):
    """What gpg took from one keys/ file."""

    failed: bool  # gpg exited non-zero: a retry may apply what it refused
    taken: tuple[str, ...]  # fingerprints of the keys gpg imported or merged
    why: Optional[str]  # why gpg did not take all of the file, or None


class Draft(NamedTuple):
    """One person's draft and the key it was made from."""

    handle: str
    key: GpgKey
    data: bytes


def _unescape(field: bytes) -> str:
    r"""Return a gpg colon-listing field as text: undo ``\xNN`` escapes and decode.

    User IDs should be UTF-8, but pgpkeys has one in Latin-1; any byte
    string that is not UTF-8 is read as Latin-1, which never fails.
    """
    raw = re.sub(rb"\\x([0-9a-fA-F]{2})", lambda m: bytes([int(m.group(1), 16)]), field)
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        return raw.decode("latin-1")


def gpg_error(stderr: bytes) -> str:
    """Return gpg's first stderr line that is not a routine notice, or ''.

    gpg can print its real error before a notice it emits on exit, such as
    "no gpg-agent running in this session".
    """
    notices = ("running with faked system time", "no gpg-agent running")
    lines = stderr.decode(errors="replace").splitlines()
    return next((ln for ln in lines if not any(n in ln for n in notices)), "")


def _is_reusable_auth(f: list[bytes]) -> bool:
    """Return whether a ``pub`` or ``sub`` colon line is a live auth key git-vouch accepts.

    Lowercase ``a`` is the key's own capability; on a ``pub`` line the
    uppercase letters are the whole key's.
    """
    return (
        f[1].decode() not in NOT_LIVE
        and b"a" in f[11]
        and (
            f[16].decode() in REUSABLE_CURVES
            or f[3] == b"1"
            and vouch.RSA_MIN_BITS <= int(f[2]) <= vouch.RSA_MAX_BITS
        )
    )


def parse_listing(colons: bytes) -> list[GpgKey]:
    """Return the keys in ``gpg --with-colons --fixed-list-mode --list-keys`` output."""
    keys: list[GpgKey] = []
    pub: Optional[list[bytes]] = None
    fpr = ""
    uids: list[str] = []
    auth: list[str] = []
    sub: Optional[list[bytes]] = None  # the subkey whose fpr line comes next

    def flush() -> None:
        if pub is not None:
            keys.append(
                GpgKey(fpr, int(pub[5]), pub[1].decode(), tuple(uids), tuple(auth))
            )

    for line in colons.splitlines():
        f = line.split(b":")
        if f[0] == b"pub":
            flush()
            pub, fpr, uids, auth, sub = f, "", [], [], None
        elif f[0] == b"fpr" and pub is not None:
            if not fpr:
                fpr = f[9].decode()
                if _is_reusable_auth(pub):
                    auth.append(fpr)
            elif sub is not None:
                if _is_reusable_auth(sub):
                    auth.append(f[9].decode())
                sub = None
        elif f[0] == b"sub":
            sub = f
        elif f[0] == b"uid" and f[1] != b"r":
            uids.append(_unescape(f[9]))
    flush()
    return keys


def is_role_key(key: GpgKey) -> bool:
    """Return whether every user ID is a kernel.org list address named after itself."""

    def is_role(uid: str) -> bool:
        m = ROLE_RE.fullmatch(uid)
        return m is not None and (m.group(1).lower(), m.group(2).lower()) == m.group(
            3, 4
        )

    return bool(key.uids) and all(is_role(u) for u in key.uids)


def _uid_parts(uid: str) -> tuple[Optional[str], Optional[str]]:
    """Return a user ID's name and lowercased email, each None if absent.

    Besides "Name (comment) <email>", a user ID may be a bare email or a
    name alone; some keys spread one identity over several of these.
    """
    m = UID_RE.fullmatch(uid)
    if m:
        return m.group(1) or None, m.group(2).lower()
    if "@" in uid:
        return None, uid.strip().lower()
    m = NAME_ONLY_RE.fullmatch(uid)
    return (m.group(1) or None) if m else None, None


def _name_and_emails(key: GpgKey) -> tuple[Optional[str], list[str]]:
    """Return the first name in UID order (primary first) and every usable email, lowercased."""
    name = None
    emails: list[str] = []
    for uid in key.uids:
        uid_name, email = _uid_parts(uid)
        if name is None and uid_name and uid_name.isprintable():
            name = uid_name
        if email and vouch.EMAIL_RE.fullmatch(email) and email not in emails:
            emails.append(email)
    return name, emails


def _all_emails(key: GpgKey) -> set[str]:
    return {email for _, email in map(_uid_parts, key.uids) if email}


def group_people(keys: Sequence[GpgKey]) -> list[list[GpgKey]]:
    """Return the keys grouped by shared email, transitively.

    An email may be in only one person file, so two keys that share one
    cannot become two files; port drafts a group only if it is one person.
    """
    parent = {k.fpr: k.fpr for k in keys}

    def root(fpr: str) -> str:
        while parent[fpr] != fpr:
            fpr = parent[fpr]
        return fpr

    owner: dict[str, str] = {}
    for key in keys:
        for email in _all_emails(key):
            other = owner.setdefault(email, key.fpr)
            parent[root(key.fpr)] = root(other)
    groups: dict[str, list[GpgKey]] = {}
    for key in keys:
        groups.setdefault(root(key.fpr), []).append(key)
    return sorted(groups.values(), key=lambda g: min(k.fpr for k in g))


def _base_handle(email: str) -> Optional[str]:
    local = re.sub(r"[^a-z0-9_-]", "-", email.split("@")[0]).lstrip("-_")[:39]
    return local if vouch.HANDLE_RE.fullmatch(local) else None


def assign_handles(people: Sequence[tuple[GpgKey, Sequence[str]]]) -> dict[str, str]:
    """Return a handle for each key fingerprint, from the email local parts.

    The first @kernel.org address is preferred, then the first address,
    with any character a handle cannot hold turned into '-'. When several
    people want one handle, kernel.org holders win, then the lowest
    fingerprint; the others get ``-2``, ``-3``, ... in that order.

    Args:
        people: Each person's chosen key and usable emails.

    Raises:
        VouchError: No email of a person yields a handle.
    """
    wanted: dict[str, list[tuple[bool, str]]] = {}
    for key, emails in people:
        bases = [(e.endswith("@kernel.org"), _base_handle(e)) for e in emails]
        usable = [b for b in bases if b[1] is not None]
        if not usable:
            raise VouchError(f"{key.fpr}: no email gives a handle")
        is_korg, base = max(usable, key=lambda b: b[0])  # first kernel.org, else first
        assert base is not None
        wanted.setdefault(base, []).append((not is_korg, key.fpr))
    taken = set(wanted)
    handles = {}
    for base, claims in sorted(wanted.items()):
        first, *rest = sorted(claims)
        handles[first[1]] = base
        n = 1
        for _, fpr in rest:
            while True:
                n += 1
                handle = f"{base[: 39 - len(str(n)) - 1]}-{n}"
                if handle not in taken:
                    break
            taken.add(handle)
            handles[fpr] = handle
    return handles


def check_draft(handle: str, data: bytes) -> None:
    """Validate a draft with git-vouch's person-file rules, minus the signature.

    A draft with no keys stands in PLACEHOLDER_KEY for the key its holder
    will add, so every other term is still checked.

    Raises:
        VouchError: git-vouch rejects the draft.
    """
    rel = f"people/{handle}.json"
    obj = json.loads(data)
    if not obj["keys"]:
        obj["keys"] = [{"ssh": PLACEHOLDER_KEY, "added": "2000-01-01T00:00:00Z"}]
        data = json.dumps(obj).encode()
    vouch.parse_record(rel, data)


class Pgpkeys:
    """A temporary keyring of the keys/*.asc of pgpkeys.git at the freeze commit."""

    def __init__(self, repo: Path, commit: str, home: Path) -> None:
        """Resolve ``commit`` in ``repo`` and import its keys/*.asc into ``home``.

        Raises:
            VouchError: The commit does not exist or gpg cannot import the keys.
        """
        self.repo = repo
        self.home = home
        self.commit = self._git(
            "rev-parse", "--verify", "--end-of-options", commit + "^{commit}"
        )
        self.time = int(self._git("show", "-s", "--format=%ct", self.commit))
        # Judge every key and the freeze commit's own signature at the freeze
        # commit, for gpg and git verify-commit alike.
        (home / "gpg.conf").write_text(f"faked-system-time {self.time}!\n")
        # With --trust-model always gpg never makes a trustdb, yet applying a
        # revocation to a key already in the keyring dies without one.
        self.gpg("--trust-model", "pgp", "--check-trustdb")
        files = self._key_files()
        found = {name: self._import(data) for name, data in files.items()}
        # One retry settles file order: by then every key gpg will take is in
        # the keyring, so a revocation filed before its key now applies.
        for name, data in files.items():
            if found[name].failed:
                found[name] = self._import(data)
        # One line per file gpg did not fully import, saying what it did take.
        self.report: list[str] = []
        for name, got in found.items():
            if got.why is None:
                continue
            if got.taken:
                self.report.append(
                    f"partial {name}: took {', '.join(got.taken)}; {got.why}"
                )
            else:
                self.report.append(f"skip {name}: {got.why}")

    def _key_files(self) -> dict[str, bytes]:
        """Return each keys/**.asc file at the freeze commit, by path.

        Read as blobs, not with git archive, whose export-ignore and
        export-subst attributes could drop or change a file. Not with
        vouch.read_blobs either: a few real keys/ files are over its size cap.

        Raises:
            VouchError: git fails.
        """
        cmd = [*vouch.GIT_LOG, "ls-tree", "-r", "-z", "--full-tree", self.commit]
        listing = vouch.run([*cmd, "--", "keys/"], cwd=self.repo)
        blobs = {}
        for entry in listing.decode().split("\0"):
            meta, _, name = entry.partition("\t")
            if name.endswith(".asc") and meta.split()[0] in vouch.FILE_MODES:
                blobs[name] = meta.split()[2]
        stdin = "".join(f"{b}\n" for b in blobs.values()).encode()
        out = vouch.run([*vouch.GIT, "cat-file", "--batch"], stdin=stdin, cwd=self.repo)
        files = {}
        for name in blobs:
            header, out = out.split(b"\n", 1)
            size = int(header.split()[2])
            files[name], out = out[:size], out[size + 1 :]
        return files

    def _import(self, data: bytes) -> Imported:
        """Import one keys/ file into the keyring.

        One file at a time, so a bad file names itself: gpg skips a PGP-2
        (v3) key with exit 0, and fails a file holding a revocation
        certificate whose key is not yet in the keyring, after importing
        the rest of it.

        Raises:
            VouchError: gpg cannot be run.
        """
        cmd = [*self._gpg_cmd(), "--status-fd", "1", "--import"]
        try:
            proc = subprocess.run(cmd, input=data, capture_output=True, check=False)
        except OSError as e:
            raise VouchError(f"cannot run gpg: {e}") from e
        status = [
            ln.split()[1:]
            for ln in proc.stdout.decode(errors="replace").splitlines()
            if ln.startswith("[GNUPG:] ")
        ]
        taken = tuple(dict.fromkeys(s[2] for s in status if s[0] == "IMPORT_OK"))
        res = [s[1:] for s in status if s[0] == "IMPORT_RES"]
        if proc.returncode != 0 or len(res) != 1:
            why = f"gpg failed: {gpg_error(proc.stderr) or proc.returncode}"
            return Imported(True, taken, why)
        if len(res[0]) > 14 and int(res[0][14]):
            why = f"{res[0][14]} PGP-2 (v3) key(s), which gpg no longer imports"
            return Imported(False, taken, why)
        if int(res[0][0]) == 0:
            return Imported(False, taken, "no key")
        # gpg's own refusals: no user ID, skipped new key, not imported. Not
        # taken minus count: a revocation it already holds is counted, unnamed.
        refused = sum(int(res[0][i]) for i in (1, 12, 13))
        if refused:
            return Imported(False, taken, f"gpg refused {refused} key(s)")
        return Imported(False, taken, None)

    def _git(self, *args: str) -> str:
        out: bytes = vouch.run([*vouch.GIT_LOG, *args], cwd=self.repo)
        return out.decode().strip()

    def gpg(
        self, *args: str, values: Sequence[str] = (), stdin: Optional[bytes] = None
    ) -> bytes:
        """Run gpg on the temporary keyring, clocked at the freeze commit's date."""
        cmd = [*self._gpg_cmd(), *args]
        return vouch.run(cmd, values=values, stdin=stdin)  # type: ignore[no-any-return]

    def _gpg_cmd(self) -> list[str]:
        cmd = ["gpg", "--homedir", str(self.home), "--batch", "--no-tty", "--quiet"]
        cmd += ["--no-autostart", "--no-auto-key-retrieve", "--trust-model", "always"]
        return cmd

    def detached_signer(self, sig: bytes, data: bytes) -> str:
        """Return the primary fingerprint of the key that made ``sig``, a signature over ``data``.

        ``sig`` must be one detached binary signature (class 00), so it covers
        ``data``'s exact bytes. A key expired at the freeze commit counts (D9):
        gpg then says
        EXPKEYSIG instead of GOODSIG, and exits 0 for both. A revoked key does
        not: gpg says REVKEYSIG.

        Raises:
            VouchError: ``sig`` is not one good binary signature by a key in
                the keyring over ``data``.
        """
        path = self.home / "proof.asc"
        path.write_bytes(sig)
        cmd = [*self._gpg_cmd(), "--status-fd", "1", "--verify", "--", str(path), "-"]
        try:
            proc = subprocess.run(cmd, input=data, capture_output=True, check=False)
        except OSError as e:
            raise VouchError(f"cannot run gpg: {e}") from e
        status = [
            ln.split()
            for ln in proc.stdout.decode(errors="replace").splitlines()
            if ln.startswith("[GNUPG:] ")
        ]
        words = [s[1] for s in status]
        failure = next((w for w in GPG_FAILURES if w in words), None)
        if failure is not None:
            raise VouchError(f"gpg reports {failure}")
        valid = [s for s in status if s[1] == "VALIDSIG"]
        if (
            proc.returncode != 0
            or words.count("NEWSIG") != 1
            or words.count("GOODSIG") + words.count("EXPKEYSIG") != 1
            or len(valid) != 1
            or len(valid[0]) != 12
        ):
            raise VouchError("not one good signature")
        if valid[0][10] != "00":
            raise VouchError("not a binary signature over the exact bytes")
        return valid[0][11]

    def check_signature(self, signer: str) -> None:
        """Check that the freeze commit is signed by primary fingerprint ``signer``.

        The signer's key must be in the freeze commit's own keys/, as it is
        for pgpkeys.

        Raises:
            VouchError: The freeze commit is unsigned, the signature is bad, or
                someone else made it.
        """
        cmd = [*vouch.GIT, "-c", "gpg.format=openpgp", "-c", "gpg.program=gpg"]
        cmd += ["verify-commit", "--raw", self.commit]
        proc = subprocess.run(
            cmd,
            cwd=self.repo,
            env=dict(os.environ, GNUPGHOME=str(self.home)),
            capture_output=True,
            check=False,
        )
        status = [
            ln.split() for ln in proc.stderr.decode(errors="replace").splitlines()
        ]
        valid = [s for s in status if s[:2] == ["[GNUPG:]", "VALIDSIG"]]
        good = [s for s in status if s[:2] == ["[GNUPG:]", "GOODSIG"]]
        if proc.returncode != 0 or len(valid) != 1 or len(good) != 1:
            raise VouchError(
                f"commit {self.commit} has no good signature by a key in its keys/"
            )
        if valid[0][-1] != signer:
            raise VouchError(
                f"commit {self.commit} is signed by {valid[0][-1]}, not {signer}"
            )

    def keys(self) -> list[GpgKey]:
        """Return every key in the keyring, judged at the freeze commit."""
        return parse_listing(
            self.gpg("--with-colons", "--fixed-list-mode", "--list-keys")
        )

    def ssh_key(self, subkey: str) -> str:
        """Return the SSH public key line ("type base64") for one authentication key."""
        line = self.gpg("--export-ssh-key", values=[subkey + "!"]).decode()
        return " ".join(line.split()[:2])


def port(pgp: Pgpkeys, out: Path) -> int:
    """Write one draft person file per person to ``out``/people and report on stdout.

    Returns:
        The number of drafts written.
    """
    keys = pgp.keys()
    usable = []
    for key in keys:
        if key.validity in SKIPPED:
            print(f"skip {key.fpr}: {SKIPPED[key.validity]}")
        elif is_role_key(key):
            print(f"skip {key.fpr}: not a person: {key.uids[0]}")
        else:
            usable.append(key)
    people: list[tuple[GpgKey, list[str]]] = []
    names = {}
    for group in group_people(usable):
        # UID emails are the holders' own claims: keys that share one but not
        # the primary name may be one holder borrowing another's email, so
        # none of them is drafted and an anchor settles it (as for D3).
        # ponytail: a holder also sets their own primary name, so one who copies
        # another's name as well is still merged; the strict upgrade is to draft
        # no group of two or more keys, which drops 21 people at af88128.
        if len({_name_and_emails(k)[0] for k in group}) > 1:
            for key in group:
                print(
                    f"conflict {key.fpr}: shares an email with a differently named key"
                )
            continue
        # ponytail: one draft per person, from their newest unexpired key,
        # preferring one with a reusable auth key, else their newest key; the
        # holder may edit migratedFrom to another of their keys before signing.
        chosen = max(
            group, key=lambda k: (k.validity != "e", bool(k.auth), k.created, k.fpr)
        )
        for other in group:
            if other is not chosen:
                print(f"merge {other.fpr}: same person as {chosen.fpr}, which is used")
        name, emails = _name_and_emails(chosen)
        if name is None or not emails:
            print(f"skip {chosen.fpr}: no user ID with a usable name and email")
            continue
        names[chosen.fpr] = name
        people.append((chosen, emails))
    handles = assign_handles(people)
    added = datetime.fromtimestamp(pgp.time, timezone.utc).strftime(vouch.DATE_FORMAT)
    drafts = []
    for key, emails in people:
        lines = [pgp.ssh_key(sub) for sub in key.auth]
        # RSA is pre-filled only when it is all the key has.
        lines = [s for s in lines if not s.startswith("ssh-rsa ")] or lines
        draft = {
            "@context": [vouch.CONTEXT],
            "handle": handles[key.fpr],
            "name": names[key.fpr],
            "emails": emails,
            "keys": [{"ssh": s, "added": added, "retired": None} for s in lines],
            "migratedFrom": "openpgp4fpr:" + key.fpr,
        }
        data = (json.dumps(draft, indent=2, ensure_ascii=False) + "\n").encode()
        try:
            check_draft(handles[key.fpr], data)
        except VouchError as e:
            print(f"skip {key.fpr}: {e}")
            continue
        drafts.append(Draft(handles[key.fpr], key, data))
    _write_new(out, {f"people/{d.handle}.json": d.data for d in drafts})
    roles = [k for k in keys if is_role_key(k)]
    print(
        f"keys {len(keys)}, live {len(keys) - sum(k.validity in NOT_LIVE for k in keys)}, "
        f"expired {sum(k.validity == 'e' for k in keys)}, "
        f"kernel.org list keys {len(roles)} "
        f"({len(roles) - sum(k.validity in NOT_LIVE for k in roles)} live), "
        f"people {len(people)}, drafts {len(drafts)}, live keys with a reusable "
        f"auth subkey {sum(k.validity not in NOT_LIVE and bool(k.auth) for k in keys)} "
        f"({sum(bool(d.key.auth) for d in drafts)} in drafts)"
    )
    return len(drafts)


def _signed_by(rel: str, data: bytes, sig: bytes, key: vouch.PersonKey) -> bool:
    """Return whether one of the signatures in ``sig`` is by ``key``, per git-vouch."""
    try:
        blocks = vouch.split_signatures(sig)
    except VouchError:
        return False
    for block in blocks:
        try:
            vouch.signer_of(rel, data, block, [key])
        except VouchError:
            continue
        return True
    return False


def _prove_version(
    pgp: Pgpkeys,
    rel: str,
    data: bytes,
    sigs: Sequence[bytes],
    ascs: Sequence[bytes],
    key: GpgKey,
    revoked: Collection[str],
) -> str:
    """Return how GPG ``key``'s holder proved that version ``data`` of ``rel`` is theirs.

    Args:
        pgp: The pgpkeys keyring at the freeze commit.
        rel: ``people/<handle>.json``.
        data: One version of it, claiming ``key``.
        sigs: Contents of ``rel``.sig that may sign ``data``.
        ascs: Contents of ``rel``.asc that may sign ``data``.
        key: The GPG key claimed.
        revoked: Every did:key revoked in the registry.

    Raises:
        VouchError: This version is not proven by any of ``sigs`` or ``ascs``.
    """
    person = vouch.parse_record(rel, data)
    if person.migrated_from != key.fpr:
        raise VouchError(f"does not claim {key.fpr}")
    uid_emails = _all_emails(key)
    for email in person.emails:
        if email.lower() not in uid_emails:
            raise VouchError(f"{email} is not on an unrevoked user ID of {key.fpr}")
    # The auth subkey must have signed this version: its public key is public,
    # so listing it proves nothing.
    current = [k for k in person.keys if k.retired is None and k.did not in revoked]
    for sub in key.auth:
        ssh = pgp.ssh_key(sub)
        for k in current:
            if k.ssh == ssh and any(_signed_by(rel, data, s, k) for s in sigs):
                return f"auth subkey {sub}"
    if not ascs:
        raise VouchError(
            f"no {rel}.asc, and no signature by an auth subkey of {key.fpr}"
        )
    errors = []
    for asc in ascs:
        try:
            signer = pgp.detached_signer(asc, data)
        except VouchError as e:
            errors.append(f"{rel}.asc: {e}")
            continue
        if signer == key.fpr:
            return ".asc"
        errors.append(f"{rel}.asc: signed by {signer}, not {key.fpr}")
    raise VouchError(errors[0])


def _committed(root: Path, rel: str, since: Collection[str] = ()) -> list[bytes]:
    """Return committed contents of ``rel`` in the registry, newest first.

    Only versions at or descended from every commit in ``since`` count.

    Raises:
        VouchError: The registry's history cannot be read.
    """
    if not vouch._is_repo_top(root):
        return []
    allowed = None
    for commit in since:
        out = vouch.run(
            [*vouch.GIT, "rev-list", "--ancestry-path", f"{commit}..HEAD"], cwd=root
        )
        after = {commit, *out.decode().split()}
        allowed = after if allowed is None else allowed & after
    return [
        v.data
        for v in reversed(vouch.file_history(root, rel))
        if v.data and (allowed is None or v.commit in allowed)
    ]


def _prove(
    pgp: Pgpkeys,
    root: Path,
    handle: str,
    key: GpgKey,
    revoked: Collection[str],
    unchained: Collection[str],
) -> str:
    """Return how the holder of GPG ``key`` proved that ``people/<handle>.json`` is theirs.

    The proof is judged against the version of the person file it was made
    for, found in the registry's history, so a later add-key, retire-key or
    email change does not undo it. That version must claim ``key`` and pass
    the email check itself. ``unchained`` names where ``git vouch check``
    warns the file changed without a signature by a key current in the
    version before (a commit, or "the working tree"): a lost-key recovery or
    a handle registered again after deletion. Only versions at or after
    every such change count.

    Raises:
        VouchError: No version proves it; the reason given is the current
            version's. Or the registry's history cannot be read.
    """
    if key.validity in SKIPPED:
        raise VouchError(f"{key.fpr} is {SKIPPED[key.validity]}")
    rel = f"people/{handle}.json"
    data = vouch.read_capped(root, rel)
    sigs = [vouch.read_capped(root, rel + ".sig")]
    ascs = []
    if (root / f"{rel}.asc").exists():
        ascs.append(vouch.read_capped(root, rel + ".asc"))
    try:
        return _prove_version(pgp, rel, data, sigs, ascs, key, revoked)
    except VouchError as e:
        why = e
    if unchained:
        why = VouchError(
            f"{why}; a proof for a version before the last change only registry"
            " review let through does not count: a version since needs its own"
            " (a fresh .asc or an auth-subkey signature)"
        )
    if "the working tree" in unchained:
        raise why
    # ponytail: every version against every signature, one verifier run per
    # pair; fine for the few edits a person file sees.
    sigs += _committed(root, rel + ".sig")
    ascs += _committed(root, rel + ".asc")
    for old in _committed(root, rel, unchained):
        try:
            return _prove_version(pgp, rel, old, sigs, ascs, key, revoked)
        except VouchError:
            continue
    raise why


def verify_continuity(
    pgp: Pgpkeys, root: Path, handles: Collection[str] = ()
) -> Continuity:
    """Verify the continuity proof of each ported person file in the registry at ``root``.

    The person file must be validly signed by git-vouch's own rules, and
    its ``migratedFrom`` key in pgpkeys at the freeze commit not revoked
    (an expired key is accepted, D9). The proof is judged against the
    version of the file it was made for, found in the registry's history
    (see ``_prove``): that
    version has every email on an unrevoked user ID of the key, and is
    signed by a live ed25519, P-256 or RSA authentication key (the primary
    or a subkey), or by ``people/<handle>.json.asc``, a detached signature
    by the key over its exact bytes. A fingerprint claimed by two or more
    handles proves none of them (D3).

    Args:
        pgp: The pgpkeys keyring at the freeze commit.
        root: The registry checkout.
        handles: Whose claims to verify; every ported person file if empty.

    Raises:
        VouchError: ssh-keygen or gpg cannot be run, or the registry's
            history cannot be read.
    """
    result = vouch.check_registry(root)
    claims = {
        h: p.migrated_from for h, p in sorted(result.people.items()) if p.migrated_from
    }
    failed: dict[str, str] = {}
    # git-vouch itself rejects a malformed one, leaving the file out of people.
    for problem in result.problems:
        m = re.fullmatch(r"people/(.+)\.json: (migratedFrom: .*)", problem)
        if m:
            failed[m.group(1)] = m.group(2)
    by_fpr: dict[str, list[str]] = {}
    for handle, fpr in claims.items():
        by_fpr.setdefault(fpr, []).append(handle)
    duplicates = {f: hs for f, hs in sorted(by_fpr.items()) if len(hs) > 1}
    keys = {k.fpr: k for k in pgp.keys()}
    proven: dict[str, Proof] = {}
    for handle, fpr in claims.items():
        if handles and handle not in handles:
            continue
        if fpr in duplicates:
            others = ", ".join(h for h in duplicates[fpr] if h != handle)
            failed[handle] = f"{fpr} is also claimed by {others}"
        elif fpr not in keys:
            failed[handle] = f"{fpr} is not in pgpkeys at the freeze commit"
        else:
            try:
                how = _prove(
                    pgp,
                    root,
                    handle,
                    keys[fpr],
                    result.revoked,
                    result.unchained.get(handle, []),
                )
            except VouchError as e:
                failed[handle] = str(e)
            else:
                proven[handle] = Proof(fpr, how)
    if handles:
        failed = {h: why for h, why in failed.items() if h in handles}
        for handle in handles:
            if handle not in result.people:
                failed.setdefault(handle, "no validly signed person file")
            elif handle not in claims and handle not in failed:
                failed[handle] = "no migratedFrom"
    return Continuity(proven, failed, duplicates, result)


def parse_certifications(
    colons: bytes, certifier: str
) -> dict[str, list[Certification]]:
    """Return each key's live certifications by ``certifier``, from ``--check-sigs`` output.

    For every unrevoked user ID, the latest good certification (class 0x10
    to 0x13) by the primary key ``certifier`` counts unless a good
    certification revocation (class 0x30) by it is as new or newer. Only
    signatures gpg verified ('!') are read.

    Args:
        colons: ``gpg --with-colons --fixed-list-mode --check-sigs`` output.
        certifier: The certifier's primary fingerprint.

    Returns:
        Primary fingerprint -> its certified user IDs, in listing order.
    """
    found: dict[str, list[Certification]] = {}
    fpr = ""
    uid: Optional[str] = None  # the unrevoked user ID whose signatures come next
    times: dict[str, list[int]] = {}  # user ID -> [latest cert, latest revocation]

    def flush() -> None:
        for u, (cert, rev) in times.items():
            if cert > rev:
                found.setdefault(fpr, []).append(Certification(u, cert))

    for line in colons.splitlines():
        f = line.split(b":")
        if f[0] == b"pub":
            flush()
            fpr, uid, times = "", None, {}
        elif f[0] == b"fpr" and not fpr:
            fpr = f[9].decode()
        elif f[0] in (b"sub", b"uat"):  # a photo ID's signatures certify no user ID
            uid = None
        elif f[0] == b"uid":
            uid = None if f[1] == b"r" else _unescape(f[9])
        elif f[0] in (b"sig", b"rev") and uid is not None and len(f) > 12:
            by_certifier = f[4].decode() == certifier[-16:] and f[12].decode() in (
                "",
                certifier,
            )
            kind = f[10][:2].decode()
            if f[1] != b"!" or not by_certifier:
                continue
            slot = times.setdefault(uid, [0, 0])
            if f[0] == b"sig" and kind in ("10", "11", "12", "13"):
                slot[0] = max(slot[0], int(f[5]))
            elif f[0] == b"rev" and kind == "30":
                slot[1] = max(slot[1], int(f[5]))
    flush()
    return found


def _current_key(person: vouch.Person, revoked: Collection[str]) -> vouch.PersonKey:
    """Return the person's first key that is neither retired nor revoked.

    Raises:
        VouchError: They have none.
    """
    for key in person.keys:
        if key.retired is None and key.did not in revoked:
            return key
    raise VouchError(f"people/{person.handle}.json: no current key")


def _next_seq(root: Path, subject: str, endorser: str) -> int:
    """Return the next free n for endorsements/<subject>/<endorser>-<n>.json in the registry."""
    taken = [0]
    for name in vouch.list_dir(root, f"endorsements/{subject}"):
        m = vouch.SEQ_RE.fullmatch(name[: -len(".json")])
        if name.endswith(".json") and m is not None and m.group(1) == endorser:
            taken.append(int(m.group(2)))
    return max(taken) + 1


def _utc(when: int) -> str:
    return datetime.fromtimestamp(when, timezone.utc).strftime("%Y-%m-%d")


def drafts(pgp: Pgpkeys, root: Path, certifier: str, out: Path) -> int:
    """Write the certifier's unsigned endorsement drafts to ``out`` and report on stdout.

    One draft per registered person, other than the certifier, whose
    continuity proof holds and whose GPG key the key in the certifier's
    own ``migratedFrom`` certified at the freeze commit (see ``parse_certifications``).
    The certifier needs no continuity proof, and their other GPG keys'
    certifications are not read. SHA-1 certifications and ones expired
    by the freeze commit count: the draft is a reminder, and the certifier's SSH
    signature on it is what counts.

    Args:
        pgp: The pgpkeys keyring at the freeze commit.
        root: The registry checkout.
        certifier: The certifier's handle.
        out: A new directory; drafts go to its endorsements/<subject>/.

    Returns:
        The number of drafts written.

    Raises:
        VouchError: The certifier has no validly signed person file, or it
            has no ``migratedFrom`` key in pgpkeys at the freeze commit, or
            gpg, ssh-keygen or git fails.
    """
    found = verify_continuity(pgp, root)
    people, revoked = found.check.people, found.check.revoked
    if certifier not in people:
        raise VouchError(f"--as {certifier}: no validly signed person file")
    by = people[certifier].migrated_from
    if by is None:
        raise VouchError(f"--as {certifier}: no migratedFrom")
    if by not in {k.fpr for k in pgp.keys()}:
        raise VouchError(
            f"--as {certifier}: {by} is not in pgpkeys at the freeze commit"
        )
    endorser_key = _current_key(people[certifier], revoked)
    subjects = {h: p.fpr for h, p in found.proven.items() if h != certifier}
    certs = {}
    if subjects:
        certs = parse_certifications(
            pgp.gpg(
                "--with-colons",
                "--fixed-list-mode",
                "--allow-weak-key-signatures",
                "--check-sigs",
                values=sorted(set(subjects.values())),
            ),
            by,
        )
    now = datetime.now(timezone.utc).strftime(vouch.DATE_FORMAT)
    written: dict[str, bytes] = {}
    for handle, fpr in sorted(subjects.items()):
        if fpr not in certs:
            continue
        person = people[handle]
        try:
            subject_key = _current_key(person, revoked)
        except VouchError as e:
            print(f"skip {handle}: {e}")
            continue
        certified = {e for _, e in (_uid_parts(c.uid) for c in certs[fpr]) if e}
        draft = {
            "@context": [vouch.CONTEXT],
            "endorser": certifier,
            "endorserKey": endorser_key.did,
            "subject": handle,
            "subjectKey": subject_key.did,
            "subjectName": person.name,
            "subjectEmails": [m for m in person.emails if m.lower() in certified],
            "note": " ".join(
                f'Certified GPG key {fpr} user ID "{c.uid}" on {_utc(c.time)}.'
                for c in certs[fpr]
            ),
            "date": now,
        }
        rel = f"endorsements/{handle}/{certifier}-{_next_seq(root, handle, certifier)}.json"
        data = (json.dumps(draft, indent=2, ensure_ascii=False) + "\n").encode()
        vouch.parse_record(rel, data)
        written[rel] = data
    if written:
        _write_new(out, written)
    for rel in written:
        print(f"draft {rel}")
    print(f"certified by {by}: {len(written)} drafts")
    return len(written)


def _write_new(out: Path, files: Mapping[str, bytes]) -> None:
    """Write ``files``, relative path to contents, as the new directory ``out``.

    They are written to a directory beside ``out`` that is then renamed to
    it, so a failed write leaves no ``out`` to refuse the retry.

    Raises:
        VouchError: A directory or file cannot be written, or ``out`` now exists.
    """
    tmp = out.parent / f".{out.name}.{os.getpid()}"
    try:
        out.parent.mkdir(parents=True, exist_ok=True)
        tmp.mkdir()
        try:
            for rel, data in files.items():
                (tmp / rel).parent.mkdir(parents=True, exist_ok=True)
                (tmp / rel).write_bytes(data)
            os.rename(tmp, out)
        except BaseException:
            shutil.rmtree(tmp, ignore_errors=True)
            raise
    except OSError as e:
        raise VouchError(f"{out}: cannot write the drafts: {e}") from e


@contextlib.contextmanager
def keyring() -> Iterator[Path]:
    """Yield a new temporary gpg home; on exit, stop its gpg daemons and remove it."""
    with tempfile.TemporaryDirectory(prefix="git-vouch-migrate.") as home:
        try:
            yield Path(home)
        finally:
            # gpg starts gpg-agent on demand, and it outlives gpg and its homedir.
            # A warning, not an error, so it cannot hide why the command failed.
            try:
                proc = subprocess.run(
                    ["gpgconf", "--homedir", home, "--kill", "all"],
                    capture_output=True,
                )
            except OSError as e:
                print(f"git-vouch-migrate: warning: {e}", file=sys.stderr)
            else:
                if proc.returncode != 0:
                    why = gpg_error(proc.stderr) or proc.returncode
                    print(
                        f"git-vouch-migrate: warning: gpgconf --kill all: {why}",
                        file=sys.stderr,
                    )


def _open_pgpkeys(args: argparse.Namespace, home: Path) -> Pgpkeys:
    """Return the pgpkeys keyring at ``args.commit``, after checking its signature."""
    pgp = Pgpkeys(Path(args.pgpkeys), args.commit, home)
    pgp.check_signature(args.signer)
    print(f"pgpkeys at {pgp.commit}, signed by {args.signer}")
    for line in pgp.report:
        print(line)
    return pgp


def _check_signer(args: argparse.Namespace) -> None:
    args.signer = args.signer.upper()
    if not FPR_RE.fullmatch(args.signer):
        raise VouchError("--signer: must be a 40-hex fingerprint")


def cmd_port(args: argparse.Namespace) -> int:
    """Check the freeze commit's signature, then write the person-file drafts."""
    _check_signer(args)
    out = Path(args.out)
    if out.exists():
        raise VouchError(
            f"{out}: already exists; drafts are only written to a new directory"
        )
    with keyring() as home:
        port(_open_pgpkeys(args, home), out)
    return 0


def cmd_verify_continuity(args: argparse.Namespace) -> int:
    """Check the freeze commit's signature, then report each continuity claim.

    Returns 1 if any claim is not proven.
    """
    _check_signer(args)
    for handle in args.handles:
        vouch.validate_handle(handle)
    with keyring() as home:
        pgp = _open_pgpkeys(args, home)
        found = verify_continuity(pgp, Path(args.registry), args.handles)
    for fpr, handles in found.duplicates.items():
        print(f"duplicate {fpr}: {', '.join(handles)}")
    for handle in sorted({*found.proven, *found.failed}):
        if handle in found.proven:
            proof = found.proven[handle]
            print(f"ok {handle}: openpgp4fpr:{proof.fpr} by {proof.how}")
        else:
            print(f"fail {handle}: {found.failed[handle]}")
    return 1 if found.failed else 0


def cmd_drafts(args: argparse.Namespace) -> int:
    """Check the freeze commit's signature, then write the endorsement drafts."""
    _check_signer(args)
    vouch.validate_handle(args.handle)
    out = Path(args.out)
    if out.exists():
        raise VouchError(
            f"{out}: already exists; drafts are only written to a new directory"
        )
    with keyring() as home:
        drafts(_open_pgpkeys(args, home), Path(args.registry), args.handle, out)
    return 0


def build_parser() -> argparse.ArgumentParser:
    """Return the argument parser."""
    parser = argparse.ArgumentParser(prog="git-vouch-migrate", description=__doc__)
    sub = parser.add_subparsers(dest="command", metavar="<command>", required=True)
    p = sub.add_parser(
        "port",
        help="write unsigned person-file drafts from pgpkeys.git at the freeze commit",
        description=(
            "Import keys/*.asc from pgpkeys.git at the freeze commit into a temporary "
            "keyring, check the freeze commit's signature, and write one unsigned "
            "draft people/<handle>.json per person to a new directory. Keys are judged "
            "at the freeze commit's committer date: revoked keys and kernel.org list "
            "keys are skipped, expired keys are not; keys sharing an email are one "
            "person, drafted from the newest unexpired key, preferring one with a "
            "reusable authentication key (else the newest key), if their primary names "
            "match, and otherwise none is drafted. Emails come from unrevoked user "
            "IDs. An ed25519 or P-256 authentication key or subkey is pre-filled as "
            "the SSH key, else an RSA one of 2048 to 16384 bits."
        ),
    )
    p.add_argument("pgpkeys", help="a pgpkeys.git clone")
    p.add_argument("--commit", required=True, help="the freeze commit")
    p.add_argument(
        "--signer",
        required=True,
        help="primary fingerprint expected to sign the freeze commit",
    )
    p.add_argument("--out", required=True, help="new directory for the drafts")
    p.set_defaults(func=cmd_port)
    p = sub.add_parser(
        "verify-continuity",
        help=(
            "verify ported person files' GPG continuity proofs against pgpkeys "
            "at the freeze commit"
        ),
        description=(
            "Check the freeze commit's signature, then, for each validly signed person "
            "file in the registry with migratedFrom (or each HANDLE given), verify its "
            "continuity proof against the keys in pgpkeys.git at the freeze commit: "
            "the GPG key must not be revoked at the freeze commit (expired is "
            "accepted), and some version of the person file in the registry's history "
            "must claim it, have every email on an unrevoked user ID of it, and be "
            "signed by an ed25519, P-256 or RSA authentication key or subkey of it "
            "listed as current in that version, or by people/<handle>.json.asc, its "
            "detached signature over that version's exact bytes. A fingerprint claimed "
            "by two handles proves neither. Prints 'ok' or 'fail' per handle, and "
            "exits 1 if any fails."
        ),
    )
    p.add_argument("pgpkeys", help="a pgpkeys.git clone")
    p.add_argument("registry", help="the registry checkout")
    p.add_argument("--commit", required=True, help="the freeze commit")
    p.add_argument(
        "--signer",
        required=True,
        help="primary fingerprint expected to sign the freeze commit",
    )
    p.add_argument(
        "handles", nargs="*", metavar="HANDLE", help="whose claims to verify"
    )
    p.set_defaults(func=cmd_verify_continuity)
    p = sub.add_parser(
        "drafts",
        help="write your unsigned endorsement drafts from your GPG certifications",
        description=(
            "Run by each certifier on their own machine. Check the freeze commit's "
            "signature and the continuity proofs, as verify-continuity does, then "
            "write to a new directory one unsigned draft "
            "endorsements/<subject>/<HANDLE>-<n>.json for each person whose proof "
            "holds and whose GPG key the key in HANDLE's own migratedFrom certified at "
            "the freeze commit; HANDLE needs no continuity proof. Per user ID, the "
            "latest certification counts unless HANDLE later revoked it; SHA-1 "
            "certifications and ones expired by the freeze commit count. subjectEmails "
            "are the person file's emails on certified user IDs, and note names the "
            "certified key, user IDs and dates. endorserKey and subjectKey are each "
            "person's first current key. Read each draft, then sign it."
        ),
    )
    p.add_argument("pgpkeys", help="a pgpkeys.git clone")
    p.add_argument("registry", help="the registry checkout")
    p.add_argument("--commit", required=True, help="the freeze commit")
    p.add_argument(
        "--signer",
        required=True,
        help="primary fingerprint expected to sign the freeze commit",
    )
    p.add_argument("--as", dest="handle", required=True, help="your own handle")
    p.add_argument("--out", required=True, help="new directory for the drafts")
    p.set_defaults(func=cmd_drafts)
    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    """Run the command line and return the process exit status."""
    args = build_parser().parse_args(argv)
    try:
        status: int = args.func(args)
        return status
    except VouchError as e:
        print(f"git-vouch-migrate: error: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
