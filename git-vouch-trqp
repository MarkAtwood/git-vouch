#!/usr/bin/env python3
"""git-vouch-trqp: answer OpenVTC verify-trust's TRQP queries from a git-vouch registry.

Serves ``POST /trust-tasks`` with Trust Task documents of type
``registry/authorization/0.1`` (the HTTPS binding verify-trust speaks) and
answers each from ``git vouch query``, which stays the only judge of who
holds which key. Stateless and unauthenticated: the registry is public.
TLS is left to a reverse proxy, which must also buffer each whole request
and bound how long it may take: the server limits each socket read, not a
request, and starts a thread per connection. ``did-document`` prints the
registry's DID document, which advertises the bridge to verify-trust.
It answers from the registry ``git vouch query`` reads, the copy ``git vouch
sync`` keeps once setup has run; sync that copy on a timer, since the bridge
refuses every query once its last successful sync is over 24 hours old. See DESIGN.md, TRQP bridge, and docs/trqp-interop.md.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import signal
import socket
import subprocess
import sys
import threading
import traceback
import uuid
from collections.abc import Mapping, Sequence
from datetime import datetime, timedelta, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from time import monotonic
from typing import Optional
from urllib.parse import urlsplit

TASK_TYPE = "https://trusttasks.org/spec/registry/authorization/0.1"
TASK_FAMILY = "https://trusttasks.org/spec/registry/authorization/"
ERROR_TYPE = "https://trusttasks.org/spec/trust-task-error/0.5"
ACTION = "git.commit.sign"
PATH = "/trust-tasks"
MAX_BODY = 64 * 1024
CLOCK_SKEW = timedelta(minutes=5)
QUERY_TIMEOUT = 30  # seconds for one git vouch query
STALE_AFTER = timedelta(hours=24)  # DESIGN.md, TRQP bridge, Freshness
RETRY_AFTER = 3600  # seconds; the sync timer's interval (docs/bridge-deployment.md)
EXT = "org.kernel.git-vouch"  # the response's ext namespace
# ponytail: for now, one full-history registry check (git vouch query --all)
# answers every DID, run once per registry commit and per ANSWER_TTL, shared by
# concurrent requests; a dirty served copy, or a request with a context.time
# (one DID's query each), is checked every time. So the first request after a
# sync or a minute pays a whole check, and once one takes longer than
# QUERY_TIMEOUT every such request gets a retryable 503 however light the load.
# QUERY_SLOTS caps concurrent git runs (past it, a retryable 503). The upgrade
# path is to check in the background after each sync and on a timer, so no
# request waits for a check. A full slot set refuses at once instead of
# queueing, on purpose: verify-trust fails closed and retries, and a blocking
# acquire would pile one thread per connection behind slow checks. If capacity
# runs short, make each check cheaper; never wait for a slot (vouch-s9w2.6).
QUERY_SLOTS = threading.BoundedSemaphore(4)
# ponytail: an answer for now is reused for ANSWER_TTL seconds, so a key whose
# retired instant or tier end passes with no commit stays valid that long;
# the ceiling is 60 s of staleness. Expiring at the registry's next such
# instant is the upgrade path.
ANSWER_TTL = 60.0
DATE_FORMAT = "%Y-%m-%dT%H:%M:%SZ"
# HTTPS binding 0.3, section 4: the error code is authoritative, the status informative.
STATUS = {
    "malformedRequest": 400,
    "unsupportedType": 422,
    "unsupportedVersion": 422,
    "expired": 422,
    "proofInvalid": 422,
    "wrongRecipient": 422,
    "unavailable": 503,
    "internalError": 500,
}
RFC3339 = re.compile(
    r"(\d{4}-\d{2}-\d{2}[Tt]\d{2}:\d{2}:\d{2})(?:\.(\d+))?([Zz]|[+-]\d{2}:\d{2})",
    re.ASCII,  # int() and strptime take any Unicode digit; the wire takes 0-9 only
)
DID_KEY = re.compile(r"did:key:z[1-9A-HJ-NP-Za-km-z]{1,2048}")
SERVED_DID = re.compile(r"did:web(?:vh)?:[!-~]+")
HOST_LABEL = re.compile(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?")
SEGMENT = re.compile(r"[a-z0-9._-]+")
DID_WEB_HOST = re.compile(r"([a-z0-9.-]{1,253})(?:%3A[0-9]{1,5})?")
DID_WEB_PATH = re.compile(r"[A-Za-z0-9._~-]+")
EXT_NAMESPACE = re.compile(r"[a-z][a-z0-9-]*(\.[a-z0-9-]+)+")
ENVELOPE_STRINGS = ("id", "threadId", "parentThreadId", "issuer", "recipient")
# An absolute URI (RFC 3986 section 4.3): a scheme, then only URI characters.
URI_RE = re.compile(r"[A-Za-z][A-Za-z0-9+.-]*:[A-Za-z0-9._~:/?#\[\]@!$&'()*+,;=%-]*")
PAYLOAD_KEYS = {"entity_id", "authority_id", "action", "resource", "context", "ext"}


class TaskError(Exception):
    """A request the bridge refuses with a trust-task-error document."""

    def __init__(self, code: str, message: str) -> None:
        """Refuse with framework error ``code`` and a short operator ``message``."""
        super().__init__(message)
        self.code = code


class Stale(TaskError):
    """The registry copy is stale or unsynced: refused with a bare 503.

    No Trust Task document, because trql-client reads any trust-task-error
    as a denial but a bare non-2xx as a transport error, so verify-trust
    reports registryUnavailable (vouch-faq3.16). If OpenVTC
    verifiable-git-infrastructure#170 lands, this can go back to a
    retryable trust-task-error.
    """

    def __init__(self, message: str) -> None:
        """Refuse with ``message`` as the reply's text."""
        super().__init__("unavailable", message)


def parse_time(text: object, what: str) -> datetime:
    """Return the RFC 3339 date-time ``text`` in UTC.

    Raises:
        TaskError: malformedRequest if ``text`` is not an RFC 3339 date-time.
    """
    match = RFC3339.fullmatch(text) if isinstance(text, str) else None
    try:
        if match is None:
            raise ValueError(text)
        base, fraction, zone = match.groups()
        when = datetime.strptime(base.upper(), "%Y-%m-%dT%H:%M:%S")
        when = when.replace(microsecond=int((fraction or "0")[:6].ljust(6, "0")))
        offset = timedelta()
        if zone not in ("Z", "z"):
            offset = timedelta(hours=int(zone[1:3]), minutes=int(zone[4:6]))
            offset = -offset if zone[0] == "-" else offset
        return when.replace(tzinfo=timezone(offset)).astimezone(timezone.utc)
    except (ValueError, OverflowError) as e:
        raise TaskError(
            "malformedRequest", f"{what} is not an RFC 3339 date-time"
        ) from e


def is_resource(resource: str) -> bool:
    """Return whether ``resource`` is a forge-qualified resource verify-trust accepts.

    A port of VGI vgi-core/src/resource.rs ``normalize_resource``: a dotted
    DNS host or localhost, then 1 to 21 segments of ``[a-z0-9._-]``, never
    ``.`` or ``..``, at most 512 bytes; ASCII case is folded first.
    """
    if len(resource) > 512 or not resource.isascii():
        return False
    host, *path = resource.lower().split("/")
    return (
        len(host) <= 253
        and ("." in host or host == "localhost")
        and all(HOST_LABEL.fullmatch(label) for label in host.split("."))
        and 1 <= len(path) <= 21
        and all(SEGMENT.fullmatch(s) and s not in (".", "..") for s in path)
    )


def check_envelope(doc: object, did: str, now: datetime) -> dict[str, object]:
    """Return the request payload after checking the Trust Task envelope around it.

    Applies the framework 0.5 envelope schema and SPEC.md section 7.2 items
    3, 4, 5, 7 and 13.

    Raises:
        TaskError: the document is refused.
    """
    if not isinstance(doc, dict):
        raise TaskError("malformedRequest", "the body is not a JSON object")
    for name in ("id", "type"):
        if not isinstance(doc.get(name), str) or not doc[name]:
            raise TaskError("malformedRequest", f"{name} must be a non-empty string")
    for name in ENVELOPE_STRINGS:
        if name in doc and (not isinstance(doc[name], str) or not doc[name]):
            raise TaskError("malformedRequest", f"{name} must be a non-empty string")
    if not isinstance(doc.get("payload"), dict):
        raise TaskError("malformedRequest", "payload must be an object")
    issued = parse_time(doc["issuedAt"], "issuedAt") if "issuedAt" in doc else None
    expires = parse_time(doc["expiresAt"], "expiresAt") if "expiresAt" in doc else None
    kind = doc["type"]
    if not URI_RE.fullmatch(kind):
        raise TaskError("malformedRequest", "type must be an absolute URI")
    if kind not in (TASK_TYPE, TASK_TYPE + "#request"):
        if kind.startswith(TASK_FAMILY):
            raise TaskError("unsupportedVersion", f"only {TASK_TYPE} is served")
        raise TaskError("unsupportedType", f"only {TASK_TYPE} is served")
    if "recipient" not in doc:
        raise TaskError("malformedRequest", "recipient is required")
    if doc["recipient"] != did:
        raise TaskError("wrongRecipient", f"this registry is {did}")
    if issued is not None and issued > now + CLOCK_SKEW:
        raise TaskError("malformedRequest", "issuedAt is in the future")
    if expires is not None and issued is not None and expires <= issued:
        raise TaskError("malformedRequest", "expiresAt is not after issuedAt")
    if expires is not None and now >= expires:
        raise TaskError("expired", "the request has expired")
    if "proof" in doc:
        # SPEC.md 4.7: a suite the consumer cannot check is proofInvalid, never
        # treated as absent. The bridge checks none; verify-trust sends none.
        raise TaskError("proofInvalid", "this registry verifies no proof")
    payload: dict[str, object] = doc["payload"]
    return payload


def check_payload(
    payload: Mapping[str, object],
) -> tuple[Optional[str], Optional[datetime]]:
    """Check ``payload`` against the registry/authorization 0.1 schema.

    Returns:
        The request's ``context.time`` as sent and parsed, or two Nones if it
        has none.

    Raises:
        TaskError: malformedRequest if the payload does not match the schema
            or its resource is not one verify-trust would send.
    """
    extra = sorted(set(payload) - PAYLOAD_KEYS)
    if extra:
        raise TaskError("malformedRequest", f"unknown payload member {extra[0]!r:.60}")
    for name in ("entity_id", "authority_id", "action", "resource"):
        if not isinstance(payload.get(name), str):
            raise TaskError("malformedRequest", f"payload.{name} must be a string")
    if "ext" in payload:
        ext = payload["ext"]
        if not isinstance(ext, dict) or not ext:
            raise TaskError(
                "malformedRequest", "payload.ext must be a non-empty object"
            )
        if not all(EXT_NAMESPACE.fullmatch(name) for name in ext):
            raise TaskError("malformedRequest", "payload.ext keys must be reverse-DNS")
    time = at = None
    if "context" in payload:
        context = payload["context"]
        if not isinstance(context, dict) or not all(
            isinstance(v, str) for v in context.values()
        ):
            raise TaskError("malformedRequest", "payload.context must map to strings")
        if context.get("time"):  # the registry schema: blank means now
            time = context["time"]
            at = parse_time(time, "payload.context.time")
    if not is_resource(str(payload["resource"])):
        raise TaskError("malformedRequest", "payload.resource is not host/path")
    return time, at


def git(args: Sequence[str], failure: str) -> subprocess.CompletedProcess[str]:
    """Run git with ``args`` while holding one of the QUERY_SLOTS.

    git runs in its own process group, which a timeout kills whole: git
    leaves ``git vouch``'s git-vouch, and its children, running when only
    git is killed. The slot is released only once the group is reaped.

    Raises:
        TaskError: unavailable if every slot is taken, or with ``failure`` if
            git cannot run or times out.
    """
    if not QUERY_SLOTS.acquire(blocking=False):
        raise TaskError("unavailable", "the registry is busy")
    try:
        with subprocess.Popen(
            ["git", *args],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            start_new_session=True,
        ) as proc:
            try:
                out, err = proc.communicate(timeout=QUERY_TIMEOUT)
            except subprocess.TimeoutExpired as e:
                os.killpg(proc.pid, signal.SIGKILL)
                proc.communicate()
                log(f"git {args[0]} timed out after {QUERY_TIMEOUT}s")
                raise TaskError("unavailable", failure) from e
        return subprocess.CompletedProcess(proc.args, proc.returncode, out, err)
    except OSError as e:
        log(f"git {args[0]} cannot run: {e}")
        raise TaskError("unavailable", failure) from e
    finally:
        QUERY_SLOTS.release()


def log(message: str) -> None:
    """Write one line about a refused query to stderr, where the server logs go."""
    print(f"git-vouch-trqp: {message}", file=sys.stderr, flush=True)


class Answers:
    """``git vouch query --all``'s map for now, run by the first request needing it."""

    def __init__(self, state: str) -> None:
        """Start the map for the clean registry ``state``; it is not ready yet."""
        self.state = state
        self.started = monotonic()
        self.ready = threading.Event()
        self.answers: Optional[dict[str, object]] = None  # None until it succeeds


ANSWERS_LOCK = threading.Lock()
latest: Optional[Answers] = None  # the newest map for now; guarded by ANSWERS_LOCK


def query(entity: str, at: Optional[datetime]) -> dict[str, object]:
    """Return ``git vouch query``'s answer for the did:key ``entity``.

    The boundary: the bridge judges nothing itself. It never reads registry
    files or imports git-vouch's checker, and anything but query's documented
    answer is unavailable, never authorized. Speed-ups go above this line, as
    the per-commit cache does, never across it (vouch-s9w2.4).

    For now (``at`` None) the answer comes from ``answers_now``, where a DID
    no person file lists gets ``handle`` null, as ``git vouch query``
    answers it with exit 1. A given time runs that one DID's query:
    ``--all --at`` reads every person's endorsement history, five times a
    whole check on a 600-person registry.

    Raises:
        TaskError: unavailable if the registry cannot be read or checked.
    """
    if at is not None:
        # Truncating to whole seconds is exact: every registry date is whole seconds.
        # The year is padded by hand: strftime's %Y leaves years before 1000 short.
        when = f"{at.year:04d}" + at.strftime("-%m-%dT%H:%M:%SZ")
        return vouch_query(entity, "--at", when)
    answer = answers_now().get(entity, {"did": entity, "handle": None})
    if not isinstance(answer, dict):
        log(f"git vouch query --all gave a non-object answer for {entity}")
        raise TaskError("unavailable", "the registry cannot be checked")
    return answer


def answers_now() -> dict[str, object]:
    """Return ``git vouch query --all``'s map for the served copy as it is now.

    A clean copy's map is reused while its commit stays and for ANSWER_TTL
    seconds; requests needing it while it runs wait for that one run. A
    dirty copy is checked each time, since its next edit may leave ``git
    status`` printing the same lines.

    Raises:
        TaskError: unavailable if the registry cannot be read or checked.
    """
    global latest
    proc = git(
        ["-C", str(registry_root()), "--no-optional-locks", "status"]
        + ["--porcelain=v2", "--branch", "--no-ahead-behind"],
        "the registry is unreadable",
    )
    if proc.returncode != 0:
        log(f"git status exited {proc.returncode}")
        raise TaskError("unavailable", "the registry is unreadable")
    lines = proc.stdout.splitlines()
    if any(not line.startswith("# ") for line in lines):
        return vouch_query("--all")
    state = next((line for line in lines if line.startswith("# branch.oid ")), "")
    with ANSWERS_LOCK:
        entry = latest
        is_runner = (
            entry is None
            or entry.state != state
            or monotonic() - entry.started > ANSWER_TTL
        )
        if entry is None or is_runner:
            entry = latest = Answers(state)
    if not is_runner:
        entry.ready.wait()  # bounded: the run holds a git() slot, so QUERY_TIMEOUT
        if entry.answers is None:
            raise TaskError("unavailable", "the registry cannot be checked")
        return entry.answers
    try:
        entry.answers = vouch_query("--all")
    finally:
        if entry.answers is None:  # a failed run is retried by the next request
            with ANSWERS_LOCK:
                if latest is entry:
                    latest = None
        entry.ready.set()
    return entry.answers


def vouch_query(*args: str) -> dict[str, object]:
    """Return what ``git vouch query args`` prints.

    Raises:
        TaskError: unavailable if the registry cannot be read or checked.
    """
    proc = git(["vouch", "query", *args], "the registry cannot be queried")
    # Exit 1 with an answer means an unknown key; with none, a failed registry check.
    if proc.returncode in (0, 1):
        try:
            answer = json.loads(proc.stdout)
        except ValueError:
            answer = None
        if isinstance(answer, dict):
            return answer
    last = proc.stderr.strip().rsplit("\n", 1)[-1]
    log(f"git vouch query exited {proc.returncode}: {last!r:.300}")
    raise TaskError("unavailable", "the registry cannot be checked")


def registry_root() -> Path:
    """Return the registry ``git vouch query`` reads: the synced copy once setup has run.

    Before setup (no ``vouch.registry`` config) it is the current directory.
    ponytail: this copies git-vouch's _registry_dir and _data_dir, so it
    drifts if they change; having ``git vouch query`` report its root's
    commit and sync time is the upgrade path (core change).

    Raises:
        TaskError: unavailable if git config cannot be read.
    """
    proc = git(["config", "--get", "vouch.registry"], "git config cannot be read")
    if proc.returncode == 1:
        return Path(".")
    if proc.returncode != 0:
        raise TaskError("unavailable", "git config cannot be read")
    xdg = os.environ.get("XDG_DATA_HOME", "")
    base = Path(xdg) if os.path.isabs(xdg) else Path.home() / ".local" / "share"
    return base / "git-vouch" / "registry"


def freshness(now: datetime) -> dict[str, Optional[str]]:
    """Return the registry copy's commit (None if it has none) and last sync time.

    The copy is the one ``git vouch query`` reads, and the time is that of
    the stamp ``git vouch sync`` touches in its git directory after each
    successful fetch. The commit is read just before the query, so a sync
    that lands between the two can make it one commit behind the answer.

    Raises:
        Stale: if the copy is not a repository, has no sync stamp, its
            last successful sync is over 24 hours old, or the stamp is
            dated ahead of ``now`` by more than the allowed clock skew.
    """
    root = registry_root()
    command = ["-C", str(root), "rev-parse", "--absolute-git-dir"]
    proc = git([*command, "--verify", "--quiet", "HEAD"], "the registry is unreadable")
    # Exit 1 prints the git directory but no commit: a repository with none.
    lines = proc.stdout.splitlines()
    if proc.returncode not in (0, 1) or not lines:
        raise Stale("the registry is not a git repository")
    try:
        mtime = (Path(lines[0]) / "vouch-fetched").stat().st_mtime
    except OSError as e:
        raise Stale("the registry copy was never synced") from e
    synced = datetime.fromtimestamp(mtime, timezone.utc)
    when = synced.strftime(DATE_FORMAT)
    if now - synced > STALE_AFTER:
        raise Stale(f"the registry copy was last synced {when}, over 24h ago")
    if synced - now > CLOCK_SKEW:
        raise Stale(f"the registry copy was synced {when}, in the future")
    return {"commit": lines[1] if len(lines) > 1 else None, "synced": when}


def decide(
    payload: Mapping[str, object], did: str, at: Optional[datetime]
) -> tuple[bool, str]:
    """Return whether the queried entity is authorized, and why (DESIGN.md, TRQP bridge)."""
    entity = str(payload["entity_id"])
    if payload["authority_id"] != did:
        return False, f"this registry answers only for {did}"
    if payload["action"] != ACTION:
        return False, f"this registry answers only {ACTION}"
    if not DID_KEY.fullmatch(entity):
        return False, "the entity is not a did:key"
    answer = query(entity, at)
    if answer.get("handle") is None:
        return False, "no registered person holds this key"
    if answer.get("valid") is not True:
        return False, "the key is retired, revoked or not yet added"
    if answer.get("automation") is not False:
        return False, "automation identities do not sign commits"
    if not answer.get("emails"):
        return False, "the person has no endorsed email"
    return True, f"a current key of registry-vouched person {answer['handle']}"


def respond(body: bytes, did: str, now: datetime) -> tuple[int, dict[str, object]]:
    """Return the HTTP status and Trust Task document answering the request ``body``.

    Raises:
        Stale: the registry copy is stale; the caller sends a bare 503.
    """
    doc: object = None
    stamp = now.strftime(DATE_FORMAT)
    try:
        try:
            doc = json.loads(body)
        except (ValueError, RecursionError) as e:
            raise TaskError("malformedRequest", "the body is not JSON") from e
        payload = check_envelope(doc, did, now)
        time, at = check_payload(payload)
        synced = freshness(now)
        authorized, message = decide(payload, did, at)
    except Stale:
        raise
    except TaskError as e:
        return STATUS[e.code], error_document(doc, did, now, e.code, str(e))
    answer: dict[str, object] = {
        name: payload[name]
        for name in ("entity_id", "authority_id", "action", "resource")
    }
    answer.update(authorized=authorized, time_evaluated=stamp, message=message)
    if time is not None:
        answer["time_requested"] = time
    answer["ext"] = {EXT: synced}
    reply = envelope(doc, did, stamp, TASK_TYPE + "#response", answer)
    return 200, reply


def envelope(
    request: object, did: str, stamp: str, kind: str, payload: dict[str, object]
) -> dict[str, object]:
    """Return a reply document to ``request`` from ``did``, as trust-tasks-rs respond_with builds."""
    doc: dict[str, object] = {"id": f"urn:uuid:{uuid.uuid4()}", "type": kind}
    if isinstance(request, dict):
        if isinstance(request.get("id"), str) and request["id"]:
            doc["threadId"] = request["id"]
        if isinstance(request.get("issuer"), str) and request["issuer"]:
            doc["recipient"] = request["issuer"]
    doc.update(issuer=did, issuedAt=stamp, payload=payload)
    return doc


def error_document(
    request: object, did: str, now: datetime, code: str, message: str
) -> dict[str, object]:
    """Return the trust-task-error/0.5 document refusing ``request``."""
    payload: dict[str, object] = {
        "code": code,
        "retryable": code == "unavailable",
        "message": message[:1024],
    }
    if (
        isinstance(request, dict)
        and isinstance(request.get("type"), str)
        and URI_RE.fullmatch(request["type"])
    ):
        in_response = {"typeUri": request["type"]}
        if isinstance(request.get("id"), str) and request["id"]:
            in_response["id"] = request["id"]
        payload["inResponseTo"] = in_response
    return envelope(request, did, now.strftime(DATE_FORMAT), ERROR_TYPE, payload)


class Handler(BaseHTTPRequestHandler):
    """Serve POST /trust-tasks; any other method or path gets a bare 404 or 405."""

    server_version = "git-vouch-trqp"
    # ponytail: seconds one socket read may wait, not a whole-request limit,
    # so a client trickling bytes holds a thread; the reverse proxy bounds
    # requests (module docstring). The upgrade path is a per-request deadline
    # plus a connection cap.
    timeout = 30
    did = ""  # the served DID, set by serve()

    def do_POST(self) -> None:
        """Answer one Trust Task document."""
        if self.path != PATH:
            self.send_error(404)
            return
        now = datetime.now(timezone.utc)
        length = self.headers.get("Content-Length", "")
        # The length test comes first: int() refuses over 4300 digits.
        if (
            not (length.isascii() and length.isdigit())
            or len(length) > len(str(MAX_BODY))
            or int(length) > MAX_BODY
        ):
            self.close_connection = True  # the body, if any, is left unread
            message = f"Content-Length must be at most {MAX_BODY}"
            self._send(
                400, error_document(None, self.did, now, "malformedRequest", message)
            )
            return
        body = self.rfile.read(int(length))
        try:
            status, doc = respond(body, self.did, now)
        except Stale as e:
            self._send_stale(str(e))
            return
        except Exception:  # the boundary: log the trace, never send it
            self.log_error("internal error:\n%s", traceback.format_exc())
            status = STATUS["internalError"]
            doc = error_document(None, self.did, now, "internalError", "internal error")
        self._send(status, doc)

    def _not_post(self) -> None:
        self.send_error(405 if self.path == PATH else 404)

    do_GET = do_HEAD = do_PUT = do_DELETE = do_PATCH = do_OPTIONS = _not_post

    def _send(self, status: int, doc: Mapping[str, object]) -> None:
        data = json.dumps(doc).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def _send_stale(self, message: str) -> None:
        data = f"{message}\n".encode()
        self.send_response(503)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Retry-After", str(RETRY_AFTER))
        self.end_headers()
        self.wfile.write(data)


def serve(did: str, bind: str, port: int) -> int:
    """Serve ``did``'s answers on ``bind``:``port`` until interrupted."""
    handler = type("BoundHandler", (Handler,), {"did": did})
    try:
        # ponytail: an IPv6 literal listens on IPv6; a name or '' on IPv4, so
        # 'localhost' stays 127.0.0.1 whatever the resolver lists first. The
        # ceiling: an IPv6-only host must be given as its literal.
        family = socket.AF_INET6 if ":" in bind else socket.AF_INET
        server_class = type(
            "Server", (ThreadingHTTPServer,), {"address_family": family}
        )
        server = server_class((bind, port), handler)
    except OSError as e:
        print(
            f"git-vouch-trqp: cannot listen on {bind}:{port}: {e.strerror or e}",
            file=sys.stderr,
        )
        return 1
    with server:
        host, real_port = server.server_address[:2]
        host = f"[{host}]" if ":" in str(host) else host
        print(
            f"git-vouch-trqp: serving {did} at http://{host}:{real_port}{PATH}",
            flush=True,
        )
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            pass
    return 0


def check_endpoint(endpoint: str) -> None:
    """Check that ``endpoint`` is a base URL verify-trust can POST trust tasks to.

    trql-client appends ``/trust-tasks`` to the base, so a query or fragment
    would swallow the path.

    Raises:
        ValueError: ``endpoint`` is not an https:// URL with a host, or has a
            query, fragment, userinfo, backslash, or a character outside
            printable ASCII.
    """
    if not (endpoint.isascii() and endpoint.isprintable()) or " " in endpoint:
        raise ValueError("it must be printable ASCII without spaces")
    try:
        url = urlsplit(endpoint)
        url.port  # noqa: B018 (raises ValueError on a bad port)
    except ValueError as e:
        raise ValueError("it is not a URL") from e
    if url.scheme != "https" or not url.hostname:
        raise ValueError("it must be an https:// URL with a host")
    if "?" in endpoint or "#" in endpoint:
        raise ValueError("it must have no query or fragment")
    # A WHATWG parser (verify-trust's url crate) ends the host at a backslash
    # where urlsplit does not, and userinfo would be published in the document.
    if "\\" in endpoint or url.username is not None:
        raise ValueError("it must have no backslash or user@")


def did_document(did: str, endpoint: str) -> dict[str, object]:
    """Return ``did``'s DID document advertising the bridge at base URL ``endpoint``.

    One ``TRQPRest`` service and nothing else: verify-trust prefers TSP and
    DIDComm over HTTPS without fallback (docs/trqp-interop.md section 2). The
    service id is absolute because the resolver parses it as a URL.
    """
    return {
        "@context": ["https://www.w3.org/ns/did/v1"],
        "id": did,
        "service": [
            {"id": f"{did}#rest", "type": "TRQPRest", "serviceEndpoint": endpoint}
        ],
    }


def is_did_web(did: str) -> bool:
    """Return whether ``did`` is a did:web, or did:webvh, the bridge can publish.

    The host is DNS labels with an optional ``%3A`` port; each path part is
    unreserved characters, so nothing in it needs percent-decoding.
    ponytail: stricter than did:web (no IDNs or encoded path characters);
    widen if a registry ever needs them.
    """
    if did.startswith("did:webvh:"):
        scid, _, rest = did[len("did:webvh:") :].partition(":")
        if not scid.isalnum():
            return False
    elif did.startswith("did:web:"):
        rest = did[len("did:web:") :]
    else:
        return False
    host, *path = rest.split(":")
    m = DID_WEB_HOST.fullmatch(host)
    return (
        m is not None
        and all(HOST_LABEL.fullmatch(label) for label in m[1].split("."))
        and all(DID_WEB_PATH.fullmatch(s) and s not in (".", "..") for s in path)
    )


def did_web_url(did: str) -> str:
    """Return the URL a did:web resolver fetches ``did``'s document from (did:web 2.5.2).

    ``did`` must pass ``is_did_web``.
    """
    host, *path = did[len("did:web:") :].split(":")
    host = host.replace("%3A", ":")
    if not path:
        return f"https://{host}/.well-known/did.json"
    return "/".join([f"https://{host}", *path, "did.json"])


def print_did_document(did: str, endpoint: str) -> int:
    """Print ``did``'s DID document on stdout and where it goes on stderr."""
    print(json.dumps(did_document(did, endpoint), indent=2))
    if did.startswith("did:web:"):
        where = f"serve it at {did_web_url(did)}"
    else:
        where = "sign it into the did:webvh log with a webvh tool"
    print(f"git-vouch-trqp: {where}", file=sys.stderr)
    return 0


def main(argv: Sequence[str]) -> int:
    """Run the command line; return the exit status."""
    parser = argparse.ArgumentParser(
        prog="git-vouch-trqp",
        description="Answer OpenVTC verify-trust's TRQP queries from git vouch query.",
    )
    commands = parser.add_subparsers(dest="command", required=True)
    run = commands.add_parser("serve", help="serve POST /trust-tasks over plain HTTP")
    run.add_argument("--did", required=True, help="the registry's did:web or did:webvh")
    run.add_argument(
        "--bind",
        default="127.0.0.1",
        help="address (default 127.0.0.1); put a buffering reverse proxy in front",
    )
    run.add_argument("--port", type=int, default=8080, help="port (default 8080)")
    doc = commands.add_parser(
        "did-document", help="print the registry's DID document with its TRQP service"
    )
    doc.add_argument("--did", required=True, help="the registry's did:web or did:webvh")
    doc.add_argument(
        "--endpoint",
        required=True,
        help="the bridge's public https:// base URL, without /trust-tasks",
    )
    args = parser.parse_args(argv)
    if args.command == "serve" and not 0 <= args.port <= 65535:
        parser.error(f"--port must be 0 to 65535: {args.port}")
    if not SERVED_DID.fullmatch(args.did):
        parser.error(f"--did must be a did:web or did:webvh: {args.did!r:.80}")
    if args.command == "did-document":
        if not is_did_web(args.did):
            parser.error(f"--did must be a did:web or did:webvh: {args.did!r:.80}")
        try:
            check_endpoint(args.endpoint)
        except ValueError as e:
            parser.error(f"--endpoint {args.endpoint!r:.80}: {e}")
        return print_did_document(args.did, args.endpoint)
    return serve(args.did, args.bind, args.port)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
